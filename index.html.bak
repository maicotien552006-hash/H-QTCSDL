  <!-- ================= MODAL: THÊM SẢN PHẨM & SKU (FR-PROD-02) ================= -->
  <div id="new-product-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div
      class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-xl shadow-2xl flex flex-col max-h-[92vh] overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b border-slate-800 bg-slate-950">
        <div class="flex items-center space-x-2 text-indigo-400 font-bold text-sm">
          <i data-lucide="package-plus" class="w-5 h-5"></i>
          <span>Thêm Mặt Hàng & Tạo SKU Mới (FR-PROD-02)</span>
        </div>
        <button onclick="closeNewProductModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="p-5 overflow-y-auto space-y-3.5 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Tên Sản Phẩm <span class="text-rose-400">*</span>:</label>
          <input type="text" id="modal-prod-name" placeholder="Ví dụ: Áo sơ mi Oxford cao cấp..."
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">Danh Mục:</label>
            <select id="modal-prod-category"
              class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Thương Hiệu:</label>
            <select id="modal-prod-brand"
              class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
          </div>
        </div>
        <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 space-y-3">
          <span class="font-bold text-slate-300 block text-[11px] uppercase text-indigo-400">Thông Tin SKU Biến Thể Đầu
            Tiên</span>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-400 mb-1">Mã SKU <span class="text-rose-400">*</span>:</label>
              <input type="text" id="modal-sku-code" placeholder="SM-OXFORD-TRANG-L"
                class="w-full px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 uppercase font-mono">
            </div>
            <div>
              <label class="block text-slate-400 mb-1">Biến Thể (Variant):</label>
              <input type="text" id="modal-sku-variant" placeholder="Trắng / L"
                class="w-full px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
            </div>
          </div>
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-slate-400">Mã Vạch Barcode (EAN-13):</label>
              <button type="button"
                onclick="document.getElementById('modal-sku-barcode').value = generateEan13Barcode()"
                class="text-[10px] text-cyan-400 hover:underline">Sinh mã ngẫu nhiên</button>
            </div>
            <input type="text" id="modal-sku-barcode" placeholder="Tự sinh nếu để trống (893...)"
              class="w-full px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-slate-400 mb-1">Giá Vốn (Cost):</label>
              <input type="number" id="modal-sku-cost" min="0" value="120000"
                class="w-full px-2 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
            </div>
            <div>
              <label class="block text-slate-400 mb-1">Giá Lẻ (Retail):</label>
              <input type="number" id="modal-sku-retail" min="0" value="250000"
                class="w-full px-2 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
            </div>
            <div>
              <label class="block text-slate-400 mb-1">Giá Sỉ (Wholesale):</label>
              <input type="number" id="modal-sku-wholesale" min="0" value="190000"
                class="w-full px-2 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-400 mb-1">Tồn kho ban đầu:</label>
              <input type="number" id="modal-sku-initial-stock" min="0" value="20"
                class="w-full px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
            </div>
            <div>
              <label class="block text-slate-400 mb-1">Định mức tối thiểu:</label>
              <input type="number" id="modal-sku-threshold" min="0" value="5"
                class="w-full px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
            </div>
          </div>
        </div>
      </div>

      <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-end space-x-2">
        <button onclick="closeNewProductModal()"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold">Hủy</button>
        <button onclick="submitNewProduct()"
