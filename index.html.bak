        { LedgerId: 3, TenantId: 1, BranchId: 1, SKUId: 6, Type: 'IN', TxnType: 'Import', Quantity: 1, BalanceAfter: 1, ReferenceType: 'PurchaseReceipt', ReferenceId: 1, CreatedAt: '2026-11-16T08:00:00Z' }
      ],

      orders: [],
      orderItems: [],
      purchaseReceipts: [],
      purchaseReceiptItems: [],
      webhookEvents: [],
      transfers: [
        {
          TransferId: 1,
          TransferNo: 'TRF-20261116-001',
          TenantId: 1,
          FromBranchId: 2,
          ToBranchId: 1,
          SKUId: 1,
          Quantity: 15,
          Status: 'Dispatched',
          Note: 'Chuyển hàng bổ sung từ Kho Thủ Đức sang Quận 1',
          DispatchedAt: '2026-11-16T09:00:00Z',
          DispatchedBy: 'Trần Quốc Bảo',
          ReceivedAt: null,
          ReceivedBy: null
        }
      ],
      orderSeq: 1,
      ledgerSeq: 4,
      transferSeq: 2
    };

    let cart = [];
    let activeChannelFilter = 'ALL';
    let revenueChartInstance = null;
    let topSkuChartInstance = null;

    /* -------------------------------------------------------------
       AUDIO & LOGGING HELPERS
       ------------------------------------------------------------- */
    function playBeep(type = 'success') {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        if (type === 'success') {
          osc.frequency.setValueAtTime(880, ctx.currentTime);
          gain.gain.setValueAtTime(0.1, ctx.currentTime);
          osc.start();
          osc.stop(ctx.currentTime + 0.1);
        } else {
          osc.frequency.setValueAtTime(300, ctx.currentTime);
          gain.gain.setValueAtTime(0.15, ctx.currentTime);
          osc.start();
          osc.stop(ctx.currentTime + 0.25);
        }
      } catch (e) { }
    }

    function logSql(title, sql, isError = false) {
      const container = document.getElementById('sql-console-log');
      const time = new Date().toLocaleTimeString();
      const div = document.createElement('div');
      div.className = `p-2.5 rounded border ${isError ? 'bg-rose-950/40 border-rose-800 text-rose-300' : 'bg-slate-950 border-slate-800 text-slate-300'}`;
      div.innerHTML = `
        <div class="flex justify-between items-center text-[10px] text-slate-500 mb-1">
          <span class="font-bold uppercase ${isError ? 'text-rose-400' : 'text-indigo-400'}">${title}</span>
          <span>${time}</span>
        </div>
        <pre class="overflow-x-auto text-[11px] font-mono leading-tight whitespace-pre-wrap">${sql}</pre>
      `;
      container.prepend(div);
    }

    function toggleSqlInspector() {
      const drawer = document.getElementById('sql-inspector-drawer');
      drawer.classList.toggle('translate-x-full');
    }

    function clearSqlConsole() {
      document.getElementById('sql-console-log').innerHTML = '';
    }

    /* -------------------------------------------------------------
       RLS & MULTI-TENANCY HELPERS
       ------------------------------------------------------------- */
    function changeTenant(tenantId) {
      DB.currentTenantId = parseInt(tenantId);
      cart = [];
      logSql(
        `EXEC sys.sp_set_session_context @key=N'TenantId', @value=${tenantId};`,
        `-- Đổi TenantId sang ${tenantId}. Row-Level Security tự động lọc mọi câu SELECT/INSERT/UPDATE.`
      );
      initApp();
      updateLowStockAlert();
    }

    function getTenantBranches() {
      return DB.branches.filter(b => b.TenantId === DB.currentTenantId);
    }

    function getTenantSkus() {
      return DB.skus.filter(s => s.TenantId === DB.currentTenantId);
    }

    function getStock(branchId, skuId) {
      const s = DB.stockLevels.find(x => x.TenantId === DB.currentTenantId && x.BranchId === branchId && x.SKUId === skuId);
      if (!s) return { OnHand: 0, Reserved: 0, Available: 0 };
      return { ...s, Available: s.OnHand - s.Reserved };
    }

    function getPrice(skuId) {
      const p = DB.listedPrices.find(x => x.TenantId === DB.currentTenantId && x.SKUId === skuId);
      return p ? p.RetailPrice : 0;
    }

    /* -------------------------------------------------------------
       SAFE ICON & LIBRARY HELPERS (OFFLINE SAFE)
       ------------------------------------------------------------- */
    function safeRenderIcons() {
      if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
        try {
          lucide.createIcons();
        } catch (e) {
          console.warn('Lỗi vẽ Lucide Icons:', e);
        }
      }
    }

    /* -------------------------------------------------------------
       AUTH & RBAC MANAGEMENT (FR-AUTH-01, FR-AUTH-02, FR-AUTH-03)
       ------------------------------------------------------------- */
    function showAuthPortal() {
      const portal = document.getElementById('auth-portal-screen');
      const main = document.getElementById('main-layout');
      if (portal) {
        portal.classList.remove('hidden');
        portal.style.display = 'flex';
      }
      if (main) {
        main.classList.add('hidden');
        main.style.display = 'none';
      }
      safeRenderIcons();
    }

    function showMainLayout() {
      const portal = document.getElementById('auth-portal-screen');
      const main = document.getElementById('main-layout');
      if (portal) {
        portal.classList.add('hidden');
        portal.style.display = 'none';
      }
      if (main) {
        main.classList.remove('hidden');
        main.style.display = 'flex';
      }
      safeRenderIcons();
    }

    function logoutUser() {
      if (confirm('Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?')) {
        try {
          sessionStorage.removeItem('oism_user');
        } catch (e) { }
        DB.currentUser = null;
        DB.jwtToken = null;
        showAuthPortal();
        logSql(
          `-- [AUTHENTICATION] NGƯỜI DÙNG ĐÃ ĐĂNG XUẤT KHỎI HỆ THỐNG`,
          `-- Đã xóa phiên sessionStorage (oism_user).\n-- Chuyển về Cổng Đăng Nhập. Bắt buộc đăng nhập để vào Trang Chủ!`
        );
      }
    }

    function switchAuthTab(tab) {
      const btnLogin = document.getElementById('btn-auth-tab-login');
      const btnReg = document.getElementById('btn-auth-tab-register');
      const panelLogin = document.getElementById('auth-panel-login');
      const panelReg = document.getElementById('auth-panel-register');

      if (tab === 'login') {
        if (btnLogin) btnLogin.className = 'py-2.5 rounded-lg bg-indigo-600 text-white shadow-sm flex items-center justify-center space-x-1.5 transition';
        if (btnReg) btnReg.className = 'py-2.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1.5 transition';
        if (panelLogin) {
          panelLogin.classList.remove('hidden');
          panelLogin.style.display = 'block';
        }
        if (panelReg) {
          panelReg.classList.add('hidden');
          panelReg.style.display = 'none';
        }
      } else {
        if (btnReg) btnReg.className = 'py-2.5 rounded-lg bg-indigo-600 text-white shadow-sm flex items-center justify-center space-x-1.5 transition';
        if (btnLogin) btnLogin.className = 'py-2.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1.5 transition';
        if (panelReg) {
          panelReg.classList.remove('hidden');
          panelReg.style.display = 'block';
        }
        if (panelLogin) {
          panelLogin.classList.add('hidden');
          panelLogin.style.display = 'none';
        }
      }
      safeRenderIcons();
    }

    // Nút Bỏ qua đăng nhập và vào thẳng Demo nhanh nhất
    function skipLoginAndEnterDemo(role = 'Owner') {
      const user = DB.users.find(u => u.Role === role) || DB.users[0];
      fallbackToDemoUser(user);
    }

    function quickLogin(email, password) {
      const elEmail = document.getElementById('login-email');
      const elPass = document.getElementById('login-password');
      if (elEmail) elEmail.value = email;
      if (elPass) elPass.value = password;
      submitLogin();
    }

    async function submitLogin() {
      const email = (document.getElementById('login-email')?.value || '').trim();
      const password = (document.getElementById('login-password')?.value || '').trim();

      if (!email || !password) {
        alert('Vui lòng nhập Email và Mật khẩu!');
        return;
      }

      // 1. Nếu Backend .NET đang chạy: Gọi API xác thực thật qua BCrypt & cấp JWT Token
      if (isLiveApi) {
        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            DB.currentUser = data.user;
            DB.jwtToken = data.token;
            DB.currentTenantId = data.user.tenantId;

            logSql(
              `-- [JWT AUTHENTICATION] ĐĂNG NHẬP THÀNH CÔNG TỪ SQL SERVER 2022`,
              `-- User: ${data.user.fullName} | Role: ${data.user.role} | TenantId: ${data.user.tenantId}\n-- JWT Token: ${data.token.substring(0, 35)}... (Hạn 8 tiếng)`
            );

            onLoginSuccess(data.user);
            return;
          } else {
            console.warn('API đăng nhập trả về lỗi:', data);
            // Nếu Backend chưa có dữ liệu tài khoản này, kiểm tra demo user để gợi ý chuyển đổi thông minh
            const demoUser = DB.users.find(u => u.Email.toLowerCase() === email.toLowerCase());
            if (demoUser) {
              const allowDemo = confirm(
                `Backend thông báo: "${data.message || 'Chưa tìm thấy tài khoản trong CSDL'}"\n(Do CSDL SQL Server chưa nạp tài khoản này).\n\nBạn có muốn tự động vào Trang Chủ dưới chế độ Demo In-Memory với tài khoản ${demoUser.FullName} (${demoUser.Role}) không?`
              );
              if (allowDemo) {
                fallbackToDemoUser(demoUser);
                return;
              }
            } else {
              playBeep('error');
              alert('Đăng nhập thất bại: ' + (data.message || 'Sai tài khoản hoặc mật khẩu!'));
              return;
            }
          }
        } catch (e) {
          console.warn('Lỗi gọi API đăng nhập, tự động chuyển sang xác thực in-memory:', e);
        }
      }

      // 2. Chế độ In-memory (Offline / Demo):
      const found = DB.users.find(u => u.Email.toLowerCase() === email.toLowerCase());
      if (!found) {
        playBeep('error');
        alert('Tài khoản không tồn tại trong danh sách mẫu!\nBạn có thể nhấn vào các tài khoản mẫu bên dưới hoặc bấm nút "VÀO THẲNG BẢN DEMO".');
        return;
      }

      fallbackToDemoUser(found);
    }

    function fallbackToDemoUser(found) {
      DB.currentUser = found;
      DB.currentTenantId = found.TenantId;
      DB.jwtToken = 'ey-demo-jwt-token-' + btoa(unescape(encodeURIComponent(JSON.stringify(found))));

      logSql(
        `-- [AUTHENTICATION DEMO] ĐĂNG NHẬP THÀNH CÔNG`,
        `-- User: ${found.FullName} | Role: ${found.Role} | TenantId: ${found.TenantId}\n-- Cấp quyền truy cập màn hình theo RBAC.`
      );

      onLoginSuccess(found);
    }

    function onLoginSuccess(user) {
      playBeep('success');

      // An toàn: chỉ gọi confetti nếu thư viện đã tải thành công
      if (typeof confetti === 'function') {
        try {
          confetti({ particleCount: 50, spread: 50, origin: { y: 0.6 } });
        } catch (e) { }
      }

      // 1. Lưu phiên làm việc vào sessionStorage
      try {
        sessionStorage.setItem('oism_user', JSON.stringify(user));
      } catch (e) { }

      DB.currentUser = user;
      DB.currentTenantId = user.tenantId || user.TenantId || 1;

      // 2. Mở khóa và hiển thị Trang Chủ
      showMainLayout();

      // 3. Cập nhật thông tin profile người dùng
      updateUserProfileDisplay();

      // 4. Đồng bộ Tenant Selector
      const tenantSelect = document.getElementById('tenant-select');
      if (tenantSelect) {
        tenantSelect.value = DB.currentTenantId;
      }

      // 5. Tải lại dữ liệu hệ thống theo TenantId
      initApp();

      // 6. Áp dụng phân quyền RBAC
      applyRbacPermissions();
    }

    async function submitRegisterTenant() {
      const storeName = (document.getElementById('reg-store-name').value || '').trim();
      const branchName = (document.getElementById('reg-branch-name').value || '').trim() || 'Chi nhánh chính';
      const branchAddress = (document.getElementById('reg-branch-address').value || '').trim() || 'Chưa cập nhật';
      const fullName = (document.getElementById('reg-owner-name').value || '').trim();
      const email = (document.getElementById('reg-email').value || '').trim();
      const phone = (document.getElementById('reg-phone').value || '').trim();
      const password = (document.getElementById('reg-password').value || '').trim();
      const confirm = (document.getElementById('reg-password-confirm').value || '').trim();

      if (!storeName || !fullName || !email || !password) {
        alert('Vui lòng điền đầy đủ các trường có dấu sao (*) !');
        return;
      }
      if (password !== confirm) {
        alert('Mật khẩu nhập lại không khớp!');
        return;
      }
      if (password.length < 6) {
        alert('Mật khẩu phải từ 6 ký tự trở lên!');
        return;
      }

      // 1. Nếu Backend .NET đang chạy: Gọi API tạo Tenant trong CSDL
      if (isLiveApi) {
        try {
          const payload = {
            storeName, branchName, branchAddress, fullName, email, phone, password
          };
          const res = await fetch(`${API_BASE}/auth/register`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            playBeep('error');
            alert('Đăng ký thất bại: ' + (data.message || 'Lỗi tạo Tenant!'));
            return;
          }

          DB.currentUser = data.user;
          DB.jwtToken = data.token;
          DB.currentTenantId = data.user.tenantId;

          // Thêm vào danh sách Tenant của dropdown
          const tenantSelect = document.getElementById('tenant-select');
          const opt = document.createElement('option');
          opt.value = data.user.tenantId;
          opt.text = `Tenant ${data.user.tenantId}: ${data.user.storeName}`;
          opt.className = 'bg-slate-900 text-slate-200';
          tenantSelect.appendChild(opt);
          tenantSelect.value = data.user.tenantId;

          logSql(
            `-- [TENANT REGISTRATION] ĐĂNG KÝ CỬA HÀNG THÀNH CÔNG VÀO SQL SERVER 2022`,
            `BEGIN TRAN;\n  INSERT INTO dbo.Tenants (Name) VALUES ('${storeName}'); -- TenantId: ${data.user.tenantId}\n  EXEC sys.sp_set_session_context @key=N'TenantId', @value=${data.user.tenantId};\n  INSERT INTO dbo.Branches ...\n  INSERT INTO dbo.Users (Role) VALUES (N'Owner');\nCOMMIT TRAN;`
          );

          alert(`Đăng ký cửa hàng '${storeName}' thành công! Bạn đã được tự động đăng nhập với vai trò Chủ cửa hàng (Owner).`);
          onLoginSuccess(data.user);
          return;
        } catch (e) {
          console.warn('Lỗi gọi API đăng ký, chuyển sang in-memory:', e);
        }
      }

      // 2. Chế độ In-memory (Offline):
      const newTenantId = DB.tenants.length + 1;
      const newBranchId = DB.branches.length + 1;
      const newUserId = DB.users.length + 1;

      DB.tenants.push({ TenantId: newTenantId, Name: storeName });
      DB.branches.push({ BranchId: newBranchId, TenantId: newTenantId, Name: branchName, Address: branchAddress });

      const newUser = {
        UserId: newUserId,
        TenantId: newTenantId,
        FullName: fullName,
        Email: email,
        Phone: phone,
        Role: 'Owner',
        StoreName: storeName
      };
      DB.users.push(newUser);

      // Thêm vào dropdown
      const tenantSelect = document.getElementById('tenant-select');
      const opt = document.createElement('option');
      opt.value = newTenantId;
      opt.text = `Tenant ${newTenantId}: ${storeName}`;
      opt.className = 'bg-slate-900 text-slate-200';
      tenantSelect.appendChild(opt);
      tenantSelect.value = newTenantId;

      logSql(
        `-- [TENANT REGISTRATION IN-MEMORY] TẠO THÀNH CÔNG TENANT MỚI`,
        `-- Đã tạo TenantId=${newTenantId} (${storeName})\n-- Chi nhánh: ${branchName} (ID: ${newBranchId})\n-- Tài khoản: ${fullName} (Owner - ID: ${newUserId})`
      );

      alert(`Đăng ký cửa hàng '${storeName}' thành công! Bạn đã được tự động đăng nhập với vai trò Chủ cửa hàng (Owner).`);
      onLoginSuccess(newUser);
    }

    function updateUserProfileDisplay() {
      const user = DB.currentUser;
      if (!user) return;

      const name = user.FullName || user.fullName || 'Người dùng';
      const role = user.Role || user.role || 'Staff';
      const store = user.StoreName || user.storeName || (DB.tenants.find(t => t.TenantId === DB.currentTenantId)?.Name) || 'Cửa hàng';

      // Initials an toàn
      const parts = name.trim().split(' ').filter(Boolean);
      let initials = 'U';
      if (parts.length > 1) {
        initials = ((parts[0][0] || '') + (parts[parts.length - 1][0] || '')).toUpperCase();
      } else if (parts.length === 1 && parts[0].length > 0) {
        initials = parts[0].substring(0, 2).toUpperCase();
      }

      const elInitials = document.getElementById('user-avatar-initials');
      if (elInitials) elInitials.innerText = initials;
      const elName = document.getElementById('user-full-name');
      if (elName) elName.innerText = name;
      const elStore = document.getElementById('user-store-name');
      if (elStore) elStore.innerText = store;

      const badge = document.getElementById('user-role-badge');
      if (badge) {
        if (role === 'Owner') {
          badge.className = 'text-[9px] px-1.5 py-0.2 rounded font-bold uppercase bg-purple-500/20 text-purple-300 border border-purple-500/30';
          badge.innerText = 'Owner';
        } else if (role === 'Staff') {
          badge.className = 'text-[9px] px-1.5 py-0.2 rounded font-bold uppercase bg-blue-500/20 text-blue-300 border border-blue-500/30';
          badge.innerText = 'Staff';
        } else {
          badge.className = 'text-[9px] px-1.5 py-0.2 rounded font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          badge.innerText = 'Cashier';
        }
      }
    }

    function applyRbacPermissions() {
      const role = (DB.currentUser?.Role || DB.currentUser?.role || 'Owner');

      const tabs = {
        pos: document.getElementById('tab-btn-pos'),
        orders: document.getElementById('tab-btn-orders'),
        inventory: document.getElementById('tab-btn-inventory'),
        purchase: document.getElementById('tab-btn-purchase'),
        products: document.getElementById('tab-btn-products'),
        branches: document.getElementById('tab-btn-branches'),
        webhook: document.getElementById('tab-btn-webhook'),
        reports: document.getElementById('tab-btn-reports')
      };

      // Reset tất cả tab về mặc định
      Object.values(tabs).forEach(t => {
        if (t) {
          t.style.opacity = '1';
          t.title = '';
        }
      });

      if (role === 'Cashier') {
        // Cashier chỉ được phép truy cập POS
        ['orders', 'inventory', 'purchase', 'products', 'branches', 'webhook', 'reports'].forEach(k => {
          if (tabs[k]) {
            tabs[k].style.opacity = '0.35';
            tabs[k].title = 'Quyền hạn: Thu ngân (Cashier) chỉ được phép sử dụng POS bán hàng.';
          }
        });
        // Tự động chuyển về POS nếu đang ở tab bị khóa
        switchTab('pos');
      } else if (role === 'Staff') {
        // Staff không được xem Báo cáo doanh thu tài chính (chỉ Owner)
        if (tabs.reports) {
          tabs.reports.style.opacity = '0.35';
          tabs.reports.title = 'Quyền hạn: Báo cáo Doanh thu & Lợi nhuận gộp chỉ dành riêng cho Chủ cửa hàng (Owner).';
        }
      }
    }

    /* -------------------------------------------------------------
       TAB SWITCHING (ENFORCING RBAC - FR-AUTH-03)
       ------------------------------------------------------------- */
    function switchTab(tabId) {
      const role = (DB.currentUser?.Role || DB.currentUser?.role || 'Owner');

      // Kiểm tra quyền RBAC trước khi cho chuyển tab
      if (role === 'Cashier' && tabId !== 'pos') {
        playBeep('error');
        alert('Truy cập bị từ chối: Tài khoản Thu ngân (Cashier) chỉ có quyền sử dụng màn hình POS Bán hàng (FR-AUTH-03)!');
        return;
      }
      if (role === 'Staff' && tabId === 'reports') {
        playBeep('error');
        alert('Truy cập bị từ chối: Màn hình Báo cáo Doanh thu & Lợi nhuận gộp chỉ dành cho Chủ sở hữu (Owner)!');
        return;
      }

      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-tab').forEach(el => {
        el.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
        el.classList.add('text-slate-400');
      });

      const target = document.getElementById(`tab-${tabId}`);
      if (target) target.classList.remove('hidden');

      const btn = document.getElementById(`tab-btn-${tabId}`);
      if (btn) {
        btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
        btn.classList.remove('text-slate-400');
      }

      if (tabId === 'pos') renderPosProducts();
      if (tabId === 'orders') renderOrdersTable();
      if (tabId === 'inventory') renderInventoryTab();
      if (tabId === 'purchase') renderPurchaseTab();
      if (tabId === 'webhook') renderWebhookTab();
      if (tabId === 'reports') renderReports();
      if (tabId === 'products') { renderMasterProductsTable(); renderCategoriesAndBrands(); }
      if (tabId === 'branches') { renderBranchesTable(); setTimeout(initBranchInlineMap, 150); }
      if (tabId === 'map') renderMapTab();
      safeRenderIcons();
    }

    function switchInventorySubtab(sub) {
      const btnStock = document.getElementById('btn-subtab-stock');
      const btnLedger = document.getElementById('btn-subtab-ledger');
      const btnTransfer = document.getElementById('btn-subtab-transfer');
      const contentStock = document.getElementById('subtab-content-stock');
      const contentLedger = document.getElementById('subtab-content-ledger');
      const contentTransfer = document.getElementById('subtab-content-transfer');

      const activeClass = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white';
      const inactiveClass = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-slate-200';

      if (btnStock) btnStock.className = inactiveClass;
      if (btnLedger) btnLedger.className = inactiveClass;
      if (btnTransfer) btnTransfer.className = inactiveClass;

      if (contentStock) contentStock.classList.add('hidden');
      if (contentLedger) contentLedger.classList.add('hidden');
      if (contentTransfer) contentTransfer.classList.add('hidden');

      if (sub === 'stock') {
        if (btnStock) btnStock.className = activeClass;
        if (contentStock) contentStock.classList.remove('hidden');
      } else if (sub === 'ledger') {
        if (btnLedger) btnLedger.className = activeClass;
        if (contentLedger) contentLedger.classList.remove('hidden');
      } else if (sub === 'transfer') {
        if (btnTransfer) btnTransfer.className = activeClass;
        if (contentTransfer) contentTransfer.classList.remove('hidden');
        renderTransfersSubtab();
      }
      safeRenderIcons();
    }

    /* -------------------------------------------------------------
       MODULE 1: POS FAST CHECKOUT (PWA)
       ------------------------------------------------------------- */
    function populateBranchSelectors() {
      const branches = getTenantBranches();
      const posSelect = document.getElementById('pos-branch-select');
      const prSelect = document.getElementById('pr-branch');
      const stSelect = document.getElementById('stocktake-branch-select');
      const trfFrom = document.getElementById('transfer-from-branch');
      const trfTo = document.getElementById('transfer-to-branch');

      const options = branches.map(b => `<option value="${b.BranchId}">${b.Name}</option>`).join('');
      if (posSelect) posSelect.innerHTML = options;
      if (prSelect) prSelect.innerHTML = options;
      if (stSelect) stSelect.innerHTML = options;
      if (trfFrom) trfFrom.innerHTML = options;
      if (trfTo) {
        trfTo.innerHTML = options;
        if (branches.length > 1) trfTo.selectedIndex = 1;
      }
    }

    function renderPosProducts() {
      const grid = document.getElementById('pos-products-grid');
      if (!grid) return;
      const branches = getTenantBranches();
      const posSelect = document.getElementById('pos-branch-select');
      const branchId = parseInt(posSelect?.value) || (branches.length > 0 ? branches[0].BranchId : 1);
      const skus = getTenantSkus();
      const search = (document.getElementById('pos-search-input')?.value || '').trim().toLowerCase();

      const filtered = skus.filter(s => {
        const prod = DB.products.find(p => p.ProductId === s.ProductId);
        const name = prod ? prod.Name.toLowerCase() : '';
        const code = s.SkuCode.toLowerCase();
        const barcode = (s.Barcode || '').toLowerCase();
        return name.includes(search) || code.includes(search) || barcode.includes(search);
      });

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-500 text-xs">Không tìm thấy sản phẩm nào.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(s => {
        const prod = DB.products.find(p => p.ProductId === s.ProductId);
        const stock = getStock(branchId, s.SKUId);
        const price = getPrice(s.SKUId);
        const isOutOfStock = stock.Available <= 0;

        return `
          <div onclick="${isOutOfStock ? '' : `addToCart(${s.SKUId})`}" 
               class="p-3 bg-slate-900 border ${isOutOfStock ? 'border-rose-900/40 opacity-60 cursor-not-allowed' : 'border-slate-800 hover:border-indigo-500 cursor-pointer hover:shadow-indigo-500/10'} rounded-xl transition flex flex-col justify-between group">
            <div>
              <div class="flex justify-between items-start mb-1">
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 group-hover:text-indigo-300 transition">${s.SkuCode}</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${stock.Available > 5 ? 'bg-emerald-500/20 text-emerald-400' : stock.Available > 0 ? 'bg-amber-500/20 text-amber-400' : 'bg-rose-500/20 text-rose-400'}">
                  ${stock.Available > 0 ? `Còn ${stock.Available}` : 'Hết hàng'}
                </span>
              </div>
              <h4 class="font-bold text-xs text-slate-200 line-clamp-1">${prod ? prod.Name : ''}</h4>
              <p class="text-[11px] text-slate-400">${s.VariantName || ''}</p>
            </div>
            <div class="mt-2 pt-2 border-t border-slate-800/80 flex justify-between items-center">
              <span class="font-mono font-extrabold text-sm text-indigo-400">${price.toLocaleString('vi-VN')} đ</span>
              <button class="w-6 h-6 rounded bg-slate-800 group-hover:bg-indigo-600 text-slate-300 group-hover:text-white flex items-center justify-center transition">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
      safeRenderIcons();
    }

    function filterPosProducts() {
      const search = (document.getElementById('pos-search-input').value || '').trim().toLowerCase();
      // If exact barcode match, auto-add
      const skus = getTenantSkus();
      const exact = skus.find(s => s.Barcode && s.Barcode.toLowerCase() === search);
      if (exact) {
        addToCart(exact.SKUId);
        document.getElementById('pos-search-input').value = '';
        renderPosProducts();
        return;
      }
      renderPosProducts();
    }

    function addToCart(skuId) {
      const branchId = parseInt(document.getElementById('pos-branch-select').value);
      const stock = getStock(branchId, skuId);
      const itemInCart = cart.find(x => x.skuId === skuId);
      const curQty = itemInCart ? itemInCart.qty : 0;

      if (curQty + 1 > stock.Available) {
        playBeep('error');
        alert(`Không thể thêm! Tồn khả dụng hiện tại chỉ còn ${stock.Available}.`);
        return;
      }

      playBeep('success');
      if (itemInCart) {
        itemInCart.qty += 1;
      } else {
        cart.push({ skuId, qty: 1 });
      }
      renderCart();
    }

    function updateCartQty(skuId, delta) {
      const branchId = parseInt(document.getElementById('pos-branch-select').value);
      const stock = getStock(branchId, skuId);
      const item = cart.find(x => x.skuId === skuId);
      if (!item) return;

      if (item.qty + delta > stock.Available) {
        playBeep('error');
        alert(`Vượt quá tồn khả dụng (${stock.Available})!`);
        return;
      }

      item.qty += delta;
      if (item.qty <= 0) {
        cart = cart.filter(x => x.skuId !== skuId);
      }
      renderCart();
    }

    function clearCart() {
      cart = [];
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('pos-cart-items');
      if (cart.length === 0) {
        container.innerHTML = `
          <div class="h-48 flex flex-col items-center justify-center text-slate-500 text-xs space-y-2">
            <i data-lucide="shopping-cart" class="w-8 h-8 opacity-40"></i>
            <span>Giỏ hàng đang trống</span>
          </div>
        `;
        document.getElementById('pos-cart-total-qty').innerText = '0';
        document.getElementById('pos-cart-total-amount').innerText = '0 đ';
        safeRenderIcons();
        return;
      }

      let totalQty = 0;
      let totalAmount = 0;

      container.innerHTML = cart.map(item => {
        const sku = DB.skus.find(s => s.SKUId === item.skuId);
        const prod = DB.products.find(p => p.ProductId === sku.ProductId);
        const price = getPrice(item.skuId);
        const lineTotal = price * item.qty;
        totalQty += item.qty;
        totalAmount += lineTotal;

        return `
          <div class="p-2.5 bg-slate-950/80 border border-slate-800 rounded-lg flex items-center justify-between">
            <div class="flex-1 pr-2">
              <h5 class="font-bold text-xs text-slate-200 line-clamp-1">${prod ? prod.Name : ''}</h5>
              <div class="text-[10px] text-slate-400 font-mono">${sku.SkuCode} • ${price.toLocaleString('vi-VN')} đ</div>
            </div>
            <div class="flex items-center space-x-1.5">
              <button onclick="updateCartQty(${item.skuId}, -1)" class="w-5 h-5 rounded bg-slate-800 text-slate-300 hover:bg-slate-700 flex items-center justify-center">-</button>
              <span class="w-6 text-center font-mono font-bold text-xs text-slate-100">${item.qty}</span>
              <button onclick="updateCartQty(${item.skuId}, 1)" class="w-5 h-5 rounded bg-slate-800 text-slate-300 hover:bg-slate-700 flex items-center justify-center">+</button>
            </div>
            <div class="w-20 text-right font-mono font-bold text-xs text-indigo-400">
              ${lineTotal.toLocaleString('vi-VN')} đ
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('pos-cart-total-qty').innerText = totalQty;
      document.getElementById('pos-cart-total-amount').innerText = totalAmount.toLocaleString('vi-VN') + ' đ';
      safeRenderIcons();
    }

    // Single-transaction Checkout: executes usp_FastCheckout
    async function executePosCheckout(paymentMethod) {
      if (cart.length === 0) {
        alert('Giỏ hàng trống!');
        return;
      }

      const branchId = parseInt(document.getElementById('pos-branch-select').value);
      const branch = DB.branches.find(b => b.BranchId === branchId);

      // Nếu đã kết nối trực tiếp với Backend .NET và SQL Server 2022
      if (isLiveApi) {
        try {
          const payload = {
            tenantId: DB.currentTenantId,
            branchId: branchId,
            paymentMethod: paymentMethod,
            cashierId: 1,
            items: cart.map(i => ({ skuId: i.skuId, quantity: i.qty }))
          };

          const res = await fetch(`${API_BASE}/pos/fast-checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            playBeep('error');
            logSql(
              `EXEC dbo.usp_FastCheckout @BranchId=${branchId}, @PaymentMethod=N'${paymentMethod}', @Items=...;`,
              `-- LỖI CSDL ${data.errorCode || ''}: ${data.message}`,
              true
            );
            alert(`Lỗi CSDL từ SQL Server: ${data.message}`);
            return;
          }

          logSql(
            `EXEC dbo.usp_FastCheckout @BranchId=${branchId}, @PaymentMethod=N'${paymentMethod}', @Items=...;`,
            `-- [SQL SERVER 2022 THẬT] Giao dịch thành công trong 1 Atomic Transaction!\n-- OrderId: ${data.orderId} | Xem ngay trên SSMS: SELECT * FROM dbo.Orders WHERE OrderId = ${data.orderId};`
          );

          confetti({ particleCount: 70, spread: 60, origin: { y: 0.7 } });
          playBeep('success');

          // Cập nhật lại giỏ hàng và dữ liệu hiển thị
          cart = [];
          renderCart();
          renderPosProducts();
          alert(`Thanh toán thành công qua SQL Server 2022! Mã đơn: #${data.orderId}`);
          return;
        } catch (err) {
          console.warn('Lỗi gọi API backend thật, chuyển sang chế độ mô phỏng:', err);
        }
      }

      // Fallback: Chế độ mô phỏng in-memory nếu không bật backend
      for (let item of cart) {
        const stock = getStock(branchId, item.skuId);
        if (item.qty > stock.Available) {
          playBeep('error');
          logSql(
            `EXEC dbo.usp_FastCheckout @BranchId=${branchId}, @PaymentMethod=N'${paymentMethod}', @Items=...;`,
            `-- LỖI 50010: Không đủ tồn khả dụng cho SKUId=${item.skuId}. Transaction Rollback!`,
            true
          );
          alert(`Không đủ tồn khả dụng cho mã SKU ${item.skuId}! Đơn hàng bị từ chối.`);
          return;
        }
      }

      // Generate Order in DB
      const orderSeq = DB.orderSeq++;
      const orderNo = `POS-2611-${String(orderSeq).padStart(6, '0')}`;
      const orderId = DB.orders.length + 1;
      let totalAmount = 0;
      let totalCost = 0;

      const itemsSnapshot = cart.map(item => {
        const sku = DB.skus.find(s => s.SKUId === item.skuId);
        const price = getPrice(item.skuId);
        const cost = sku.CostPrice;
        const lineTotal = price * item.qty;
        totalAmount += lineTotal;
        totalCost += (cost * item.qty);

        // Deduct from stock
        const st = DB.stockLevels.find(s => s.BranchId === branchId && s.SKUId === item.skuId);
        st.OnHand -= item.qty;

        // Write append-only ledger
        const ledgerId = DB.ledgerSeq++;
        DB.inventoryLedger.unshift({
          LedgerId: ledgerId,
          TenantId: DB.currentTenantId,
          BranchId: branchId,
          SKUId: item.skuId,
          Type: 'OUT',
          TxnType: 'Sale',
          Quantity: item.qty,
          BalanceAfter: st.OnHand,
          ReferenceType: 'Order',
          ReferenceId: orderId,
          CreatedAt: new Date().toISOString()
        });

        return {
          OrderId: orderId,
          SKUId: item.skuId,
          Quantity: item.qty,
          UnitPrice: price,
          CostPrice: cost,
          LineTotal: lineTotal
        };
      });

      const newOrder = {
        OrderId: orderId,
        TenantId: DB.currentTenantId,
        BranchId: branchId,
        OrderNo: orderNo,
        Channel: 'POS',
        Status: 'Completed',
        PaymentMethod: paymentMethod,
        TotalAmount: totalAmount,
        TotalCost: totalCost,
        CreatedAt: new Date().toISOString(),
        ConfirmedAt: new Date().toISOString(),
        CompletedAt: new Date().toISOString(),
        items: itemsSnapshot
      };

      DB.orders.unshift(newOrder);

      // Log the exact Stored Procedure call
      logSql(
        `EXEC dbo.usp_FastCheckout @BranchId=${branchId}, @PaymentMethod=N'${paymentMethod}', @Items=...;`,
        `-- Giao dịch hoàn tất thành công trong 1 Atomic Transaction!
BEGIN TRAN;
  EXEC dbo.usp_ReserveOrder @BranchId=${branchId}, @Channel=N'POS', @Items=@Cart, @OrderId=@OrderId OUTPUT;
  EXEC dbo.usp_ConfirmOrder @OrderId=@OrderId;
  UPDATE dbo.Orders SET [Status]=N'Completed', PaymentMethod=N'${paymentMethod}' WHERE OrderId=@OrderId;
COMMIT TRAN;
-- OrderNo: ${orderNo} | Doanh thu: ${totalAmount.toLocaleString('vi-VN')} đ | Lợi nhuận: ${(totalAmount - totalCost).toLocaleString('vi-VN')} đ`
      );

      // Confetti animation
      confetti({ particleCount: 70, spread: 60, origin: { y: 0.7 } });
      playBeep('success');

      // Show Receipt
      showReceiptModal(newOrder, branch);

      // Reset cart and refresh views
      cart = [];
      renderCart();
      renderPosProducts();
      updateLowStockAlert();
    }

    /* -------------------------------------------------------------
       RECEIPT MODAL
       ------------------------------------------------------------- */
    function showReceiptModal(order, branch) {
      const tenant = DB.tenants.find(t => t.TenantId === DB.currentTenantId);
      document.getElementById('receipt-tenant-name').innerText = tenant.Name;
      document.getElementById('receipt-branch-name').innerText = branch ? branch.Name : '';
      document.getElementById('receipt-date').innerText = new Date(order.CreatedAt).toLocaleString('vi-VN');
      document.getElementById('receipt-order-no').innerText = order.OrderNo;
      document.getElementById('receipt-payment-method').innerText = order.PaymentMethod === 'Cash' ? 'Tiền mặt' : 'Chuyển khoản QR';

      const itemsHtml = order.items.map(i => {
        const sku = DB.skus.find(s => s.SKUId === i.SKUId);
        const prod = DB.products.find(p => p.ProductId === sku.ProductId);
        return `
          <div class="flex justify-between">
            <span class="truncate pr-1">${prod ? prod.Name : ''} (x${i.Quantity})</span>
            <span class="font-mono">${i.LineTotal.toLocaleString('vi-VN')} đ</span>
          </div>
        `;
      }).join('');

      document.getElementById('receipt-items-list').innerHTML = itemsHtml;
      document.getElementById('receipt-total-amount').innerText = order.TotalAmount.toLocaleString('vi-VN') + ' đ';
      document.getElementById('receipt-modal').classList.remove('hidden');
    }

    function closeReceiptModal() {
      document.getElementById('receipt-modal').classList.add('hidden');
    }

    /* -------------------------------------------------------------
       MODULE 2: OMNICHANNEL ORDERS HUB (STATE MACHINE)
       ------------------------------------------------------------- */
    function filterOrdersByChannel(channel) {
      activeChannelFilter = channel;
      document.querySelectorAll('.order-filter-btn').forEach(btn => {
        btn.className = 'order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800 text-slate-400 hover:text-slate-200';
      });
      event.target.className = 'order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-indigo-600 text-white';
      renderOrdersTable();
    }

    function renderOrdersTable() {
      const tbody = document.getElementById('orders-table-body');
      const statusFilter = document.getElementById('order-status-filter').value;
      const orders = DB.orders.filter(o => o.TenantId === DB.currentTenantId);

      document.getElementById('order-count-badge').innerText = orders.length;

      const filtered = orders.filter(o => {
        const matchChannel = (activeChannelFilter === 'ALL' || o.Channel === activeChannelFilter);
        const matchStatus = (statusFilter === 'ALL' || o.Status === statusFilter);
        return matchChannel && matchStatus;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-slate-500">Không có đơn hàng nào phù hợp.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(o => {
        const grossProfit = o.TotalAmount - o.TotalCost;
        let statusBadge = '';
        if (o.Status === 'Completed') statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Completed</span>';
        else if (o.Status === 'Confirmed') statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">Confirmed</span>';
        else if (o.Status === 'Reserved') statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30 animate-pulse">Reserved</span>';
        else if (o.Status === 'Cancelled') statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-500/20 text-rose-400 border border-rose-500/30">Cancelled</span>';
        else statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-slate-500/20 text-slate-400">Draft</span>';

        // Action buttons based on State Machine & Print Slip (FR-ORD-03)
        let actions = `
          <button onclick="openShippingSlipModal(${o.OrderId})" title="In Phiếu Giao Hàng & Đóng Gói (FR-ORD-03)" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded text-[10px] font-bold inline-flex items-center space-x-1 border border-slate-700">
            <i data-lucide="printer" class="w-3 h-3"></i>
            <span>Vận Đơn</span>
          </button>
        `;
        if (o.Status === 'Reserved') {
          actions = `
            <div class="flex items-center justify-center space-x-1">
              <button onclick="confirmReservedOrder(${o.OrderId})" class="px-2 py-1 bg-cyan-600 hover:bg-cyan-500 text-white rounded text-[10px] font-bold">Duyệt Kho</button>
              <button onclick="cancelOrder(${o.OrderId})" class="px-2 py-1 bg-rose-600/30 hover:bg-rose-600 text-rose-300 hover:text-white rounded text-[10px] font-bold">Hủy</button>
              <button onclick="openShippingSlipModal(${o.OrderId})" title="In Phiếu Giao Hàng & Đóng Gói (FR-ORD-03)" class="p-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700">
                <i data-lucide="printer" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          `;
        } else if (o.Status === 'Confirmed') {
          actions = `
            <div class="flex items-center justify-center space-x-1">
              <button onclick="completeOrder(${o.OrderId})" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-[10px] font-bold">Hoàn Tất</button>
              <button onclick="openShippingSlipModal(${o.OrderId})" title="In Phiếu Giao Hàng & Đóng Gói (FR-ORD-03)" class="p-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700">
                <i data-lucide="printer" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          `;
        }

        const itemsSummary = (o.items || []).map(i => {
          const sku = DB.skus.find(s => s.SKUId === i.SKUId);
          return `${sku ? sku.SkuCode : ''} (x${i.Quantity})`;
        }).join(', ');

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-3 font-bold text-slate-200">${o.OrderNo}</td>
            <td class="p-3"><span class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-bold">${o.Channel}</span></td>
            <td class="p-3 text-slate-400">${o.ExternalOrderId || '-'}</td>
            <td class="p-3 text-slate-300 text-[11px] max-w-xs truncate" title="${itemsSummary}">${itemsSummary}</td>
            <td class="p-3 text-right font-bold text-slate-100">${o.TotalAmount.toLocaleString('vi-VN')} đ</td>
            <td class="p-3 text-right text-slate-400">${o.TotalCost.toLocaleString('vi-VN')} đ</td>
            <td class="p-3 text-right font-bold text-indigo-400">${grossProfit.toLocaleString('vi-VN')} đ</td>
            <td class="p-3 text-center">${statusBadge}</td>
            <td class="p-3 text-center">${actions}</td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    function confirmReservedOrder(orderId) {
      const order = DB.orders.find(o => o.OrderId === orderId);
      if (!order || order.Status !== 'Reserved') return;

      // Deduct stock, reduce reserved, write ledger, snapshot cost
      let totalCost = 0;
      order.items.forEach(i => {
        const sku = DB.skus.find(s => s.SKUId === i.SKUId);
        const st = DB.stockLevels.find(s => s.BranchId === order.BranchId && s.SKUId === i.SKUId);
        st.OnHand -= i.Quantity;
        st.Reserved -= i.Quantity;

        i.CostPrice = sku.CostPrice;
        totalCost += (i.CostPrice * i.Quantity);

        DB.inventoryLedger.unshift({
          LedgerId: DB.ledgerSeq++,
          TenantId: DB.currentTenantId,
          BranchId: order.BranchId,
          SKUId: i.SKUId,
          Type: 'OUT',
          TxnType: 'Sale',
          Quantity: i.Quantity,
          BalanceAfter: st.OnHand,
          ReferenceType: 'Order',
          ReferenceId: order.OrderId,
          CreatedAt: new Date().toISOString()
        });
      });

      order.Status = 'Confirmed';
      order.ConfirmedAt = new Date().toISOString();
      order.TotalCost = totalCost;

      logSql(
        `EXEC dbo.usp_ConfirmOrder @OrderId=${orderId};`,
        `-- Đơn ${order.OrderNo} chuyển sang Confirmed. OnHand & Reserved trừ theo đúng số lượng. Snapshot CostPrice vào OrderItems.`
      );

      playBeep('success');
      renderOrdersTable();
      updateLowStockAlert();
    }

    function cancelOrder(orderId, isSilent = false) {
      const order = DB.orders.find(o => o.OrderId === orderId);
      if (!order) return;

      if (order.Status === 'Reserved') {
        order.items.forEach(i => {
          const st = DB.stockLevels.find(s => s.BranchId === order.BranchId && s.SKUId === i.SKUId);
          if (st) st.Reserved -= i.Quantity;
        });
      }

      order.Status = 'Cancelled';
      order.CancelledAt = new Date().toISOString();
      order.CancelReason = isSilent ? 'Hủy tự động bởi Hangfire Background Job (quá hạn giữ chỗ)' : 'Hủy thủ công bởi quản trị viên';

      logSql(
        `EXEC dbo.usp_CancelOrder @OrderId=${orderId};`,
        `-- Hủy đơn ${order.OrderNo}. Trả lại số lượng Reserved về quỹ tồn khả dụng (Available).`
      );

      if (!isSilent) playBeep('error');
      renderOrdersTable();
    }

    function completeOrder(orderId) {
      const order = DB.orders.find(o => o.OrderId === orderId);
      if (!order) return;
      order.Status = 'Completed';
      order.CompletedAt = new Date().toISOString();

      logSql(`EXEC dbo.usp_CompleteOrder @OrderId=${orderId};`, `-- Đơn ${order.OrderNo} đã hoàn tất giao hàng.`);
      playBeep('success');
      showRealtimeNotification('Giao Hàng Thành Công', `Đơn hàng ${order.OrderNo} đã được hoàn tất thành công!`, 'success');
      renderOrdersTable();
    }

    function runExpireJobManually(isSilent = false) {
      // Simulate Hangfire Job with UPDLOCK, READPAST (FR-SIM-03)
      const reservedOrders = DB.orders.filter(o => o.TenantId === DB.currentTenantId && o.Status === 'Reserved');
      if (reservedOrders.length === 0) {
        if (!isSilent) alert('Không có đơn hàng nào ở trạng thái Reserved cần hủy!');
        return;
      }

      reservedOrders.forEach(o => {
        cancelOrder(o.OrderId, true);
      });

      logSql(
        `EXEC dbo.usp_ExpireReservedOrders;`,
        `-- Job nền Hangfire (UPDLOCK, READPAST) đã tự động quét và giải phóng ${reservedOrders.length} đơn hết hạn giữ hàng!`
      );
      if (!isSilent) {
        alert(`Đã hủy và giải phóng tồn cho ${reservedOrders.length} đơn Reserved!`);
      } else {
        showRealtimeNotification(
          'Hangfire Auto-Scheduler (FR-SIM-03)',
          `Đã tự động giải phóng tồn kho cho ${reservedOrders.length} đơn Reserved quá hạn giữ chỗ!`,
          'warning'
        );
      }
      renderOrdersTable();
    }

    /* -------------------------------------------------------------
       MODULE 3: INVENTORY & SỔ CÁI (APPEND-ONLY)
       ------------------------------------------------------------- */
    function renderInventoryTab() {
      renderStockLevelsTable();
      renderLedgerTable();
    }

    function renderStockLevelsTable() {
      const tbody = document.getElementById('stock-levels-table-body');
      const skus = getTenantSkus();
      const branches = getTenantBranches();

      let rows = [];
      branches.forEach(b => {
        skus.forEach(s => {
          const prod = DB.products.find(p => p.ProductId === s.ProductId);
          const st = getStock(b.BranchId, s.SKUId);
          const isLow = st.Available <= s.ReorderThreshold;

          rows.push(`
            <tr class="hover:bg-slate-800/40 transition">
              <td class="p-3 text-slate-300">${b.Name}</td>
              <td class="p-3 font-bold text-slate-200">${s.SkuCode}</td>
              <td class="p-3 text-slate-300">${prod ? prod.Name : ''} (${s.VariantName || ''})</td>
              <td class="p-3 text-slate-400 font-mono">${s.Barcode || '-'}</td>
              <td class="p-3 text-right font-bold text-slate-100">${st.OnHand}</td>
              <td class="p-3 text-right text-amber-400">${st.Reserved}</td>
              <td class="p-3 text-right font-bold ${st.Available > 0 ? 'text-emerald-400' : 'text-rose-400'}">${st.Available}</td>
              <td class="p-3 text-right text-cyan-300 font-bold">${s.CostPrice.toLocaleString('vi-VN')} đ</td>
              <td class="p-3 text-center">
                ${isLow ? '<span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-500/20 text-rose-400 border border-rose-500/30">Cảnh báo tồn thấp</span>' : '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400">An toàn</span>'}
              </td>
            </tr>
          `);
        });
      });

      tbody.innerHTML = rows.join('');
    }

    function renderLedgerTable() {
      const tbody = document.getElementById('ledger-table-body');
      const ledgers = DB.inventoryLedger.filter(l => l.TenantId === DB.currentTenantId);

      document.getElementById('ledger-count').innerText = ledgers.length;

      tbody.innerHTML = ledgers.map(l => {
        const sku = DB.skus.find(s => s.SKUId === l.SKUId);
        const branch = DB.branches.find(b => b.BranchId === l.BranchId);
        const typeBadge = l.Type === 'IN'
          ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold badge-in">IN (+)</span>'
          : '<span class="px-2 py-0.5 rounded text-[10px] font-bold badge-out">OUT (-)</span>';

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-3 text-slate-400 font-bold">#${l.LedgerId}</td>
            <td class="p-3 text-slate-400">${new Date(l.CreatedAt).toLocaleString('vi-VN')}</td>
            <td class="p-3 font-bold text-slate-200">${sku ? sku.SkuCode : ''}</td>
            <td class="p-3 text-slate-300">${branch ? branch.Name : ''}</td>
            <td class="p-3 text-center">${typeBadge}</td>
            <td class="p-3"><span class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-bold">${l.TxnType}</span></td>
            <td class="p-3 text-right font-bold text-slate-100">${l.Quantity}</td>
            <td class="p-3 text-right font-bold text-indigo-400">${l.BalanceAfter}</td>
            <td class="p-3 text-slate-400">${l.ReferenceType || '-'} ${l.ReferenceId ? `#${l.ReferenceId}` : ''}</td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    /* -------------------------------------------------------------
       STOCKTAKE (KIỂM KÊ KHO)
       ------------------------------------------------------------- */
    function openStocktakeModal() {
      const skuSelect = document.getElementById('stocktake-sku-select');
      const skus = getTenantSkus();
      skuSelect.innerHTML = skus.map(s => `<option value="${s.SKUId}">${s.SkuCode} - ${s.VariantName || ''}</option>`).join('');
      updateStocktakeCurrentDisplay();
      document.getElementById('stocktake-modal').classList.remove('hidden');
    }

    function closeStocktakeModal() {
      document.getElementById('stocktake-modal').classList.add('hidden');
    }

    function updateStocktakeCurrentDisplay() {
      const branchId = parseInt(document.getElementById('stocktake-branch-select').value);
      const skuId = parseInt(document.getElementById('stocktake-sku-select').value);
      const st = getStock(branchId, skuId);
      document.getElementById('stocktake-current-onhand').innerText = st.OnHand;
      document.getElementById('stocktake-current-reserved').innerText = st.Reserved;
      document.getElementById('stocktake-counted-qty').value = st.OnHand;
    }

    function submitStocktake() {
      const branchId = parseInt(document.getElementById('stocktake-branch-select').value);
      const skuId = parseInt(document.getElementById('stocktake-sku-select').value);
      const counted = parseInt(document.getElementById('stocktake-counted-qty').value);
      const st = DB.stockLevels.find(s => s.BranchId === branchId && s.SKUId === skuId);

      if (!st) {
        alert('SKU chưa có tồn tại chi nhánh này!');
        return;
      }
      if (counted < st.Reserved) {
        alert('Lỗi: Số kiểm đếm không được nhỏ hơn số lượng đang giữ chỗ (Reserved)!');
        return;
      }

      const delta = counted - st.OnHand;
      st.OnHand = counted;

      if (delta !== 0) {
        DB.inventoryLedger.unshift({
          LedgerId: DB.ledgerSeq++,
          TenantId: DB.currentTenantId,
          BranchId: branchId,
          SKUId: skuId,
          Type: delta > 0 ? 'IN' : 'OUT',
          TxnType: 'Stocktake',
          Quantity: Math.abs(delta),
          BalanceAfter: counted,
          ReferenceType: 'Stocktake',
          ReferenceId: null,
          CreatedAt: new Date().toISOString()
        });
      }

      logSql(
        `EXEC dbo.usp_StocktakeAdjust @BranchId=${branchId}, @SKUId=${skuId}, @CountedQty=${counted};`,
        `-- Kiểm kê cân kho: Chênh lệch ${delta > 0 ? '+' : ''}${delta}. Ghi bút toán điều chỉnh vào Sổ cái, không sửa đè dữ liệu cũ.`
      );

      closeStocktakeModal();
      renderInventoryTab();
      updateLowStockAlert();
      playBeep('success');
    }

    /* -------------------------------------------------------------
       MODULE 4: PURCHASE RECEIPTS & WAC (GIÁ VỐN BÌNH QUÂN)
       ------------------------------------------------------------- */
    function renderPurchaseTab() {
      const skus = getTenantSkus();
      const prSku = document.getElementById('pr-sku');
      prSku.innerHTML = skus.map(s => `<option value="${s.SKUId}">${s.SkuCode} - ${s.VariantName || ''}</option>`).join('');
      updatePrPreview();
      renderPurchaseReceiptsTable();
    }

    function updatePrPreview() {
      const skuId = parseInt(document.getElementById('pr-sku').value);
      const sku = DB.skus.find(s => s.SKUId === skuId);
      if (!sku) return;

      const qty = parseInt(document.getElementById('pr-qty').value) || 0;
      const price = parseFloat(document.getElementById('pr-price').value) || 0;

      // Calculate total current stock across entire tenant
      const totalOldStock = DB.stockLevels
        .filter(s => s.TenantId === DB.currentTenantId && s.SKUId === skuId)
        .reduce((sum, s) => sum + s.OnHand, 0);

      const oldCost = sku.CostPrice;
      const newCost = (totalOldStock + qty > 0)
        ? Math.round(((totalOldStock * oldCost) + (qty * price)) / (totalOldStock + qty))
        : price;

      document.getElementById('wac-old-stock').innerText = totalOldStock;
      document.getElementById('wac-old-cost').innerText = oldCost.toLocaleString('vi-VN') + ' đ';
      document.getElementById('wac-imp-stock').innerText = qty;
      document.getElementById('wac-imp-cost').innerText = price.toLocaleString('vi-VN') + ' đ';
      document.getElementById('wac-new-cost').innerText = newCost.toLocaleString('vi-VN') + ' đ';
    }

    function submitPurchaseReceipt() {
      const branchId = parseInt(document.getElementById('pr-branch').value);
      const skuId = parseInt(document.getElementById('pr-sku').value);
      const qty = parseInt(document.getElementById('pr-qty').value);
      const price = parseFloat(document.getElementById('pr-price').value);
      const supplier = document.getElementById('pr-supplier').value;

      if (qty <= 0 || price < 0) {
        alert('Số lượng phải > 0 và giá nhập phải >= 0!');
        return;
      }

      const sku = DB.skus.find(s => s.SKUId === skuId);
      const totalOldStock = DB.stockLevels
        .filter(s => s.TenantId === DB.currentTenantId && s.SKUId === skuId)
        .reduce((sum, s) => sum + s.OnHand, 0);

      // Trigger recalculates WAC BEFORE OnHand increases
      const oldCost = sku.CostPrice;
      const newCost = Math.round(((totalOldStock * oldCost) + (qty * price)) / (totalOldStock + qty));
      sku.CostPrice = newCost;

      // Increase OnHand
      let st = DB.stockLevels.find(s => s.BranchId === branchId && s.SKUId === skuId);
      if (!st) {
        st = { TenantId: DB.currentTenantId, BranchId: branchId, SKUId: skuId, OnHand: 0, Reserved: 0 };
        DB.stockLevels.push(st);
      }
      st.OnHand += qty;

      // Append-only Ledger
      const rId = DB.purchaseReceipts.length + 1;
      DB.inventoryLedger.unshift({
        LedgerId: DB.ledgerSeq++,
        TenantId: DB.currentTenantId,
        BranchId: branchId,
        SKUId: skuId,
        Type: 'IN',
        TxnType: 'Import',
        Quantity: qty,
        BalanceAfter: st.OnHand,
        ReferenceType: 'PurchaseReceipt',
        ReferenceId: rId,
        CreatedAt: new Date().toISOString()
      });

      DB.purchaseReceipts.unshift({
        ReceiptId: rId,
        TenantId: DB.currentTenantId,
        BranchId: branchId,
        SupplierName: supplier,
        TotalAmount: qty * price,
        CreatedAt: new Date().toISOString(),
        items: [{ SKUId: skuId, Quantity: qty, ImportPrice: price }]
      });

      logSql(
        `EXEC dbo.usp_ConfirmPurchaseReceipt @BranchId=${branchId}, @SupplierName=N'${supplier}', @Items=@R;`,
        `-- (1) Trigger trg_PurchaseReceiptItems_WeightedAvgCost kích hoạt:
--     NewCost = (${totalOldStock} * ${oldCost} + ${qty} * ${price}) / (${totalOldStock} + ${qty}) = ${newCost} đ
-- (2) OnHand tăng thêm ${qty} cái. Ghi Sổ cái InventoryLedger.`
      );

      playBeep('success');
      alert(`Nhập kho thành công! Giá vốn mới của ${sku.SkuCode} đã được tự động tính: ${newCost.toLocaleString('vi-VN')} đ`);
      updatePrPreview();
      renderPurchaseReceiptsTable();
      updateLowStockAlert();
    }

    function renderPurchaseReceiptsTable() {
      const tbody = document.getElementById('receipts-table-body');
      const receipts = DB.purchaseReceipts.filter(r => r.TenantId === DB.currentTenantId);

      if (receipts.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-slate-500">Chưa có phiếu nhập nào.</td></tr>`;
        return;
      }

      tbody.innerHTML = receipts.map(r => {
        const branch = DB.branches.find(b => b.BranchId === r.BranchId);
        const items = r.items.map(i => {
          const sku = DB.skus.find(s => s.SKUId === i.SKUId);
          return `${sku ? sku.SkuCode : ''} (${i.Quantity} cái @ ${i.ImportPrice.toLocaleString('vi-VN')} đ)`;
        }).join(', ');

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-3 font-bold text-slate-200">#PR-${String(r.ReceiptId).padStart(4, '0')}</td>
            <td class="p-3 text-slate-400">${new Date(r.CreatedAt).toLocaleString('vi-VN')}</td>
            <td class="p-3 text-slate-300">${r.SupplierName}</td>
            <td class="p-3 text-slate-300">${branch ? branch.Name : ''}</td>
            <td class="p-3 text-slate-200 text-[11px]">${items}</td>
            <td class="p-3 text-right font-bold text-indigo-400">${r.TotalAmount.toLocaleString('vi-VN')} đ</td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    /* -------------------------------------------------------------
       MODULE 5: WEBHOOK & FLASH SALE CONCURRENCY TEST
       ------------------------------------------------------------- */
    let currentWebhookChannel = 'Shopee';

    function setWebhookChannel(channel) {
      currentWebhookChannel = channel;
      ['Shopee', 'TikTok', 'Lazada'].forEach(c => {
        const btn = document.getElementById(`btn-wh-${c.toLowerCase()}`);
        if (c === channel) {
          btn.className = 'py-1.5 rounded border border-indigo-500 bg-indigo-600/30 text-indigo-300 font-bold';
        } else {
          btn.className = 'py-1.5 rounded border border-slate-700 bg-slate-800 text-slate-400 font-bold';
        }
      });
      generateRandomWebhookPayload();
    }

    function generateRandomWebhookPayload() {
      const code = currentWebhookChannel.toUpperCase().slice(0, 2);
      const sn = `${code}${Math.floor(100000 + Math.random() * 900000)}`;
      const payload = {
        order_sn: sn,
        buyer: 'Nguyễn Văn Test',
        items: [
          { sku: 'AO-THUN-DEN-L', qty: 2 },
          { sku: 'GIAY-SNK-TRANG-42', qty: 1 }
        ]
      };
      document.getElementById('webhook-payload-text').value = JSON.stringify(payload, null, 2);
    }

    function renderWebhookTab() {
      generateRandomWebhookPayload();
      renderWebhookEventsTable();
    }

    function sendSingleWebhook() {
      const rawText = document.getElementById('webhook-payload-text').value;
      let payload = null;
      try {
        payload = JSON.parse(rawText);
      } catch (e) {
        alert('Payload không phải JSON hợp lệ!');
        return;
      }

      const branches = getTenantBranches();
      const branchId = branches.length > 0 ? branches[0].BranchId : 1;
      const eventId = DB.webhookEvents.length + 1;
      const extSn = payload.order_sn;

      // Check idempotent
      const duplicate = DB.webhookEvents.find(w => w.TenantId === DB.currentTenantId && w.Channel === currentWebhookChannel && w.ExternalOrderId === extSn);
      if (duplicate) {
        alert(`Vi phạm ràng buộc Unique UX_Webhook_External: Mã đơn ${extSn} đã từng nhận trước đó!`);
        logSql(
          `EXEC dbo.usp_IngestWebhook @BranchId=${branchId}, @Channel=N'${currentWebhookChannel}', @Payload=...;`,
          `-- LỖI 2601: Cannot insert duplicate key in object 'dbo.WebhookEvents' with unique index 'UX_Webhook_External'.`,
          true
        );
        return;
      }

      // Check stock & reserve
      let canReserve = true;
      let errorReason = '';
      const orderItems = [];

      for (let it of payload.items) {
        const sku = DB.skus.find(s => s.TenantId === DB.currentTenantId && s.SkuCode === it.sku);
        if (!sku) {
          canReserve = false;
          errorReason = `SKU ${it.sku} không tồn tại`;
          break;
        }
        const st = getStock(branchId, sku.SKUId);
        if (st.Available < it.qty) {
          canReserve = false;
          errorReason = `Không đủ tồn khả dụng cho ${it.sku} (còn ${st.Available}, cần ${it.qty})`;
          break;
        }
        orderItems.push({ skuId: sku.SKUId, qty: it.qty, price: getPrice(sku.SKUId) });
      }

      if (!canReserve) {
        DB.webhookEvents.unshift({
          EventId: eventId,
          TenantId: DB.currentTenantId,
          Channel: currentWebhookChannel,
          ExternalOrderId: extSn,
          Status: 'Rejected',
          OrderId: null,
          ErrorMessage: errorReason,
          ReceivedAt: new Date().toISOString()
        });

        logSql(
          `EXEC dbo.usp_IngestWebhook @BranchId=${branchId}, @Channel=N'${currentWebhookChannel}', @Payload=...;`,
          `-- WebhookEvent #${eventId} [Rejected]: ${errorReason}`,
          true
        );
        playBeep('error');
        alert(`Đơn hàng bị từ chối: ${errorReason}`);
      } else {
        // Create Reserved Order
        const orderId = DB.orders.length + 1;
        const orderNo = `${currentWebhookChannel.toUpperCase().slice(0, 3)}-${String(DB.orderSeq++).padStart(6, '0')}`;
        let totalAmount = 0;

        orderItems.forEach(it => {
          const st = DB.stockLevels.find(s => s.BranchId === branchId && s.SKUId === it.skuId);
          st.Reserved += it.qty; // Lock reserved
          totalAmount += (it.price * it.qty);
        });

        const newOrder = {
          OrderId: orderId,
          TenantId: DB.currentTenantId,
          BranchId: branchId,
          OrderNo: orderNo,
          Channel: currentWebhookChannel,
          Status: 'Reserved',
          ExternalOrderId: extSn,
          TotalAmount: totalAmount,
          TotalCost: 0,
          CreatedAt: new Date().toISOString(),
          ReservedAt: new Date().toISOString(),
          items: orderItems.map(it => ({
            OrderId: orderId,
            SKUId: it.skuId,
            Quantity: it.qty,
            UnitPrice: it.price,
            CostPrice: 0,
            LineTotal: it.price * it.qty
          }))
        };
        DB.orders.unshift(newOrder);

        DB.webhookEvents.unshift({
          EventId: eventId,
          TenantId: DB.currentTenantId,
          Channel: currentWebhookChannel,
          ExternalOrderId: extSn,
          Status: 'Reserved',
          OrderId: orderId,
          ErrorMessage: null,
          ReceivedAt: new Date().toISOString()
        });

        logSql(
          `EXEC dbo.usp_IngestWebhook @BranchId=${branchId}, @Channel=N'${currentWebhookChannel}', @Payload=...;`,
          `-- Bóc tách JSON qua OPENJSON -> Tạo đơn Reserved #${orderNo} -> Giữ hàng Reserved thành công!`
        );
        playBeep('success');
      }

      renderWebhookEventsTable();
      updateLowStockAlert();
    }

    function renderWebhookEventsTable() {
      const tbody = document.getElementById('webhook-events-table-body');
      const events = DB.webhookEvents.filter(w => w.TenantId === DB.currentTenantId);

      if (events.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-slate-500">Chưa có sự kiện webhook nào.</td></tr>`;
        return;
      }

      tbody.innerHTML = events.map(e => `
        <tr class="hover:bg-slate-800/40 transition">
          <td class="p-3 font-bold text-slate-200">#WH-${e.EventId}</td>
          <td class="p-3 text-slate-400">${new Date(e.ReceivedAt).toLocaleTimeString()}</td>
          <td class="p-3"><span class="px-1.5 py-0.5 rounded bg-slate-800 font-bold text-slate-300">${e.Channel}</span></td>
          <td class="p-3 font-mono text-indigo-300">${e.ExternalOrderId}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${e.Status === 'Reserved' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'}">
              ${e.Status}
            </span>
          </td>
          <td class="p-3 font-bold text-slate-300">${e.OrderId ? `#${e.OrderId}` : '-'}</td>
          <td class="p-3 text-rose-400 text-[11px]">${e.ErrorMessage || 'OK'}</td>
        </tr>
      `).join('');
    }

    /* -------------------------------------------------------------
       FLASH SALE CONCURRENCY TEST (50 THREADS VS 1 SKU)
       ------------------------------------------------------------- */
    function runFlashSaleConcurrencyTest() {
      const branches = getTenantBranches();
      const branchId = branches.length > 0 ? branches[0].BranchId : 1;
      const skuFlash = DB.skus.find(s => s.TenantId === DB.currentTenantId && s.SkuCode === 'FLASH-001');

      if (!skuFlash) {
        alert('Tenant hiện tại không có SKU FLASH-001!');
        return;
      }

      const st = DB.stockLevels.find(s => s.BranchId === branchId && s.SKUId === skuFlash.SKUId);
      st.OnHand = 1;
      st.Reserved = 0; // Reset to exactly 1 item

      const resultsBox = document.getElementById('flash-sale-results-box');
      const container = document.getElementById('flash-sale-badges-container');
      resultsBox.classList.remove('hidden');

      let successCount = 0;
      let rejectCount = 0;
      let badgesHtml = '';

      // Simulate 50 concurrent requests competing
      for (let i = 1; i <= 50; i++) {
        // Atomic lock check: only 1 request grabs the stock
        if (st.OnHand - st.Reserved >= 1) {
          st.Reserved += 1; // Locked!
          successCount++;
          badgesHtml += `<div class="p-1.5 rounded bg-emerald-500/30 text-emerald-300 text-[10px] font-bold text-center border border-emerald-500/50">#${i}: OK</div>`;
        } else {
          rejectCount++;
          badgesHtml += `<div class="p-1.5 rounded bg-rose-950/60 text-rose-400 text-[10px] font-bold text-center border border-rose-900/40">#${i}: FAIL</div>`;
        }
      }

      container.innerHTML = badgesHtml;
      document.getElementById('flash-sale-summary-text').innerHTML = `
        <span class="text-emerald-400">${successCount} thành công</span> • 
        <span class="text-rose-400">${rejectCount} bị từ chối</span> • 
        Tồn sau cùng OnHand=${st.OnHand}, Reserved=${st.Reserved}, Available=${st.OnHand - st.Reserved}
      `;

      logSql(
        `-- KỊCH BẢN FLASH SALE 50 REQUESTS CONCURRENT TRÊN SKU FLASH-001`,
        `-- Áp dụng khóa dòng: SELECT ... WITH (UPDLOCK, ROWLOCK)
-- Kết quả: Đúng 1 request thành công lấy lock & giữ hàng. 49 request nhận lỗi 50010 (Hết tồn).
-- Tồn khả dụng không bao giờ bị âm (Available >= 0)!`
      );

      playBeep('success');
      confetti({ particleCount: 50, spread: 50, origin: { y: 0.6 } });
      updateLowStockAlert();
    }

    /* -------------------------------------------------------------
       MODULE 6: REPORTS & COLUMNSTORE ANALYTICS
       ------------------------------------------------------------- */
    function renderReports() {
      const orders = DB.orders.filter(o => o.TenantId === DB.currentTenantId && (o.Status === 'Confirmed' || o.Status === 'Completed'));

      let netRevenue = 0;
      let totalCogs = 0;
      const channelData = { POS: 0, Shopee: 0, TikTok: 0, Lazada: 0 };
      const skuSales = {};

      orders.forEach(o => {
        netRevenue += o.TotalAmount;
        totalCogs += o.TotalCost;
        if (channelData[o.Channel] !== undefined) {
          channelData[o.Channel] += o.TotalAmount;
        }

        (o.items || []).forEach(it => {
          skuSales[it.SKUId] = (skuSales[it.SKUId] || 0) + it.Quantity;
        });
      });

      const grossProfit = netRevenue - totalCogs;
      const lowStockCount = getTenantSkus().filter(s => {
        const totalAvail = DB.stockLevels
          .filter(st => st.TenantId === DB.currentTenantId && st.SKUId === s.SKUId)
          .reduce((sum, st) => sum + (st.OnHand - st.Reserved), 0);
        return totalAvail <= s.ReorderThreshold;
      }).length;

      document.getElementById('kpi-net-revenue').innerText = netRevenue.toLocaleString('vi-VN') + ' đ';
      document.getElementById('kpi-total-cogs').innerText = totalCogs.toLocaleString('vi-VN') + ' đ';
      document.getElementById('kpi-gross-profit').innerText = grossProfit.toLocaleString('vi-VN') + ' đ';
      document.getElementById('kpi-low-stock-count').innerText = `${lowStockCount} SKU`;

      renderChannelChart(channelData);
      renderTopSkuChart(skuSales);
      renderPriceHistoryTable();
      renderSlowMovingReport();
    }

    function renderChannelChart(data) {
      const canvas = document.getElementById('channelRevenueChart');
      if (!canvas || typeof Chart === 'undefined') return;
      const ctx = canvas.getContext('2d');
      if (revenueChartInstance) revenueChartInstance.destroy();

      revenueChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['POS', 'Shopee', 'TikTok', 'Lazada'],
          datasets: [{
            label: 'Doanh thu (VNĐ)',
            data: [data.POS, data.Shopee, data.TikTok, data.Lazada],
            backgroundColor: ['#C5A059', '#D5B26E', '#8C7037', '#E5D3AD'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { ticks: { color: '#544E40' }, grid: { color: '#D6D0C0' } },
            x: { ticks: { color: '#544E40' }, grid: { display: false } }
          }
        }
      });
    }

    function renderTopSkuChart(skuSales) {
      const canvas = document.getElementById('topSkuChart');
      if (!canvas || typeof Chart === 'undefined') return;
      const ctx = canvas.getContext('2d');
      if (topSkuChartInstance) topSkuChartInstance.destroy();

      const sorted = Object.entries(skuSales).sort((a, b) => b[1] - a[1]).slice(0, 5);
      const labels = sorted.map(([skuId]) => {
        const sku = DB.skus.find(s => s.SKUId === parseInt(skuId));
        return sku ? sku.SkuCode : `SKU #${skuId}`;
      });
      const values = sorted.map(([, qty]) => qty);

      topSkuChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels.length ? labels : ['Chưa có dữ liệu'],
          datasets: [{
            data: values.length ? values : [1],
            backgroundColor: ['#C5A059', '#10b981', '#f59e0b', '#06b6d4', '#8b5cf6'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom', labels: { color: '#1A1A1A', font: { size: 10 } } } }
        }
      });
    }

    function renderPriceHistoryTable() {
      const tbody = document.getElementById('price-history-table-body');
      const prices = DB.listedPrices.filter(p => p.TenantId === DB.currentTenantId);

      tbody.innerHTML = prices.map(p => {
        const sku = DB.skus.find(s => s.SKUId === p.SKUId);
        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-2.5 font-bold text-slate-200">${sku ? sku.SkuCode : ''}</td>
            <td class="p-2.5 text-emerald-400 font-bold">${p.RetailPrice.toLocaleString('vi-VN')} đ</td>
            <td class="p-2.5 text-slate-400">${p.WholesalePrice.toLocaleString('vi-VN')} đ</td>
            <td class="p-2.5 text-slate-400">${new Date(p.SysStart).toLocaleString('vi-VN')}</td>
            <td class="p-2.5 text-slate-500">${p.SysEnd.startsWith('9999') ? 'Hiện tại' : new Date(p.SysEnd).toLocaleString('vi-VN')}</td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    /* -------------------------------------------------------------
       LOW STOCK ALERTS (VIEW vw_StockAlerts)
       ------------------------------------------------------------- */
    function updateLowStockAlert() {
      const skus = getTenantSkus();
      let hasLow = false;
      const lowItems = [];

      skus.forEach(s => {
        const totalAvail = DB.stockLevels
          .filter(st => st.TenantId === DB.currentTenantId && st.SKUId === s.SKUId)
          .reduce((sum, st) => sum + (st.OnHand - st.Reserved), 0);

        if (totalAvail <= s.ReorderThreshold) {
          hasLow = true;
          lowItems.push({ sku: s, available: totalAvail });
        }
      });

      const dot = document.getElementById('low-stock-dot');
      const dotSolid = document.getElementById('low-stock-dot-solid');
      if (hasLow) {
        dot.classList.remove('hidden');
        dotSolid.classList.remove('hidden');
      } else {
        dot.classList.add('hidden');
        dotSolid.classList.add('hidden');
      }

      // Populate modal
      const tbody = document.getElementById('low-stock-modal-body');
      tbody.innerHTML = lowItems.map(item => `
        <tr class="border-b border-slate-800">
          <td class="p-2 font-bold text-slate-200">${item.sku.SkuCode}</td>
          <td class="p-2 text-right font-bold text-rose-400">${item.available}</td>
          <td class="p-2 text-right text-slate-400">${item.sku.ReorderThreshold}</td>
          <td class="p-2 text-center text-[10px] text-rose-400 font-bold">Cần đặt hàng ngay</td>
        </tr>
      `).join('');
    }

    function showLowStockModal() {
      document.getElementById('low-stock-modal').classList.remove('hidden');
    }

    function closeLowStockModal() {
      document.getElementById('low-stock-modal').classList.add('hidden');
    }

    /* -------------------------------------------------------------
       HOTKEYS LISTENER (F2: Search, F4: Cash, F8: QR)
       ------------------------------------------------------------- */
    window.addEventListener('keydown', e => {
      if (e.key === 'F2') {
        e.preventDefault();
        switchTab('pos');
        document.getElementById('pos-search-input').focus();
      } else if (e.key === 'F4') {
        e.preventDefault();
        executePosCheckout('Cash');
      } else if (e.key === 'F8') {
        e.preventDefault();
        executePosCheckout('QR');
      } else if (e.key === 'Escape') {
        closeReceiptModal();
        closeLowStockModal();
        closeStocktakeModal();
        closeShippingSlipModal();
        closeNewProductModal();
        closePriceModal();
        closeBarcodeStickerModal();
      }
    });

    /* -------------------------------------------------------------
       BARCODE SVG GENERATOR & EAN-13 UTILITIES (FR-PROD-03)
       ------------------------------------------------------------- */
    function generateEan13Barcode() {
      // Vietnam GS1 prefix: 893
      let digits = '893';
      for (let i = 0; i < 9; i++) {
        digits += Math.floor(Math.random() * 10).toString();
      }
      let sum = 0;
      for (let i = 0; i < 12; i++) {
        const d = parseInt(digits[i], 10);
        sum += (i % 2 === 0) ? d : (d * 3);
      }
      const checkDigit = (10 - (sum % 10)) % 10;
      return digits + checkDigit.toString();
    }

    function generateBarcodeSvg(code, width = 240, height = 45, isDark = false) {
      if (!code) code = '8934000000000';
      const cleanCode = code.toString().trim();
      const barColor = isDark ? '#ffffff' : '#0f172a';

      // Deterministic bar widths pattern based on ASCII codes
      let pattern = '101'; // Left guard
      for (let i = 0; i < cleanCode.length; i++) {
        const c = cleanCode.charCodeAt(i);
        const b1 = (c % 2 === 0) ? '1101' : '1011';
        const b2 = (c % 3 === 0) ? '0100' : '0010';
        pattern += b1 + b2;
      }
      pattern += '101'; // Right guard

      const barWidth = (width / pattern.length);
      let svgBars = '';
      for (let i = 0; i < pattern.length; i++) {
        if (pattern[i] === '1') {
          const x = (i * barWidth).toFixed(1);
          const w = (barWidth * 0.95).toFixed(1);
          svgBars += `<rect x="${x}" y="0" width="${w}" height="${height}" fill="${barColor}" />`;
        }
      }

      return `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" class="w-full h-auto max-h-[50px] mx-auto select-none">
          ${svgBars}
        </svg>
      `;
    }

    /* -------------------------------------------------------------
       REAL-TIME TOAST NOTIFICATIONS (FR-SIM-02)
       ------------------------------------------------------------- */
    function showRealtimeNotification(title, message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      let borderStyle = 'border-cyan-500/40 bg-slate-900/95 text-slate-100';
      let iconColor = 'text-cyan-400';
      let iconName = 'bell';

      if (type === 'success') {
        borderStyle = 'border-emerald-500/50 bg-slate-900/95 text-slate-100';
        iconColor = 'text-emerald-400';
        iconName = 'check-circle-2';
      } else if (type === 'warning') {
        borderStyle = 'border-amber-500/50 bg-slate-900/95 text-slate-100';
        iconColor = 'text-amber-400';
        iconName = 'alert-triangle';
      } else if (type === 'danger') {
        borderStyle = 'border-rose-500/50 bg-slate-900/95 text-slate-100';
        iconColor = 'text-rose-400';
        iconName = 'alert-octagon';
      }

      toast.className = `p-3 rounded-xl border ${borderStyle} shadow-2xl backdrop-blur-md flex items-start space-x-3 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300`;
      toast.innerHTML = `
        <div class="mt-0.5 ${iconColor}">
          <i data-lucide="${iconName}" class="w-4 h-4"></i>
        </div>
        <div class="flex-1 space-y-0.5 text-xs">
          <div class="font-bold flex justify-between items-center">
            <span>${title}</span>
            <span class="text-[9px] text-slate-400 font-mono">${new Date().toLocaleTimeString('vi-VN')}</span>
          </div>
          <p class="text-slate-300 text-[11px] leading-relaxed">${message}</p>
        </div>
        <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white p-0.5">
          <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
      `;

      container.appendChild(toast);
      safeRenderIcons();

      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        if (toast.parentElement) {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }
      }, 4500);
    }

    /* -------------------------------------------------------------
       MODULE 5: PRODUCT & SKU MASTER DATA (FR-PROD-01..04)
       ------------------------------------------------------------- */
    function renderCategoriesAndBrands() {
      const catList = document.getElementById('categories-chip-list');
      const brandList = document.getElementById('brands-chip-list');
      const cats = (DB.categories || []).filter(c => c.TenantId === DB.currentTenantId);
      const brands = (DB.brands || []).filter(b => b.TenantId === DB.currentTenantId);

      if (catList) {
        catList.innerHTML = cats.map(c => `
          <span class="inline-flex items-center px-2 py-1 rounded bg-slate-800 text-slate-200 border border-slate-700 text-[11px]">
            <i data-lucide="folder" class="w-3 h-3 text-emerald-400 mr-1"></i>
            <span>${c.Name}</span>
          </span>
        `).join('') || '<span class="text-slate-500 text-xs italic">Chưa có danh mục</span>';
      }

      if (brandList) {
        brandList.innerHTML = brands.map(b => `
          <span class="inline-flex items-center px-2 py-1 rounded bg-slate-800 text-slate-200 border border-slate-700 text-[11px]">
            <i data-lucide="tag" class="w-3 h-3 text-indigo-400 mr-1"></i>
            <span>${b.Name}</span>
          </span>
        `).join('') || '<span class="text-slate-500 text-xs italic">Chưa có thương hiệu</span>';
      }
      safeRenderIcons();
    }

    function submitNewCategory() {
      const input = document.getElementById('new-category-name');
      const name = (input?.value || '').trim();
      if (!name) {
        alert('Vui lòng nhập tên danh mục!');
        return;
      }
      if (!DB.categories) DB.categories = [];
      const newId = DB.categories.length + 1;
      DB.categories.push({ CategoryId: newId, TenantId: DB.currentTenantId, Name: name });
      input.value = '';
      logSql(`INSERT INTO dbo.Categories (TenantId, Name) VALUES (${DB.currentTenantId}, N'${name}');`, `-- Tạo mới danh mục hàng hóa thành công.`);
      showRealtimeNotification('Danh Mục Mới', `Đã thêm danh mục: "${name}"`, 'success');
      renderCategoriesAndBrands();
    }

    function submitNewBrand() {
      const input = document.getElementById('new-brand-name');
      const name = (input?.value || '').trim();
      if (!name) {
        alert('Vui lòng nhập tên thương hiệu!');
        return;
      }
      if (!DB.brands) DB.brands = [];
      const newId = DB.brands.length + 1;
      DB.brands.push({ BrandId: newId, TenantId: DB.currentTenantId, Name: name });
      input.value = '';
      logSql(`INSERT INTO dbo.Brands (TenantId, Name) VALUES (${DB.currentTenantId}, N'${name}');`, `-- Tạo mới thương hiệu thành công.`);
      showRealtimeNotification('Thương Hiệu Mới', `Đã thêm thương hiệu: "${name}"`, 'success');
      renderCategoriesAndBrands();
    }

    function openNewProductModal() {
      const catSelect = document.getElementById('modal-prod-category');
      const brandSelect = document.getElementById('modal-prod-brand');
      const cats = (DB.categories || []).filter(c => c.TenantId === DB.currentTenantId);
      const brands = (DB.brands || []).filter(b => b.TenantId === DB.currentTenantId);

      if (catSelect) catSelect.innerHTML = cats.map(c => `<option value="${c.CategoryId}">${c.Name}</option>`).join('');
      if (brandSelect) brandSelect.innerHTML = brands.map(b => `<option value="${b.BrandId}">${b.Name}</option>`).join('');

      document.getElementById('modal-sku-barcode').value = generateEan13Barcode();
      const modal = document.getElementById('new-product-modal');
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      safeRenderIcons();
    }

    function closeNewProductModal() {
      const modal = document.getElementById('new-product-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    function submitNewProduct() {
      const name = (document.getElementById('modal-prod-name')?.value || '').trim();
      const categoryId = parseInt(document.getElementById('modal-prod-category')?.value) || 1;
      const brandId = parseInt(document.getElementById('modal-prod-brand')?.value) || 1;
      const skuCode = (document.getElementById('modal-sku-code')?.value || '').trim().toUpperCase();
      const variantName = (document.getElementById('modal-sku-variant')?.value || '').trim() || 'Mặc định';
      let barcode = (document.getElementById('modal-sku-barcode')?.value || '').trim();
      const costPrice = parseFloat(document.getElementById('modal-sku-cost')?.value) || 0;
      const retailPrice = parseFloat(document.getElementById('modal-sku-retail')?.value) || 0;
      const wholesalePrice = parseFloat(document.getElementById('modal-sku-wholesale')?.value) || 0;
      const initialStock = parseInt(document.getElementById('modal-sku-initial-stock')?.value) || 0;
      const reorderThreshold = parseInt(document.getElementById('modal-sku-threshold')?.value) || 5;

      if (!name) { alert('Vui lòng nhập tên sản phẩm!'); return; }
      if (!skuCode) { alert('Vui lòng nhập mã SKU!'); return; }
      if (!barcode) barcode = generateEan13Barcode();

      if (DB.skus.some(s => s.TenantId === DB.currentTenantId && s.SkuCode.toUpperCase() === skuCode)) {
        alert(`Mã SKU "${skuCode}" đã tồn tại trong cửa hàng!`);
        return;
      }

      const prodId = DB.products.length + 1;
      DB.products.push({
        ProductId: prodId,
        TenantId: DB.currentTenantId,
        Name: name,
        CategoryId: categoryId,
        BrandId: brandId,
        Description: ''
      });

      const skuId = DB.skus.length + 1;
      DB.skus.push({
        SKUId: skuId,
        TenantId: DB.currentTenantId,
        ProductId: prodId,
        SkuCode: skuCode,
        VariantName: variantName,
        Barcode: barcode,
        CostPrice: costPrice,
        ReorderThreshold: reorderThreshold
      });

      DB.listedPrices.push({
        PriceId: DB.listedPrices.length + 1,
        TenantId: DB.currentTenantId,
        SKUId: skuId,
        RetailPrice: retailPrice,
        WholesalePrice: wholesalePrice,
        SysStart: new Date().toISOString(),
        SysEnd: '9999-12-31T23:59:59Z'
      });

      const branches = getTenantBranches();
      branches.forEach((b, idx) => {
        const stockQty = (idx === 0) ? initialStock : 0;
        DB.stockLevels.push({
          TenantId: DB.currentTenantId,
          BranchId: b.BranchId,
          SKUId: skuId,
          OnHand: stockQty,
          Reserved: 0
        });

        if (stockQty > 0) {
          DB.inventoryLedger.unshift({
            LedgerId: DB.ledgerSeq++,
            TenantId: DB.currentTenantId,
            BranchId: b.BranchId,
            SKUId: skuId,
            Type: 'IN',
            TxnType: 'Import',
            Quantity: stockQty,
            BalanceAfter: stockQty,
            ReferenceType: 'InitialSetup',
            ReferenceId: skuId,
            CreatedAt: new Date().toISOString()
          });
        }
      });

      logSql(
        `-- TẠO SẢN PHẨM & SKU BIẾN THỂ MỚI (FR-PROD-02, 03, 04)\nINSERT INTO dbo.Products (TenantId, Name, CategoryId, BrandId) VALUES (${DB.currentTenantId}, N'${name}', ${categoryId}, ${brandId});\nINSERT INTO dbo.SKUs (TenantId, ProductId, SkuCode, Barcode, CostPrice) VALUES (${DB.currentTenantId}, SCOPE_IDENTITY(), '${skuCode}', '${barcode}', ${costPrice});\nINSERT INTO dbo.ListedPrices (TenantId, SKUId, RetailPrice, WholesalePrice) VALUES (${DB.currentTenantId}, SCOPE_IDENTITY(), ${retailPrice}, ${wholesalePrice});`,
        `-- Tạo thành công SKU: ${skuCode} với mã vạch EAN-13: ${barcode}!`
      );

      showRealtimeNotification('Tạo Sản Phẩm Thành Công', `Đã thêm sản phẩm "${name}" (${skuCode}) vào hệ thống!`, 'success');
      closeNewProductModal();
      renderMasterProductsTable();
      renderPosProducts();
      renderInventoryTab();
    }

    function renderMasterProductsTable() {
      const tbody = document.getElementById('master-products-table-body');
      if (!tbody) return;
      const search = (document.getElementById('filter-master-products')?.value || '').trim().toLowerCase();
      const skus = getTenantSkus();

      const filtered = skus.filter(s => {
        const p = DB.products.find(x => x.ProductId === s.ProductId);
        const name = (p?.Name || '').toLowerCase();
        const code = s.SkuCode.toLowerCase();
        const barcode = (s.Barcode || '').toLowerCase();
        return name.includes(search) || code.includes(search) || barcode.includes(search);
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-500 text-xs">Không tìm thấy sản phẩm nào.</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(s => {
        const prod = DB.products.find(p => p.ProductId === s.ProductId);
        const cat = DB.categories?.find(c => c.CategoryId === prod?.CategoryId);
        const brand = DB.brands?.find(b => b.BrandId === prod?.BrandId);
        const price = getPrice(s.SKUId);

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-2.5">
              <span class="font-bold text-slate-100">${s.SkuCode}</span>
            </td>
            <td class="p-2.5">
              <div class="font-semibold text-slate-200">${prod?.Name || '-'}</div>
              <div class="text-[10px] text-slate-400 flex items-center space-x-1.5 mt-0.5">
                <span class="text-cyan-400 font-mono">${s.VariantName || 'Mặc định'}</span>
                ${cat ? `<span class="px-1.5 py-0.2 rounded bg-slate-800 text-emerald-400 border border-emerald-500/20">${cat.Name}</span>` : ''}
                ${brand ? `<span class="px-1.5 py-0.2 rounded bg-slate-800 text-indigo-400 border border-indigo-500/20">${brand.Name}</span>` : ''}
              </div>
            </td>
            <td class="p-2.5">
              <div class="flex items-center space-x-1.5">
                <span class="font-mono text-[11px] text-slate-300">${s.Barcode || '-'}</span>
                <button onclick="openBarcodeStickerModal(${s.SKUId})" title="In tem mã vạch Barcode (FR-PROD-03)" class="p-1 bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded">
                  <i data-lucide="scan-barcode" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </td>
            <td class="p-2.5 text-right font-mono text-slate-400">${(s.CostPrice || 0).toLocaleString('vi-VN')} đ</td>
            <td class="p-2.5 text-right font-mono">
              <div class="font-bold text-emerald-400">${price.RetailPrice.toLocaleString('vi-VN')} đ</div>
              <div class="text-[10px] text-slate-400">Sỉ: ${price.WholesalePrice.toLocaleString('vi-VN')} đ</div>
            </td>
            <td class="p-2.5 text-center">
              <div class="flex items-center justify-center space-x-1">
                <button onclick="openPriceModal(${s.SKUId})" title="Đổi giá niêm yết (FR-PROD-04)" class="px-2 py-1 bg-indigo-600/30 hover:bg-indigo-600 text-indigo-300 hover:text-white rounded text-[10px] font-bold">
                  Sửa Giá
                </button>
                <button onclick="openBarcodeStickerModal(${s.SKUId})" title="In Tem Mã Vạch (FR-PROD-03)" class="px-2 py-1 bg-cyan-600/30 hover:bg-cyan-600 text-cyan-300 hover:text-white rounded text-[10px] font-bold">
                  In Tem
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    function openBarcodeStickerModal(skuId) {
      const sku = DB.skus.find(s => s.SKUId === skuId);
      if (!sku) return;
      const prod = DB.products.find(p => p.ProductId === sku.ProductId);
      const price = getPrice(skuId);
      const storeName = DB.currentUser?.StoreName || 'OISM STORE';

      const preview = document.getElementById('barcode-sticker-preview');
      preview.innerHTML = `
        <div class="font-bold text-[11px] uppercase tracking-wide text-slate-600">${storeName}</div>
        <div class="font-bold text-xs text-slate-900 leading-tight">${prod ? prod.Name : ''}</div>
        <div class="text-[10px] text-slate-500 font-mono">${sku.VariantName || ''} | SKU: ${sku.SkuCode}</div>
        <div class="my-2 py-1 border-y border-dashed border-slate-300 flex justify-center items-center">
          ${generateBarcodeSvg(sku.Barcode || sku.SkuCode, 220, 48, false)}
        </div>
        <div class="font-mono text-xs font-semibold tracking-widest text-slate-800">${sku.Barcode || sku.SkuCode}</div>
        <div class="font-bold text-base text-rose-600 font-mono">${price.RetailPrice.toLocaleString('vi-VN')} đ</div>
      `;

      const modal = document.getElementById('barcode-sticker-modal');
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      safeRenderIcons();
    }

    function closeBarcodeStickerModal() {
      const modal = document.getElementById('barcode-sticker-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    function openPriceModal(skuId) {
      const sku = DB.skus.find(s => s.SKUId === skuId);
      if (!sku) return;
      const prod = DB.products.find(p => p.ProductId === sku.ProductId);
      const price = getPrice(skuId);

      document.getElementById('price-modal-sku-id').value = skuId;
      document.getElementById('price-modal-sku-title').innerText = `${prod ? prod.Name : ''} - ${sku.SkuCode} (${sku.VariantName || ''})`;
      document.getElementById('price-modal-current-display').innerText = `Giá bán lẻ: ${price.RetailPrice.toLocaleString('vi-VN')} đ | Giá sỉ: ${price.WholesalePrice.toLocaleString('vi-VN')} đ`;
      document.getElementById('price-modal-retail').value = price.RetailPrice;
      document.getElementById('price-modal-wholesale').value = price.WholesalePrice;

      const modal = document.getElementById('update-price-modal');
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      safeRenderIcons();
    }

    function closePriceModal() {
      const modal = document.getElementById('update-price-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    function submitUpdatePrice() {
      const skuId = parseInt(document.getElementById('price-modal-sku-id')?.value);
      const retail = parseFloat(document.getElementById('price-modal-retail')?.value) || 0;
      const wholesale = parseFloat(document.getElementById('price-modal-wholesale')?.value) || 0;

      if (retail <= 0) {
        alert('Giá bán lẻ phải lớn hơn 0!');
        return;
      }

      const sku = DB.skus.find(s => s.SKUId === skuId);
      let p = DB.listedPrices.find(x => x.TenantId === DB.currentTenantId && x.SKUId === skuId);
      if (p) {
        p.RetailPrice = retail;
        p.WholesalePrice = wholesale;
        p.SysStart = new Date().toISOString();
      } else {
        DB.listedPrices.push({
          PriceId: DB.listedPrices.length + 1,
          TenantId: DB.currentTenantId,
          SKUId: skuId,
          RetailPrice: retail,
          WholesalePrice: wholesale,
          SysStart: new Date().toISOString(),
          SysEnd: '9999-12-31T23:59:59Z'
        });
      }

      logSql(
        `-- CẬP NHẬT GIÁ NIÊM YẾT VỚI BẢNG TEMPORAL (FR-PROD-04)\nUPDATE dbo.ListedPrices\nSET RetailPrice = ${retail}, WholesalePrice = ${wholesale}\nWHERE TenantId = ${DB.currentTenantId} AND SKUId = ${skuId};\n-- SQL Server tự động ghi snapshot bản ghi cũ vào dbo.ListedPrices_History!`,
        `-- Đã cập nhật giá mới cho ${sku?.SkuCode || 'SKU'}: Lẻ ${retail.toLocaleString('vi-VN')} đ, Sỉ ${wholesale.toLocaleString('vi-VN')} đ.`
      );

      showRealtimeNotification('Cập Nhật Giá Thành Công', `Đã cập nhật giá niêm yết mới cho ${sku?.SkuCode || 'SKU'}!`, 'success');
      closePriceModal();
      renderMasterProductsTable();
      renderPosProducts();
      renderReports();
    }

    /* -------------------------------------------------------------
       MODULE 6: BRANCH MANAGEMENT (FR-AUTH-04)
       ------------------------------------------------------------- */
    function renderBranchesTable() {
      populateProvinceDropdowns();
      const tbody = document.getElementById('branches-table-body');
      if (!tbody) return;
      const branches = DB.branches.filter(b => b.TenantId === DB.currentTenantId);

      tbody.innerHTML = branches.map(b => {
        const isVisible = b.IsVisible !== false;
        const statusBadge = isVisible
          ? '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Hoạt Động (Hiển thị)</span>'
          : '<span class="px-2 py-0.5 rounded-full text-[10px] bg-slate-500/20 text-slate-400">Đã Ẩn</span>';

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-3 text-slate-400 font-mono">#${b.BranchId}</td>
            <td class="p-3 font-bold text-slate-200">${b.Name}</td>
            <td class="p-3 text-slate-300 text-xs">${b.Address || '-'}</td>
            <td class="p-3 text-center">${statusBadge}</td>
            <td class="p-3 text-center">
              <button onclick="toggleBranchVisibility(${b.BranchId})" class="px-2.5 py-1 ${isVisible ? 'bg-amber-600/20 text-amber-300 hover:bg-amber-600/30' : 'bg-emerald-600/20 text-emerald-300 hover:bg-emerald-600/30'} rounded text-[10px] font-bold">
                ${isVisible ? 'Ẩn Chi Nhánh' : 'Kích Hoạt'}
              </button>
            </td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    function submitNewBranch() {
      const name = (document.getElementById('new-branch-name')?.value || '').trim();
      const address = (document.getElementById('new-branch-address')?.value || '').trim();
      const isVisible = document.getElementById('new-branch-visible')?.checked ?? true;
      let lat = parseFloat(document.getElementById('new-branch-lat')?.value);
      let lng = parseFloat(document.getElementById('new-branch-lng')?.value);

      if (!name) {
        alert('Vui lòng nhập tên chi nhánh!');
        return;
      }

      // Check if coordinates were verified, if not trigger confirmation modal
      if (!lat || !lng) {
        openGeoConfirmModal(address, 10.7769, 106.7009, (coords) => {
          document.getElementById('new-branch-lat').value = coords.lat;
          document.getElementById('new-branch-lng').value = coords.lng;
          if (coords.address) document.getElementById('new-branch-address').value = coords.address;
          submitNewBranch(); // Retry with confirmed coordinates
        });
        return;
      }

      const newId = DB.branches.length + 1;
      DB.branches.push({
        BranchId: newId,
        TenantId: DB.currentTenantId,
        Name: name,
        Address: address,
        Lat: lat,
        Lng: lng,
        Region: lat > 18 ? 'Miền Bắc' : (lat > 13 ? 'Miền Trung' : (lat > 11.5 && lng > 108 ? 'Tây Nguyên' : 'Miền Nam')),
        IsVisible: isVisible
      });

      getTenantSkus().forEach(s => {
        DB.stockLevels.push({
          TenantId: DB.currentTenantId,
          BranchId: newId,
          SKUId: s.SKUId,
          OnHand: 0,
          Reserved: 0
        });
      });

      document.getElementById('new-branch-name').value = '';
      document.getElementById('new-branch-address').value = '';

      logSql(
        `-- THÊM CHI NHÁNH MỚI (FR-AUTH-04)\nINSERT INTO dbo.Branches (TenantId, Name, Address, IsVisible)\nVALUES (${DB.currentTenantId}, N'${name}', N'${address}', ${isVisible ? 1 : 0});`,
        `-- Chi nhánh "${name}" đã được lưu vào hệ thống cơ sở dữ liệu.`
      );

      showRealtimeNotification('Chi Nhánh Mới', `Đã thêm chi nhánh "${name}" thành công!`, 'success');
      renderBranchesTable();
      populateBranchSelectors();
    }

    function toggleBranchVisibility(branchId) {
      const b = DB.branches.find(x => x.BranchId === branchId);
      if (!b) return;
      b.IsVisible = (b.IsVisible === false) ? true : false;
      logSql(`UPDATE dbo.Branches SET IsVisible = ${b.IsVisible ? 1 : 0} WHERE BranchId = ${branchId};`, `-- Đổi trạng thái hiển thị chi nhánh ${b.Name}`);
      showRealtimeNotification('Cập Nhật Chi Nhánh', `Chi nhánh "${b.Name}" hiện đã ${b.IsVisible ? 'kích hoạt hiển thị' : 'bị ẩn'}.`, 'info');
      renderBranchesTable();
      populateBranchSelectors();
    }

    /* -------------------------------------------------------------
       MODULE 7: 2-STEP STOCK TRANSFERS (FR-INV-03)
       ------------------------------------------------------------- */
    function renderTransfersSubtab() {
      const tbody = document.getElementById('transfers-table-body');
      const skuSelect = document.getElementById('transfer-sku-select');
      const fromSelect = document.getElementById('transfer-from-branch');
      const toSelect = document.getElementById('transfer-to-branch');
      const skus = getTenantSkus();

      if (fromSelect && fromSelect.options.length === 0) populateBranchSelectors();
      if (toSelect && toSelect.options.length === 0) populateBranchSelectors();

      if (skuSelect && skuSelect.options.length === 0) {
        skuSelect.innerHTML = skus.map(s => {
          const prod = DB.products.find(p => p.ProductId === s.ProductId);
          return `<option value="${s.SKUId}">${s.SkuCode} - ${prod ? prod.Name : ''} (${s.VariantName || ''})</option>`;
        }).join('');
      }

      updateTransferAvailableStock();

      if (!tbody) return;
      const transfers = (DB.transfers || []).filter(t => t.TenantId === DB.currentTenantId);

      if (transfers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-500 text-xs">Chưa có lệnh chuyển kho nào.</td></tr>';
        return;
      }

      tbody.innerHTML = transfers.map(t => {
        const fromB = DB.branches.find(b => b.BranchId === t.FromBranchId);
        const toB = DB.branches.find(b => b.BranchId === t.ToBranchId);
        const sku = DB.skus.find(s => s.SKUId === t.SKUId);
        const isDispatched = t.Status === 'Dispatched';

        const statusBadge = isDispatched
          ? '<span class="px-2 py-0.5 rounded-full text-[10px] bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 animate-pulse">1. Đang Chuyển (In-Transit)</span>'
          : '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">2. Đã Nhập Kho (Completed)</span>';

        const action = isDispatched
          ? `<button onclick="submitReceiveTransfer(${t.TransferId})" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-[10px] font-bold shadow transition">2. Xác Nhận Nhập Kho</button>`
          : `<span class="text-slate-500 text-[10px] font-mono">${t.ReceivedAt ? new Date(t.ReceivedAt).toLocaleTimeString('vi-VN') : 'Hoàn tất'}</span>`;

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-2.5 font-bold text-slate-200">${t.TransferNo}</td>
            <td class="p-2.5 text-slate-300 font-medium">${fromB ? fromB.Name : '-'}</td>
            <td class="p-2.5 text-slate-300 font-medium">${toB ? toB.Name : '-'}</td>
            <td class="p-2.5 text-cyan-400 font-bold">${sku ? sku.SkuCode : '-'}</td>
            <td class="p-2.5 text-right font-bold text-slate-100">${t.Quantity}</td>
            <td class="p-2.5 text-center">${statusBadge}</td>
            <td class="p-2.5 text-center">${action}</td>
          </tr>
        `;
      }).join('');
      safeRenderIcons();
    }

    function updateTransferAvailableStock() {
      const fromSelect = document.getElementById('transfer-from-branch');
      const skuSelect = document.getElementById('transfer-sku-select');
      const disp = document.getElementById('transfer-available-stock');
      if (!fromSelect || !skuSelect || !disp) return;

      const fromBranchId = parseInt(fromSelect.value) || 1;
      const skuId = parseInt(skuSelect.value) || 1;
      const st = getStock(fromBranchId, skuId);
      disp.innerText = `${st.Available} cái`;
    }

    function submitDispatchTransfer() {
      const fromBranchId = parseInt(document.getElementById('transfer-from-branch')?.value);
      const toBranchId = parseInt(document.getElementById('transfer-to-branch')?.value);
      const skuId = parseInt(document.getElementById('transfer-sku-select')?.value);
      const qty = parseInt(document.getElementById('transfer-qty')?.value) || 0;
      const note = (document.getElementById('transfer-note')?.value || '').trim();

      if (fromBranchId === toBranchId) {
        alert('Kho nguồn và kho đích nhận hàng không được trùng nhau!');
        return;
      }
      if (qty <= 0) {
        alert('Số lượng chuyển kho phải lớn hơn 0!');
        return;
      }

      const stockFrom = getStock(fromBranchId, skuId);
      if (stockFrom.Available < qty) {
        alert(`Kho nguồn chỉ còn ${stockFrom.Available} cái khả dụng, không đủ xuất ${qty} cái!`);
        return;
      }

      const stSource = DB.stockLevels.find(s => s.BranchId === fromBranchId && s.SKUId === skuId);
      stSource.OnHand -= qty;

      DB.inventoryLedger.unshift({
        LedgerId: DB.ledgerSeq++,
        TenantId: DB.currentTenantId,
        BranchId: fromBranchId,
        SKUId: skuId,
        Type: 'OUT',
        TxnType: 'TransferOut',
        Quantity: qty,
        BalanceAfter: stSource.OnHand,
        ReferenceType: 'StockTransfer',
        ReferenceId: DB.transferSeq,
        CreatedAt: new Date().toISOString()
      });

      const transferNo = `TRF-${new Date().toISOString().slice(0, 10).replace(/-/g, '')}-${String(DB.transferSeq).padStart(3, '0')}`;
      DB.transfers.unshift({
        TransferId: DB.transferSeq++,
        TransferNo: transferNo,
        TenantId: DB.currentTenantId,
        FromBranchId: fromBranchId,
        ToBranchId: toBranchId,
        SKUId: skuId,
        Quantity: qty,
        Status: 'Dispatched',
        Note: note,
        DispatchedAt: new Date().toISOString(),
        DispatchedBy: DB.currentUser?.FullName || 'Quản trị viên',
        ReceivedAt: null,
        ReceivedBy: null
      });

      logSql(
        `-- BƯỚC 1: XUẤT CHUYỂN KHO OUT-BOUND (FR-INV-03)\nEXEC dbo.usp_DispatchStockTransfer\n  @FromBranchId = ${fromBranchId},\n  @ToBranchId = ${toBranchId},\n  @SKUId = ${skuId},\n  @Quantity = ${qty},\n  @Note = N'${note}';`,
        `-- Lệnh chuyển kho ${transferNo} đã tạo. Đã trừ ${qty} hàng tại kho nguồn và đưa vào trạng thái In-Transit.`
      );

      playBeep('success');
      showRealtimeNotification('Xuất Chuyển Kho', `Lệnh ${transferNo}: ${qty} sản phẩm đang được chuyển đến kho đích!`, 'info');
      renderTransfersSubtab();
      renderInventoryTab();
    }

    function submitReceiveTransfer(transferId) {
      const t = (DB.transfers || []).find(x => x.TransferId === transferId);
      if (!t || t.Status !== 'Dispatched') return;

      let stDest = DB.stockLevels.find(s => s.BranchId === t.ToBranchId && s.SKUId === t.SKUId);
      if (!stDest) {
        stDest = {
          TenantId: DB.currentTenantId,
          BranchId: t.ToBranchId,
          SKUId: t.SKUId,
          OnHand: 0,
          Reserved: 0
        };
        DB.stockLevels.push(stDest);
      }
      stDest.OnHand += t.Quantity;

      DB.inventoryLedger.unshift({
        LedgerId: DB.ledgerSeq++,
        TenantId: DB.currentTenantId,
        BranchId: t.ToBranchId,
        SKUId: t.SKUId,
        Type: 'IN',
        TxnType: 'TransferIn',
        Quantity: t.Quantity,
        BalanceAfter: stDest.OnHand,
        ReferenceType: 'StockTransfer',
        ReferenceId: t.TransferId,
        CreatedAt: new Date().toISOString()
      });

      t.Status = 'Received';
      t.ReceivedAt = new Date().toISOString();
      t.ReceivedBy = DB.currentUser?.FullName || 'Thủ kho đích';

      logSql(
        `-- BƯỚC 2: NHẬP KHO ĐÍCH IN-BOUND (FR-INV-03)\nEXEC dbo.usp_ReceiveStockTransfer\n  @TransferId = ${transferId},\n  @ReceivedByUserId = ${DB.currentUser?.UserId || 1};`,
        `-- Lệnh chuyển kho ${t.TransferNo} đã hoàn tất 2 bước. Hàng đã ghi tăng vào tồn kho đích!`
      );

      playBeep('success');
      showRealtimeNotification('Nhập Kho Thành Công', `Đã xác nhận nhập ${t.Quantity} sản phẩm vào kho đích!`, 'success');
      renderTransfersSubtab();
      renderInventoryTab();
    }

    /* -------------------------------------------------------------
       MODULE 8: SHIPPING SLIP & PACKING LIST (FR-ORD-03)
       ------------------------------------------------------------- */
    function openShippingSlipModal(orderId) {
      const order = DB.orders.find(o => o.OrderId === orderId);
      if (!order) return;
      const branch = DB.branches.find(b => b.BranchId === order.BranchId);
      const storeName = DB.currentUser?.StoreName || 'CỬA HÀNG MINH ANH';
      const orderBarcode = generateBarcodeSvg(order.OrderNo, 260, 48, false);

      const printableArea = document.getElementById('shipping-slip-printable-area');
      printableArea.innerHTML = `
        <div class="space-y-4">
          <div class="flex justify-between items-start border-b-2 border-slate-900 pb-3">
            <div>
              <h2 class="text-base font-extrabold uppercase text-slate-900 tracking-wide">${storeName}</h2>
              <div class="text-[11px] text-slate-600">${branch ? branch.Name : 'Trụ sở chính'} • ${branch?.Address || 'TP.HCM'}</div>
              <div class="text-[11px] text-slate-600">Hotline: 1900 6868 | Website: https://oism.vn</div>
            </div>
            <div class="text-right">
              ${orderBarcode}
              <div class="font-mono text-xs font-bold text-slate-800 tracking-widest mt-0.5">${order.OrderNo}</div>
            </div>
          </div>

          <div class="text-center py-1">
            <h1 class="text-lg font-black uppercase text-slate-900">PHIẾU ĐÓNG GÓI & GIAO HÀNG</h1>
            <p class="text-[11px] text-slate-500 font-mono">Mã đơn hệ thống: ${order.OrderNo} • Kênh: ${order.Channel} ${order.ExternalOrderId ? `(Mã sàn: ${order.ExternalOrderId})` : ''}</p>
          </div>

          <div class="grid grid-cols-2 gap-4 p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs">
            <div>
              <div class="font-bold text-slate-800 uppercase text-[10px] text-slate-400 mb-1">Người nhận hàng:</div>
              <div class="font-bold text-slate-900 text-sm">Khách hàng ${order.Channel}</div>
              <div class="text-slate-600 mt-0.5">Địa chỉ: 123 Đường Nguyễn Trãi, Quận 1, TP.HCM</div>
              <div class="text-slate-600 font-mono mt-0.5">Điện thoại: 0908 *** 999</div>
            </div>
            <div>
              <div class="font-bold text-slate-800 uppercase text-[10px] text-slate-400 mb-1">Thông tin vận đơn:</div>
              <div class="text-slate-700">Ngày đặt: <span class="font-mono font-bold">${new Date(order.CreatedAt).toLocaleString('vi-VN')}</span></div>
              <div class="text-slate-700">Trạng thái: <span class="font-bold uppercase text-indigo-700">${order.Status}</span></div>
              <div class="text-slate-700">Hình thức: <span class="font-bold">Giao hàng tiêu chuẩn (COD)</span></div>
            </div>
          </div>

          <table class="w-full text-left border-collapse text-xs mt-2">
            <thead>
              <tr class="border-b-2 border-slate-800 text-slate-700 font-bold uppercase text-[10px]">
                <th class="py-2">STT</th>
                <th class="py-2">Mã SKU</th>
                <th class="py-2">Tên Mặt Hàng / Biến Thể</th>
                <th class="py-2 text-right">SL</th>
                <th class="py-2 text-right">Đơn Giá</th>
                <th class="py-2 text-right">Thành Tiền</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              ${(order.items || []).map((i, idx) => {
        const sku = DB.skus.find(s => s.SKUId === i.SKUId);
        const prod = DB.products.find(p => p.ProductId === sku?.ProductId);
        const lineTotal = (i.UnitPrice || 0) * (i.Quantity || 1);
        return `
                  <tr>
                    <td class="py-2 font-mono">${idx + 1}</td>
                    <td class="py-2 font-mono font-bold text-slate-900">${sku ? sku.SkuCode : '-'}</td>
                    <td class="py-2">${prod ? prod.Name : ''} <span class="text-slate-500">(${sku?.VariantName || ''})</span></td>
                    <td class="py-2 text-right font-bold text-slate-900">${i.Quantity}</td>
                    <td class="py-2 text-right font-mono">${(i.UnitPrice || 0).toLocaleString('vi-VN')} đ</td>
                    <td class="py-2 text-right font-mono font-bold text-slate-900">${lineTotal.toLocaleString('vi-VN')} đ</td>
                  </tr>
                `;
      }).join('')}
            </tbody>
          </table>

          <div class="flex justify-end pt-2 border-t border-slate-300">
            <div class="w-64 space-y-1 text-xs">
              <div class="flex justify-between text-slate-600">
                <span>Tiền hàng:</span>
                <span class="font-mono">${order.TotalAmount.toLocaleString('vi-VN')} đ</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>Phí vận chuyển:</span>
                <span class="font-mono">0 đ</span>
              </div>
              <div class="flex justify-between text-slate-900 font-black text-sm border-t border-slate-800 pt-1">
                <span>TỔNG THU (COD):</span>
                <span class="text-rose-600 font-mono">${order.TotalAmount.toLocaleString('vi-VN')} đ</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4 pt-6 text-center text-xs text-slate-600">
            <div>
              <div class="font-bold text-slate-800 uppercase text-[10px]">Người Lập Phiếu</div>
              <div class="h-14"></div>
              <div class="font-semibold text-slate-700">${DB.currentUser?.FullName || 'Nguyễn Minh Anh'}</div>
            </div>
            <div>
              <div class="font-bold text-slate-800 uppercase text-[10px]">Đóng Gói Kho</div>
              <div class="h-14"></div>
              <div class="font-semibold text-slate-700">Trần Quốc Bảo</div>
            </div>
            <div>
              <div class="font-bold text-slate-800 uppercase text-[10px]">Khách Hàng Ký Nhận</div>
              <div class="h-14"></div>
              <div class="text-[10px] text-slate-400">(Ký và ghi rõ họ tên)</div>
            </div>
          </div>
        </div>
      `;

      const modal = document.getElementById('shipping-slip-modal');
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      safeRenderIcons();
    }

    function closeShippingSlipModal() {
      const modal = document.getElementById('shipping-slip-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    /* -------------------------------------------------------------
       MODULE 9: SLOW-MOVING INVENTORY REPORT (FR-REP-02)
       ------------------------------------------------------------- */
    function renderSlowMovingReport() {
      const tbody = document.getElementById('slow-moving-table-body');
      if (!tbody) return;

      const skus = getTenantSkus();
      const rows = [];

      skus.forEach(s => {
        const prod = DB.products.find(p => p.ProductId === s.ProductId);
        const totalOnHand = DB.stockLevels
          .filter(st => st.TenantId === DB.currentTenantId && st.SKUId === s.SKUId)
          .reduce((sum, st) => sum + st.OnHand, 0);

        if (totalOnHand > 0) {
          const holdingCost = totalOnHand * (s.CostPrice || 0);
          let riskBadge = '<span class="px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-400">Bình thường</span>';
          if (holdingCost >= 3000000 || totalOnHand >= 30) {
            riskBadge = '<span class="px-2 py-0.5 rounded text-[10px] bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold">Rất Cao (Khuyến nghị xả)</span>';
          } else if (holdingCost >= 1000000 || totalOnHand >= 15) {
            riskBadge = '<span class="px-2 py-0.5 rounded text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold">Trung Bình (Cần theo dõi)</span>';
          }

          rows.push({
            skuCode: s.SkuCode,
            prodName: prod?.Name || '-',
            variant: s.VariantName || '-',
            onHand: totalOnHand,
            costPrice: s.CostPrice || 0,
            holdingCost: holdingCost,
            riskBadge: riskBadge
          });
        }
      });

      rows.sort((a, b) => b.holdingCost - a.holdingCost);

      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-500 text-xs">Hiện tại kho hàng không có sản phẩm tồn đọng.</td></tr>';
        return;
      }

      tbody.innerHTML = rows.map(r => `
        <tr class="hover:bg-slate-800/40 transition">
          <td class="p-2.5 font-bold text-slate-200">${r.skuCode}</td>
          <td class="p-2.5 text-slate-300 font-medium">${r.prodName}</td>
          <td class="p-2.5 text-cyan-400 text-xs">${r.variant}</td>
          <td class="p-2.5 text-right font-bold text-slate-100">${r.onHand}</td>
          <td class="p-2.5 text-right text-slate-400 font-mono">${r.costPrice.toLocaleString('vi-VN')} đ</td>
          <td class="p-2.5 text-right font-bold text-rose-400 font-mono">${r.holdingCost.toLocaleString('vi-VN')} đ</td>
          <td class="p-2.5 text-center">${r.riskBadge}</td>
        </tr>
      `).join('');
      safeRenderIcons();
    }

    /* -------------------------------------------------------------
       INIT APPLICATION
       ------------------------------------------------------------- */
    function initApp() {
      try {
        updateUserProfileDisplay();
        applyRbacPermissions();
        populateBranchSelectors();
        renderPosProducts();
        renderCart();
        updateLowStockAlert();
        renderMasterProductsTable();
        renderCategoriesAndBrands();
        renderBranchesTable();
        renderTransfersSubtab();
        safeRenderIcons();
      } catch (err) {
        console.warn('Lỗi trong initApp:', err);
      }
    }

    let isLiveApi = false;
    const API_BASE = 'http://localhost:5000/api';

    async function checkApiHealth() {
      const badge = document.getElementById('backend-status-badge');
      const authBadge = document.getElementById('auth-backend-status');
      try {
        const res = await fetch(`${API_BASE}/health`, { signal: AbortSignal.timeout(1500) });
        const data = await res.json();
        if (data.success) {
          isLiveApi = true;
          if (badge) {
            badge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center space-x-1';
            badge.innerHTML = '<span>● Live SQL Server 2022 (Đã kết nối)</span>';
          }
          if (authBadge) {
            authBadge.className = 'inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
            authBadge.innerHTML = '<span>● Live SQL Server (Online)</span>';
          }
          logSql(
            `-- KẾT NỐI REAL-TIME TỚI SQL SERVER 2022 THÀNH CÔNG`,
            `-- Database: ${data.data.databaseName} | RCSI: ${data.data.rcsiEnabled ? 'ON' : 'OFF'}\n-- Mọi thao tác bán hàng, kiểm kê, nhập hàng sẽ ghi thẳng vào SSMS!`
          );
        }
      } catch (e) {
        isLiveApi = false;
        if (badge) {
          badge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700';
          badge.innerHTML = '<span>● Demo In-Memory (Chạy độc lập)</span>';
        }
        if (authBadge) {
          authBadge.className = 'inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-amber-400 border border-slate-700';
          authBadge.innerHTML = '<span>● Chế độ Demo Sẵn sàng</span>';
        }
      }
    }

    // Run on startup
    /* -------------------------------------------------------------
       MODULE 7: LEAFLET GPS MAP & LOGISTICS ROUTING (SQL SERVER SPATIAL)
       ------------------------------------------------------------- */

    /* -------------------------------------------------------------
       GOOGLE MAPS & ESRI MULTI-LAYER TILE PROVIDER (NO API KEY REQUIRED)
       ------------------------------------------------------------- */
    function addStandardTileLayers(mapInstance) {
      if (!mapInstance || typeof L === 'undefined') return;

      const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        attribution: '© Google Maps'
      });

      const googleHybrid = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        attribution: '© Google Satellite'
      });

      const esriStreets = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19,
        attribution: '© Esri WorldStreetMap'
      });

      // Default active: Google Streets
      googleStreets.addTo(mapInstance);

      try {
        L.control.layers({
          "🗺️ Đường Phố (Google)": googleStreets,
          "🛰️ Vệ Tinh (Google)": googleHybrid,
          "🏙️ Bản Đồ Esri": esriStreets
        }, null, { position: 'topright' }).addTo(mapInstance);
      } catch (e) { }

      return googleStreets;
    }


    let leafletMap = null;
    let markersLayer = null;
    let deliveryLayer = null;
    let userLocationMarker = null;
    let driverSimulationTimer = null;
    let currentMapMode = 'warehouses';

    function initLeafletMap() {
      if (leafletMap) {
        setTimeout(() => leafletMap.invalidateSize(), 200);
        return;
      }

      const mapContainer = document.getElementById('oism-leaflet-map');
      if (!mapContainer) return;

      // Initialize map centered at HCMC
      leafletMap = L.map('oism-leaflet-map', {
        zoomControl: true,
        attributionControl: false
      }).setView([16.0544, 108.2022], 6);

      // OpenStreetMap Tiles with subtle dark/modern filter
      // Primary: CartoDB Voyager (High speed, reliable, beautiful typography for Vietnam)
      addStandardTileLayers(leafletMap);

      markersLayer = L.layerGroup().addTo(leafletMap);
      deliveryLayer = L.layerGroup().addTo(leafletMap);

      setTimeout(() => leafletMap.invalidateSize(), 300);
    }

    function renderMapTab() {
      initLeafletMap();
      renderMapBranchesList();
      populateMapDistanceDropdowns();
      populateMapOrdersDropdown();

      if (currentMapMode === 'warehouses') {
        renderWarehouseMarkers();
      } else {
        selectOrderForTracking();
      }
    }

    function switchMapMode(mode) {
      currentMapMode = mode;
      const btnWh = document.getElementById('btn-map-mode-warehouses');
      const btnDel = document.getElementById('btn-map-mode-delivery');
      const pnlWh = document.getElementById('panel-map-warehouses');
      const pnlDel = document.getElementById('panel-map-delivery');

      if (mode === 'warehouses') {
        btnWh.className = 'py-2 rounded-lg bg-emerald-600 text-white flex items-center justify-center space-x-1 transition';
        btnDel.className = 'py-2 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition';
        pnlWh.classList.remove('hidden');
        pnlDel.classList.add('hidden');
        renderWarehouseMarkers();
      } else {
        btnDel.className = 'py-2 rounded-lg bg-emerald-600 text-white flex items-center justify-center space-x-1 transition';
        btnWh.className = 'py-2 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition';
        pnlDel.classList.remove('hidden');
        pnlWh.classList.add('hidden');
        selectOrderForTracking();
      }
    }

    function renderMapBranchesList() {
      const container = document.getElementById('map-branches-list');
      const branches = DB.branches.filter(b => b.TenantId === DB.currentTenantId);

      container.innerHTML = branches.map(b => {
        const onHandTotal = DB.stockLevels
          .filter(s => s.BranchId === b.BranchId)
          .reduce((sum, s) => sum + s.OnHand, 0);

        return `
          <div onclick="focusBranchOnMap(${b.BranchId})" class="p-2.5 bg-slate-950 hover:bg-slate-800/80 border border-slate-800 rounded-lg cursor-pointer transition flex items-center justify-between">
            <div>
              <div class="font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span>${b.Name}</span>
              </div>
              <div class="text-[10px] text-slate-400 font-mono mt-0.5">GPS: ${b.Lat || 10.7769}, ${b.Lng || 106.7009}</div>
            </div>
            <div class="text-right">
              <span class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-indigo-500/20 text-indigo-300">
                ${onHandTotal} SP
              </span>
            </div>
          </div>
        `;
      }).join('');
      lucide.createIcons();
    }

    function renderWarehouseMarkers() {
      if (!leafletMap || !markersLayer) return;
      markersLayer.clearLayers();
      deliveryLayer.clearLayers();

      const branches = DB.branches.filter(b => b.TenantId === DB.currentTenantId);
      const bounds = [];

      branches.forEach(b => {
        const lat = b.Lat || 10.7769;
        const lng = b.Lng || 106.7009;
        bounds.push([lat, lng]);

        const onHandTotal = DB.stockLevels
          .filter(s => s.BranchId === b.BranchId)
          .reduce((sum, s) => sum + s.OnHand, 0);

        // Custom HTML Marker Icon
        const iconHtml = `
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-emerald-600 text-white shadow-xl border-2 border-white font-bold text-xs ring-4 ring-emerald-500/30 animate-bounce">
            🏬
          </div>
        `;
        const customIcon = L.divIcon({
          className: 'custom-warehouse-pin',
          html: iconHtml,
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });

        const marker = L.marker([lat, lng], { icon: customIcon }).addTo(markersLayer);
        marker.bindPopup(`
          <div class="font-sans text-xs p-1">
            <h4 class="font-bold text-sm text-slate-900">${b.Name}</h4>
            <p class="text-gray-600 text-[11px] mb-2">${b.Address || 'Việt Nam'}</p>
            <div class="p-1.5 bg-gray-100 rounded text-[11px] font-mono">
              <div>Tọa độ GPS: <strong>${lat}, ${lng}</strong></div>
              <div>Tổng tồn kho: <strong class="text-indigo-600">${onHandTotal} sản phẩm</strong></div>
            </div>
            <div class="mt-2 text-right">
              <span class="text-[9px] text-gray-400 font-mono">SQL Server Spatial Geography (4326)</span>
            </div>
          </div>
        `);
      });

      if (bounds.length > 0) {
        leafletMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 14 });
      }
    }

    function focusBranchOnMap(branchId) {
      const b = DB.branches.find(x => x.BranchId === branchId);
      if (!b || !leafletMap) return;
      leafletMap.flyTo([b.Lat || 10.7769, b.Lng || 106.7009], 15, { duration: 1.2 });
    }

    function populateMapDistanceDropdowns() {
      const branches = DB.branches.filter(b => b.TenantId === DB.currentTenantId);
      const fromSel = document.getElementById('calc-from-branch');
      const toSel = document.getElementById('calc-to-branch');
      if (!fromSel || !toSel) return;

      fromSel.innerHTML = branches.map(b => `<option value="${b.BranchId}">${b.Name}</option>`).join('');
      toSel.innerHTML = branches.map(b => `<option value="${b.BranchId}">${b.Name}</option>`).join('');
      if (branches.length > 1) toSel.selectedIndex = 1;
      calculateWarehouseDistance();
    }

    function calculateWarehouseDistance() {
      const fromId = parseInt(document.getElementById('calc-from-branch').value);
      const toId = parseInt(document.getElementById('calc-to-branch').value);
      const b1 = DB.branches.find(b => b.BranchId === fromId);
      const b2 = DB.branches.find(b => b.BranchId === toId);

      if (!b1 || !b2) return;

      const lat1 = b1.Lat || 10.7769;
      const lon1 = b1.Lng || 106.7009;
      const lat2 = b2.Lat || 10.8504;
      const lon2 = b2.Lng || 106.7719;

      // Haversine formula (km)
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const dist = (R * c).toFixed(2);

      document.getElementById('calculated-distance').innerText = `${dist} km`;

      logSql(
        `-- [SQL SERVER 2022 SPATIAL] TÍNH KHOẢNG CÁCH GIỮA 2 KHO (STDistance)`,
        `DECLARE @Kho1 geography = geography::Point(${lat1}, ${lon1}, 4326); -- ${b1.Name}\nDECLARE @Kho2 geography = geography::Point(${lat2}, ${lon2}, 4326); -- ${b2.Name}\nSELECT @Kho1.STDistance(@Kho2) / 1000.0 AS Distance_Km; -- Kết quả: ${dist} km`
      );

      // Draw dashed connecting line if in warehouses mode
      if (leafletMap && deliveryLayer && fromId !== toId) {
        deliveryLayer.clearLayers();
        const poly = L.polyline([[lat1, lon1], [lat2, lon2]], {
          color: '#6366f1',
          weight: 3,
          dashArray: '6, 8'
        }).addTo(deliveryLayer);
        leafletMap.fitBounds(poly.getBounds(), { padding: [60, 60] });
      }
    }

    function populateMapOrdersDropdown() {
      const sel = document.getElementById('map-active-order-select');
      if (!sel) return;
      const orders = DB.orders.filter(o => o.TenantId === DB.currentTenantId);
      sel.innerHTML = orders.map(o => `
        <option value="${o.OrderId}">${o.OrderNo} • ${o.Channel} (${o.Status})</option>
      `).join('');
    }

    function selectOrderForTracking() {
      const sel = document.getElementById('map-active-order-select');
      if (!sel) return;
      const orderId = parseInt(sel.value);
      const order = DB.orders.find(o => o.OrderId === orderId) || DB.orders[0];
      if (!order) return;

      document.getElementById('track-channel').innerText = order.Channel;
      document.getElementById('track-order-no').innerText = order.OrderNo;
      document.getElementById('track-status').innerText = order.Status === 'Completed' ? 'Đã Giao Thành Công' : 'Đang Vận Chuyển';

      const originBranch = DB.branches.find(b => b.BranchId === order.BranchId) || DB.branches[0];
      const originLat = originBranch?.Lat || 10.8504;
      const originLng = originBranch?.Lng || 106.7719;

      // Simulated customer location nearby
      const destLat = 10.7769 + (Math.sin(order.OrderId) * 0.02);
      const destLng = 106.7009 + (Math.cos(order.OrderId) * 0.02);

      document.getElementById('track-origin').innerText = originBranch?.Name || 'Kho trung tâm';
      document.getElementById('track-dest').innerText = '45 Lê Duẩn, Bến Nghé, Q.1, TP.HCM';
      document.getElementById('track-driver').innerText = order.Channel === 'Shopee' ? 'Nguyễn Tuấn (SPX-9988)' : 'Trần Hoàng (GHTK-5544)';

      renderDeliveryRoute(originLat, originLng, destLat, destLng);
    }

    let activeDeliveryRoute = null;
    let activeDriverMarker = null;

    function renderDeliveryRoute(origLat, origLng, destLat, destLng) {
      if (!leafletMap || !deliveryLayer) return;
      deliveryLayer.clearLayers();
      markersLayer.clearLayers();

      // Origin Marker (Warehouse)
      const originIcon = L.divIcon({
        className: 'custom-orig-pin',
        html: `<div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold shadow-lg border-2 border-white ring-4 ring-indigo-500/30">🏬</div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });
      L.marker([origLat, origLng], { icon: originIcon }).addTo(deliveryLayer)
        .bindPopup(`<strong>Kho Xuất Hàng:</strong><br>${document.getElementById('track-origin').innerText}`);

      // Destination Marker (Customer)
      const destIcon = L.divIcon({
        className: 'custom-dest-pin',
        html: `<div class="w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold shadow-lg border-2 border-white ring-4 ring-rose-500/30">🏠</div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });
      L.marker([destLat, destLng], { icon: destIcon }).addTo(deliveryLayer)
        .bindPopup(`<strong>Địa Chỉ Giao:</strong><br>${document.getElementById('track-dest').innerText}`);

      // Route Path (Polyline with intermediate GPS waypoints)
      const midLat1 = origLat * 0.7 + destLat * 0.3 + 0.005;
      const midLng1 = origLng * 0.7 + destLng * 0.3 - 0.005;
      const midLat2 = origLat * 0.3 + destLat * 0.7 - 0.005;
      const midLng2 = origLng * 0.3 + destLng * 0.7 + 0.005;

      const pathPoints = [
        [origLat, origLng],
        [midLat1, midLng1],
        [midLat2, midLng2],
        [destLat, destLng]
      ];

      activeDeliveryRoute = pathPoints;

      // Draw Route
      const poly = L.polyline(pathPoints, {
        color: '#10b981',
        weight: 4,
        opacity: 0.9,
        lineCap: 'round'
      }).addTo(deliveryLayer);

      // Shipper Marker (Motorbike 🛵)
      const driverIcon = L.divIcon({
        className: 'custom-driver-pin',
        html: `<div class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold shadow-2xl border-2 border-white ring-4 ring-amber-400/40 text-base">🛵</div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });
      activeDriverMarker = L.marker(pathPoints[1], { icon: driverIcon }).addTo(deliveryLayer);
      activeDriverMarker.bindPopup(`<strong>Tài Xế:</strong> ${document.getElementById('track-driver').innerText}`);

      leafletMap.fitBounds(poly.getBounds(), { padding: [60, 60] });
    }

    function simulateDriverMovement() {
      if (!activeDriverMarker || !activeDeliveryRoute) return;
      playBeep('success');

      let step = 0;
      const totalSteps = 20;
      const [p0, p1, p2, p3] = activeDeliveryRoute;

      if (driverSimulationTimer) clearInterval(driverSimulationTimer);

      driverSimulationTimer = setInterval(() => {
        step++;
        const t = step / totalSteps;
        // Bezier interpolation
        const lat = Math.pow(1 - t, 3) * p0[0] + 3 * Math.pow(1 - t, 2) * t * p1[0] + 3 * (1 - t) * Math.pow(t, 2) * p2[0] + Math.pow(t, 3) * p3[0];
        const lng = Math.pow(1 - t, 3) * p0[1] + 3 * Math.pow(1 - t, 2) * t * p1[1] + 3 * (1 - t) * Math.pow(t, 2) * p2[1] + Math.pow(t, 3) * p3[1];

        activeDriverMarker.setLatLng([lat, lng]);

        const remDist = Math.max(0, (3.8 * (1 - t))).toFixed(1);
        const remEta = Math.max(1, Math.round(12 * (1 - t)));
        document.getElementById('track-remaining-dist').innerText = `${remDist} km`;
        document.getElementById('track-eta').innerText = `${remEta} phút`;

        if (step >= totalSteps) {
          clearInterval(driverSimulationTimer);
          document.getElementById('track-status').innerText = 'Đã Đến Điểm Giao';
          document.getElementById('track-status').className = 'px-2 py-0.5 rounded-full text-[10px] bg-emerald-500 text-white font-bold';
          confetti({ particleCount: 60, spread: 50, origin: { y: 0.6 } });
          alert('Tài xế đã hoàn tất lộ trình giao hàng!');
        }
      }, 400);
    }

    function viewOrderOnMap(orderId) {
      switchTab('map');
      switchMapMode('delivery');
      const sel = document.getElementById('map-active-order-select');
      if (sel) {
        sel.value = orderId;
        selectOrderForTracking();
      }
    }

    function getUserCurrentGps() {
      if (!navigator.geolocation) {
        alert('Trình duyệt của bạn không hỗ trợ định vị GPS!');
        return;
      }

      navigator.geolocation.getCurrentPosition(pos => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        if (userLocationMarker && leafletMap) {
          leafletMap.removeLayer(userLocationMarker);
        }

        const userIcon = L.divIcon({
          className: 'custom-user-pin',
          html: `<div class="w-6 h-6 rounded-full bg-cyan-500 border-2 border-white shadow-xl ring-8 ring-cyan-500/30"></div>`,
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        });

        if (leafletMap) {
          userLocationMarker = L.marker([lat, lng], { icon: userIcon }).addTo(leafletMap);
          userLocationMarker.bindPopup(`<strong>Vị Trí Của Bạn (GPS HTML5):</strong><br>${lat.toFixed(5)}, ${lng.toFixed(5)}`).openPopup();
          leafletMap.flyTo([lat, lng], 15, { duration: 1.5 });
        }

        alert(`Đã lấy vị trí GPS thành công!\nTọa độ: ${lat.toFixed(5)}, ${lng.toFixed(5)}`);
      }, err => {
        alert('Không thể lấy tọa độ GPS: ' + err.message);
      });
    }

    function recenterMap() {
      if (currentMapMode === 'warehouses') {
        renderWarehouseMarkers();
      } else {
        selectOrderForTracking();
      }
    }



    // Run on startup

    /* =============================================================
       MODULE 8: NATIONWIDE GEOCODING & PINPOINT CONFIRMATION MODAL
       ============================================================= */
    let geoConfirmMap = null;
    let geoConfirmMarker = null;
    let geoConfirmCurrentCoords = { lat: 10.7769, lng: 106.7009 };
    let geoConfirmTargetCallback = null;

    // Vietnam Nationwide Geocoding Database for instant, reliable fallback
    const VIETNAM_GEO_DB = [
      { keywords: ['hà nội', 'hanoi', 'hoàn kiếm', 'ba đình', 'đống đa', 'cầu giấy', 'hai bà trưng'], name: 'Hoàn Kiếm, Hà Nội (Thủ Đô)', lat: 21.0285, lng: 105.8542, region: 'Miền Bắc' },
      { keywords: ['hải phòng', 'haiphong', 'đình vũ', 'đồ sơn', 'hồng bàng', 'ngô quyền'], name: 'Khu kinh tế Đình Vũ, Hải Phòng', lat: 20.8449, lng: 106.6881, region: 'Miền Bắc' },
      { keywords: ['sa pa', 'sapa', 'lào cai', 'fansipan', 'cầu mây'], name: 'Thị xã Sa Pa, Lào Cai', lat: 22.3364, lng: 103.8438, region: 'Miền Bắc' },
      { keywords: ['quảng ninh', 'hạ long', 'bãi cháy', 'uông bí', 'cẩm phả'], name: 'TP. Hạ Long, Quảng Ninh', lat: 20.9505, lng: 107.0734, region: 'Miền Bắc' },
      { keywords: ['đà nẵng', 'danang', 'hải châu', 'sơn trà', 'ngũ hành sơn', 'thanh khê'], name: 'Hải Châu, TP. Đà Nẵng', lat: 16.0544, lng: 108.2022, region: 'Miền Trung' },
      { keywords: ['huế', 'hue', 'thừa thiên', 'hương thủy', 'phú nhuận huế'], name: 'TP. Huế, Thừa Thiên Huế', lat: 16.4637, lng: 107.5909, region: 'Miền Trung' },
      { keywords: ['hội an', 'hoian', 'quảng nam', 'tam kỳ'], name: 'Phố cổ Hội An, Quảng Nam', lat: 15.8801, lng: 108.3380, region: 'Miền Trung' },
      { keywords: ['nha trang', 'nhatrang', 'khánh hòa', 'cam ranh'], name: 'TP. Nha Trang, Khánh Hòa', lat: 12.2388, lng: 109.1967, region: 'Miền Trung' },
      { keywords: ['quy nhơn', 'quynhon', 'bình định'], name: 'TP. Quy Nhơn, Bình Định', lat: 13.7820, lng: 109.2197, region: 'Miền Trung' },
      { keywords: ['đà lạt', 'dalat', 'lâm đồng', 'bảo lộc'], name: 'TP. Đà Lạt, Lâm Đồng', lat: 11.9404, lng: 108.4583, region: 'Tây Nguyên' },
      { keywords: ['hồ chí minh', 'tphcm', 'sài gòn', 'quận 1', 'quận 3', 'quận 7', 'bến nghệ', 'bến thành'], name: 'Quận 1, TP. Hồ Chí Minh', lat: 10.7769, lng: 106.7009, region: 'Miền Nam' },
      { keywords: ['thủ đức', 'thuduc', 'linh chiểu', 'quận 9', 'quận 2'], name: 'TP. Thủ Đức, TP.HCM', lat: 10.8504, lng: 106.7719, region: 'Miền Nam' },
      { keywords: ['tân bình', 'tanbinh', 'sân bay tân sơn nhất', 'cộng hòa'], name: 'Tân Bình, TP. Hồ Chí Minh', lat: 10.8000, lng: 106.6500, region: 'Miền Nam' },
      { keywords: ['bình dương', 'thủ dầu một', 'thuận an', 'dĩ an'], name: 'TP. Thủ Dầu Một, Bình Dương', lat: 10.9804, lng: 106.6519, region: 'Miền Nam' },
      { keywords: ['đồng nai', 'biên hòa', 'long thành'], name: 'TP. Biên Hòa, Đồng Nai', lat: 10.9574, lng: 106.8427, region: 'Miền Nam' },
      { keywords: ['vũng tàu', 'vungtau', 'bà rịa'], name: 'TP. Vũng Tàu, Bà Rịa - Vũng Tàu', lat: 10.3460, lng: 107.0843, region: 'Miền Nam' },
      { keywords: ['cần thơ', 'cantho', 'ninh kiều', 'cái răng'], name: 'Ninh Kiều, TP. Cần Thơ', lat: 10.0452, lng: 105.7469, region: 'Miền Nam' },
      { keywords: ['phú quốc', 'phuquoc', 'kiên giang', 'dương đông', 'an thới'], name: 'TP. Phú Quốc, Kiên Giang', lat: 10.2289, lng: 103.9572, region: 'Miền Nam' },
      { keywords: ['cà mau', 'camau', 'đất mũi'], name: 'TP. Cà Mau (Đất Mũi)', lat: 9.1769, lng: 105.1500, region: 'Miền Nam' }
    ];

    function openGeoConfirmModal(initialAddress, initialLat, initialLng, callback) {
      geoConfirmTargetCallback = callback;
      const modal = document.getElementById('geo-confirm-modal');
      const input = document.getElementById('geo-confirm-input-address');

      const startAddress = initialAddress || '12 Lê Lợi, Bến Nghé, Quận 1, TP.HCM';
      input.value = startAddress;

      let startLat = initialLat || 10.7769;
      let startLng = initialLng || 106.7009;

      // Try fuzzy matching address against local VN geocoding database if lat/lng are default
      if (!initialLat || (initialLat === 10.7769 && initialAddress)) {
        const lower = startAddress.toLowerCase();
        const matched = VIETNAM_GEO_DB.find(item => item.keywords.some(k => lower.includes(k)));
        if (matched) {
          startLat = matched.lat;
          startLng = matched.lng;
        }
      }

      geoConfirmCurrentCoords = { lat: startLat, lng: startLng };

      modal.classList.remove('hidden');
      modal.style.display = 'flex';

      const triggerMapRender = () => {
        initOrUpdateGeoConfirmMap(startLat, startLng, startAddress);
        if (geoConfirmMap) {
          geoConfirmMap.invalidateSize();
          geoConfirmMap.setView([startLat, startLng], 14);
        }
      };

      setTimeout(triggerMapRender, 50);
      setTimeout(triggerMapRender, 200);
      setTimeout(triggerMapRender, 450);
      setTimeout(triggerMapRender, 750);
      safeRenderIcons();
    }

    function closeGeoConfirmModal() {
      const modal = document.getElementById('geo-confirm-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.style.display = 'none';
      }
    }

    function initOrUpdateGeoConfirmMap(lat, lng, label) {
      const container = document.getElementById('geo-confirm-leaflet-map');
      if (!container || typeof L === 'undefined') return;

      if (!geoConfirmMap) {
        geoConfirmMap = L.map('geo-confirm-leaflet-map', {
          zoomControl: true,
          attributionControl: false
        }).setView([lat, lng], 14);

        // CartoDB Voyager with multi-CDN fallback
        addStandardTileLayers(geoConfirmMap);

        // Click anywhere on map to reposition pin
        geoConfirmMap.on('click', (e) => {
          updateGeoConfirmPin(e.latlng.lat, e.latlng.lng, 'Vị trí đã chọn thủ công trên bản đồ');
        });
      } else {
        geoConfirmMap.invalidateSize();
        geoConfirmMap.setView([lat, lng], 14);
      }

      // Create or update draggable custom gold pin
      const goldIcon = L.divIcon({
        className: 'custom-confirm-pin',
        html: `<div style="background-color:#C5A059; width:26px; height:26px; border-radius:50%; border:3px solid #FFFFFF; box-shadow:0 4px 10px rgba(0,0,0,0.35); display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-weight:bold; font-size:12px; cursor:grab;">📍</div>`,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      if (geoConfirmMarker) {
        geoConfirmMarker.setLatLng([lat, lng]);
      } else {
        geoConfirmMarker = L.marker([lat, lng], { icon: goldIcon, draggable: true }).addTo(geoConfirmMap);

        geoConfirmMarker.on('dragend', () => {
          const pos = geoConfirmMarker.getLatLng();
          updateGeoConfirmPin(pos.lat, pos.lng, 'Vị trí đã kéo thả ghim chính xác');
        });
      }

      updateGeoConfirmDisplay(lat, lng, label);
    }

    function updateGeoConfirmPin(lat, lng, note) {
      geoConfirmCurrentCoords = { lat: Number(lat), lng: Number(lng) };
      if (geoConfirmMarker) geoConfirmMarker.setLatLng([lat, lng]);
      if (geoConfirmMap) geoConfirmMap.panTo([lat, lng]);
      updateGeoConfirmDisplay(lat, lng, note);
    }

    function updateGeoConfirmDisplay(lat, lng, addressText) {
      const latEl = document.getElementById('geo-confirm-lat');
      const lngEl = document.getElementById('geo-confirm-lng');
      const addrEl = document.getElementById('geo-confirm-resolved-address');
      const inputEl = document.getElementById('geo-confirm-input-address');

      if (latEl) latEl.innerText = Number(lat).toFixed(6);
      if (lngEl) lngEl.innerText = Number(lng).toFixed(6);
      if (addrEl && addressText) addrEl.innerText = addressText;
      if (inputEl && addressText && !inputEl.value) inputEl.value = addressText;
    }

    function quickPinLocation(lat, lng, address) {
      const input = document.getElementById('geo-confirm-input-address');
      if (input) input.value = address;
      updateGeoConfirmPin(lat, lng, address);
      if (geoConfirmMap) geoConfirmMap.flyTo([lat, lng], 15, { duration: 1 });
    }

    async function geocodeFromModalInput() {
      const query = (document.getElementById('geo-confirm-input-address')?.value || '').trim();
      if (!query) {
        alert('Vui lòng nhập địa chỉ cần tìm kiếm!');
        return;
      }

      const lower = query.toLowerCase();
      // 1. Check local VN Geocoding Database first
      const localMatch = VIETNAM_GEO_DB.find(item => item.keywords.some(k => lower.includes(k)));
      if (localMatch) {
        updateGeoConfirmPin(localMatch.lat, localMatch.lng, `${query} (${localMatch.name})`);
        if (geoConfirmMap) geoConfirmMap.flyTo([localMatch.lat, localMatch.lng], 15, { duration: 1 });
        return;
      }

      // 2. Try OpenStreetMap Nominatim Live API
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query + ', Vietnam')}&limit=1`, {
          signal: AbortSignal.timeout(3000)
        });
        const data = await res.json();
        if (data && data.length > 0) {
          const lat = parseFloat(data[0].lat);
          const lng = parseFloat(data[0].lon);
          updateGeoConfirmPin(lat, lng, data[0].display_name);
          if (geoConfirmMap) geoConfirmMap.flyTo([lat, lng], 15, { duration: 1.2 });
          return;
        }
      } catch (e) {
        console.warn('Nominatim live lookup failed, fallback to HCMC center:', e);
      }

      // Fallback: Default to center Vietnam if not found
      updateGeoConfirmPin(16.0544, 108.2022, query + ' (Đã ghim vị trí trung tâm)');
      alert(`Đã định vị khu vực cho: "${query}". Hãy kéo ghim màu vàng hoặc nhấp chuột vào vị trí chính xác trên bản đồ để xác nhận.`);
    }

    function applyConfirmedCoordinates() {
      const inputAddr = document.getElementById('geo-confirm-input-address')?.value || '';
      const resolved = document.getElementById('geo-confirm-resolved-address')?.innerText || inputAddr;
      const coords = { ...geoConfirmCurrentCoords, address: inputAddr || resolved };

      if (typeof geoConfirmTargetCallback === 'function') {
        geoConfirmTargetCallback(coords);
      }
      closeGeoConfirmModal();
      playBeep('success');
      showRealtimeNotification('Định Vị Thành Công', `Đã xác nhận tọa độ: [${coords.lat.toFixed(5)}, ${coords.lng.toFixed(5)}]`, 'success');
    }

    // Connect Branch Form to Geo Confirmation Modal
    function verifyBranchAddressGps() {
      const address = (document.getElementById('new-branch-address')?.value || '').trim();
      openGeoConfirmModal(address, 10.7769, 106.7009, (coords) => {
        document.getElementById('new-branch-lat').value = coords.lat;
        document.getElementById('new-branch-lng').value = coords.lng;
        if (coords.address) document.getElementById('new-branch-address').value = coords.address;

        const badge = document.getElementById('new-branch-gps-badge');
        if (badge) {
          badge.className = 'flex items-center space-x-1.5 text-[11px] text-emerald-800 bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-1 rounded-lg font-bold';
          badge.innerHTML = `<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i><span>✓ Đã xác nhận định vị: [${coords.lat.toFixed(4)}, ${coords.lng.toFixed(4)}]</span>`;
          safeRenderIcons();
        }
      });
    }

    // Connect Map Search Bar to Geo Confirmation Modal
    function searchAndConfirmMapAddress() {
      const addr = (document.getElementById('map-search-address-input')?.value || '').trim();
      if (!addr) {
        alert('Vui lòng nhập địa chỉ cần tìm kiếm và định vị!');
        return;
      }
      openGeoConfirmModal(addr, 10.7769, 106.7009, (coords) => {
        if (leafletMap) {
          leafletMap.flyTo([coords.lat, coords.lng], 15, { duration: 1.5 });

          const customPin = L.divIcon({
            className: 'custom-user-confirmed-pin',
            html: `<div style="background-color:#A47F35; width:28px; height:28px; border-radius:50%; border:3px solid #FFF; box-shadow:0 4px 10px rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; color:#FFF; font-weight:bold; font-size:13px;">📍</div>`,
            iconSize: [28, 28],
            iconAnchor: [14, 14]
          });

          const m = L.marker([coords.lat, coords.lng], { icon: customPin }).addTo(leafletMap);
          m.bindPopup(`<strong>Địa Điểm Đã Xác Thực Định Vị:</strong><br>${coords.address}<br><span style="color:#C5A059; font-weight:bold;">[${coords.lat.toFixed(5)}, ${coords.lng.toFixed(5)}]</span>`).openPopup();
        }
      });
    }

    // Regional Flying Camera Controls
    function flyToRegion(region) {
      if (!leafletMap) return;
      if (region === 'all') {
        leafletMap.flyTo([16.0544, 108.2022], 6, { duration: 1.5 });
      } else if (region === 'north') {
        leafletMap.flyTo([21.0285, 105.8542], 8, { duration: 1.2 });
      } else if (region === 'central') {
        leafletMap.flyTo([16.0544, 108.2022], 8, { duration: 1.2 });
      } else if (region === 'highlands') {
        leafletMap.flyTo([11.9404, 108.4583], 8, { duration: 1.2 });
      } else if (region === 'south') {
        leafletMap.flyTo([10.7769, 106.7009], 8, { duration: 1.2 });
      }
    }

    // Nationwide Journey Simulation (Bắc ➔ Nam: Sa Pa/Hà Nội ➔ Đà Nẵng ➔ TP.HCM ➔ Cần Thơ ➔ Phú Quốc)
    let nationwideTourTimer = null;
    function startNationwideTour() {
      if (!leafletMap) return;
      if (nationwideTourTimer) {
        clearInterval(nationwideTourTimer);
        nationwideTourTimer = null;
      }

      const tourStops = [
        { name: 'Hub Tây Bắc (Sa Pa)', lat: 22.3364, lng: 103.8438, desc: 'Điểm khởi hành Tây Bắc' },
        { name: 'Kho Tổng Miền Bắc (Hà Nội)', lat: 21.0285, lng: 105.8542, desc: 'Trung tâm phân phối lớn nhất Miền Bắc' },
        { name: 'Cảng Đình Vũ (Hải Phòng)', lat: 20.8449, lng: 106.6881, desc: 'Hub Logistics cảng biển quốc tế' },
        { name: 'Chi nhánh Cố Đô (Huế)', lat: 16.4637, lng: 107.5909, desc: 'Hub trung chuyển Bắc Trung Bộ' },
        { name: 'Hub Miền Trung (Đà Nẵng)', lat: 16.0544, lng: 108.2022, desc: 'Tổng kho trung chuyển Bắc - Nam' },
        { name: 'Chi nhánh Duyên Hải (Nha Trang)', lat: 12.2388, lng: 109.1967, desc: 'Kho hàng Duyên hải Nam Trung Bộ' },
        { name: 'Kho Cao Nguyên (Đà Lạt)', lat: 11.9404, lng: 108.4583, desc: 'Hub Nông sản & Thực phẩm Tây Nguyên' },
        { name: 'Kho Tổng TP. Hồ Chí Minh (Q.1)', lat: 10.7769, lng: 106.7009, desc: 'Đại đô thị kinh tế lớn nhất Miền Nam' },
        { name: 'Hub Tây Nam Bộ (Cần Thơ)', lat: 10.0452, lng: 105.7469, desc: 'Trung tâm chuỗi cung ứng Đồng bằng Sông Cửu Long' },
        { name: 'Chi nhánh Đảo Ngọc (Phú Quốc)', lat: 10.2289, lng: 103.9572, desc: 'Điểm kết thúc hành trình Nam Cực' }
      ];

      // Draw Nationwide Polyline corridor
      if (deliveryLayer) {
        deliveryLayer.clearLayers();
        const routeLatLngs = tourStops.map(s => [s.lat, s.lng]);
        L.polyline(routeLatLngs, {
          color: '#C5A059',
          weight: 4,
          dashArray: '8, 8',
          opacity: 0.9
        }).addTo(deliveryLayer);
      }

      leafletMap.setView([tourStops[0].lat, tourStops[0].lng], 8);

      let stopIndex = 0;
      const truckIcon = L.divIcon({
        className: 'nationwide-truck-icon',
        html: `<div style="background-color:#1A1A1A; width:34px; height:34px; border-radius:50%; border:3px solid #C5A059; box-shadow:0 6px 16px rgba(197,160,89,0.5); display:flex; align-items:center; justify-content:center; color:#FFF; font-size:16px;">🚚</div>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17]
      });

      let tourMarker = L.marker([tourStops[0].lat, tourStops[0].lng], { icon: truckIcon }).addTo(deliveryLayer);
      tourMarker.bindPopup(`<strong>Đang ghé thăm:</strong> ${tourStops[0].name}<br>${tourStops[0].desc}`).openPopup();

      showRealtimeNotification('Hành Trình Xuyên Việt', `Bắt đầu xuất phát từ: ${tourStops[0].name}`, 'info');

      nationwideTourTimer = setInterval(() => {
        stopIndex++;
        if (stopIndex >= tourStops.length) {
          clearInterval(nationwideTourTimer);
          nationwideTourTimer = null;
          tourMarker.bindPopup(`<strong>🏆 Hoàn Tất Hành Trình Xuyên Việt!</strong><br>Đã đi qua 10 tỉnh thành từ Bắc vào Nam.`).openPopup();
          showRealtimeNotification('Hoàn Thành Xuyên Việt', 'Xe tải đã hoàn thành trọn vẹn lộ trình Bắc - Nam!', 'success');
          return;
        }

        const curr = tourStops[stopIndex];
        tourMarker.setLatLng([curr.lat, curr.lng]);
        tourMarker.bindPopup(`<strong>Đang di chuyển: Trạm ${stopIndex + 1}/${tourStops.length}</strong><br><strong>${curr.name}</strong><br>${curr.desc}`).openPopup();
        leafletMap.panTo([curr.lat, curr.lng]);
        playBeep('click');
      }, 3500);
    }



    /* =============================================================
       MODULE 9: INLINE MAP, CLICK-TO-PIN & DATABASE PERSISTENCE
       ============================================================= */
    let branchInlineMap = null;
    let branchInlineMarker = null;
    let isMapPinningModeActive = false;
    let mapPinningMarker = null;

    // In-memory + LocalStorage pins backup
    DB.pins = JSON.parse(localStorage.getItem('oism_custom_pins') || '[]');

    function initBranchInlineMap() {
      const container = document.getElementById('branch-inline-map');
      if (!container || typeof L === 'undefined') return;

      const defaultLat = 10.7769;
      const defaultLng = 106.7009;

      if (!branchInlineMap) {
        branchInlineMap = L.map('branch-inline-map', {
          zoomControl: true,
          attributionControl: false
        }).setView([defaultLat, defaultLng], 13);

        addStandardTileLayers(branchInlineMap);

        const goldIcon = L.divIcon({
          className: 'custom-inline-pin',
          html: `<div style="background-color:#C5A059; width:26px; height:26px; border-radius:50%; border:3px solid #FFF; box-shadow:0 3px 8px rgba(0,0,0,0.35); display:flex; align-items:center; justify-content:center; color:#FFF; font-size:12px; cursor:grab;">📍</div>`,
          iconSize: [26, 26],
          iconAnchor: [13, 13]
        });

        branchInlineMarker = L.marker([defaultLat, defaultLng], { icon: goldIcon, draggable: true }).addTo(branchInlineMap);

        branchInlineMarker.on('dragend', () => {
          const pos = branchInlineMarker.getLatLng();
          onBranchInlinePositionChanged(pos.lat, pos.lng);
        });

        branchInlineMap.on('click', (e) => {
          branchInlineMarker.setLatLng(e.latlng);
          onBranchInlinePositionChanged(e.latlng.lat, e.latlng.lng);
        });
      }

      setTimeout(() => {
        if (branchInlineMap) {
          branchInlineMap.invalidateSize();
          if (typeof updateBranchServiceRadiusCircle === 'function') updateBranchServiceRadiusCircle();
        }
      }, 200);
      setTimeout(() => { if (branchInlineMap) branchInlineMap.invalidateSize(); }, 500);
    }

    function onBranchInlinePositionChanged(lat, lng) {
      document.getElementById('new-branch-lat').value = Number(lat).toFixed(6);
      document.getElementById('new-branch-lng').value = Number(lng).toFixed(6);

      const badge = document.getElementById('new-branch-gps-badge');
      if (badge) {
        badge.className = 'flex items-center space-x-1.5 text-[11px] text-emerald-800 bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-1 rounded-lg font-bold';
        badge.innerHTML = `<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i><span>✓ Đã ghim vị trí chuẩn: [${Number(lat).toFixed(4)}, ${Number(lng).toFixed(4)}]</span>`;
        safeRenderIcons();
      }
      if (typeof updateBranchServiceRadiusCircle === 'function') {
        updateBranchServiceRadiusCircle();
      }
      playBeep('click');
    }

    // Enhance switchMapMode to support 'pinning'
    const origSwitchMapMode = typeof switchMapMode === 'function' ? switchMapMode : null;
    function switchMapMode(mode) {
      currentMapMode = mode;
      const btnW = document.getElementById('btn-map-mode-warehouses');
      const btnD = document.getElementById('btn-map-mode-delivery');
      const btnP = document.getElementById('btn-map-mode-pinning');
      const pW = document.getElementById('panel-map-warehouses');
      const pD = document.getElementById('panel-map-delivery');
      const pP = document.getElementById('panel-map-pinning');

      [btnW, btnD, btnP].forEach(b => {
        if (b) {
          b.className = 'py-2 rounded-lg text-[#544E40] hover:text-[#1A1A1A] flex items-center justify-center space-x-1 transition';
        }
      });
      [pW, pD, pP].forEach(p => { if (p) p.classList.add('hidden'); });

      if (mode === 'warehouses') {
        if (btnW) btnW.className = 'py-2 rounded-lg bg-[#C5A059] text-white flex items-center justify-center space-x-1 transition shadow-sm';
        if (pW) pW.classList.remove('hidden');
        renderWarehouseMarkers();
        isMapPinningModeActive = false;
        if (leafletMap) leafletMap.getContainer().style.cursor = '';
      } else if (mode === 'delivery') {
        if (btnD) btnD.className = 'py-2 rounded-lg bg-[#C5A059] text-white flex items-center justify-center space-x-1 transition shadow-sm';
        if (pD) pD.classList.remove('hidden');
        selectOrderForTracking();
        isMapPinningModeActive = false;
        if (leafletMap) leafletMap.getContainer().style.cursor = '';
      } else if (mode === 'pinning') {
        if (btnP) btnP.className = 'py-2 rounded-lg bg-[#C5A059] text-white flex items-center justify-center space-x-1 transition shadow-sm';
        if (pP) pP.classList.remove('hidden');
        isMapPinningModeActive = true;
        if (leafletMap) {
          leafletMap.getContainer().style.cursor = 'crosshair';
          leafletMap.invalidateSize();
        }
        renderSavedPinsList();
        renderAllSavedPinsOnMap();
        showRealtimeNotification('Chế Độ Ghim CSDL', 'Nhấp chuột vào bất kỳ đâu trên bản đồ để ghim địa điểm và lưu vào CSDL!', 'info');
      }
      safeRenderIcons();
    }

    // Handle Click on Nationwide Map in Pinning Mode
    function setupNationwideMapPinningListener() {
      if (!leafletMap) return;
      leafletMap.on('click', (e) => {
        if (!isMapPinningModeActive) return;
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        const pinIcon = L.divIcon({
          className: 'custom-new-pin',
          html: `<div style="background-color:#E11D48; width:30px; height:30px; border-radius:50%; border:3px solid #FFF; box-shadow:0 4px 12px rgba(225,29,72,0.45); display:flex; align-items:center; justify-content:center; color:#FFF; font-size:14px; animation:bounce 1s infinite;">📍</div>`,
          iconSize: [30, 30],
          iconAnchor: [15, 15]
        });

        if (mapPinningMarker) {
          mapPinningMarker.setLatLng([lat, lng]);
        } else {
          mapPinningMarker = L.marker([lat, lng], { icon: pinIcon }).addTo(leafletMap);
        }

        const popupContent = `
          <div class="font-sans text-xs p-1 space-y-2 min-w-[240px]">
            <div class="font-bold text-sm text-[#1A1A1A] flex items-center space-x-1">
              <span>📍 Ghim Điểm Mới Vào CSDL</span>
            </div>
            <div>
              <label class="block text-[11px] text-gray-500 mb-0.5">Tên địa điểm / Chi nhánh:</label>
              <input type="text" id="pin-popup-title" placeholder="VD: Kho hàng Đông Nam..." class="w-full px-2 py-1 text-xs border border-gray-300 rounded bg-white font-medium">
            </div>
            <div>
              <label class="block text-[11px] text-gray-500 mb-0.5">Địa chỉ mô tả:</label>
              <input type="text" id="pin-popup-address" placeholder="VD: Quốc lộ 1A..." class="w-full px-2 py-1 text-xs border border-gray-300 rounded bg-white">
            </div>
            <div class="p-1.5 bg-gray-50 rounded border border-gray-200 text-[10px] font-mono">
              Tọa độ GPS: <strong>${lat.toFixed(6)}, ${lng.toFixed(6)}</strong>
            </div>
            <button onclick="savePinFromPopup(${lat}, ${lng})" style="background-color:#C5A059; color:#FFF;" class="w-full py-1.5 rounded font-bold text-xs shadow hover:opacity-90 flex items-center justify-center space-x-1">
              <span>💾 Lưu Vào CSDL SQL Server</span>
            </button>
          </div>
        `;

        mapPinningMarker.bindPopup(popupContent).openPopup();
        playBeep('click');
      });
    }

    async function savePinFromPopup(lat, lng) {
      const title = (document.getElementById('pin-popup-title')?.value || '').trim();
      const address = (document.getElementById('pin-popup-address')?.value || '').trim();

      if (!title) {
        alert('Vui lòng nhập tên địa điểm!');
        return;
      }

      const newPin = {
        PinId: DB.pins.length + 1,
        TenantId: DB.currentTenantId,
        Title: title,
        Address: address || 'Tọa độ ghim tự do trên bản đồ',
        Category: 'Điểm ghim bản đồ',
        Latitude: parseFloat(lat),
        Longitude: parseFloat(lng),
        CreatedAt: new Date().toISOString()
      };

      // 1. Save to In-Memory & LocalStorage
      DB.pins.unshift(newPin);
      try {
        localStorage.setItem('oism_custom_pins', JSON.stringify(DB.pins));
      } catch (e) { }

      // 2. If Live API is connected, save directly into SQL Server 2022
      if (isLiveApi) {
        try {
          await fetch(`${API_BASE}/pins`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newPin)
          });
        } catch (e) {
          console.warn('Không thể gửi tới backend API, đã lưu vào LocalStorage:', e);
        }
      }

      // Log SQL Server Spatial insertion
      logSql(
        `-- LƯU TỌA ĐỘ GHIM GPS VÀO BẢNG dbo.GeoPins (SQL SERVER SPATIAL 2022)`,
        `INSERT INTO dbo.GeoPins (TenantId, Title, Address, Latitude, Longitude, GeoLocation)
VALUES (${DB.currentTenantId}, N'${title}', N'${address}', ${lat.toFixed(6)}, ${lng.toFixed(6)}, geography::Point(${lat.toFixed(6)}, ${lng.toFixed(6)}, 4326);`
      );

      if (mapPinningMarker) {
        mapPinningMarker.closePopup();
      }

      playBeep('success');
      showRealtimeNotification('Đã Lưu Vào CSDL', `Địa điểm "${title}" đã được lưu trữ vĩnh viễn vào CSDL SQL Server!`, 'success');

      renderSavedPinsList();
      renderAllSavedPinsOnMap();
    }

    function renderSavedPinsList() {
      const container = document.getElementById('saved-pins-list-container');
      const countEl = document.getElementById('saved-pins-count');
      if (!container) return;

      const tenantPins = DB.pins.filter(p => p.TenantId === DB.currentTenantId);
      if (countEl) countEl.innerText = tenantPins.length;

      if (tenantPins.length === 0) {
        container.innerHTML = `
          <div class="p-3 text-center text-[#7D7563] bg-[#EAE7DD] rounded-lg text-[11px]">
            Chưa có điểm ghim nào. Nhấp chuột vào bản đồ để thả ghim đầu tiên!
          </div>
        `;
        return;
      }

      container.innerHTML = tenantPins.map(p => `
        <div class="p-2.5 bg-white rounded-lg border border-[#D6D0C0] shadow-sm flex items-center justify-between space-x-2">
          <div class="truncate flex-1">
            <div class="font-bold text-[#1A1A1A] truncate">${p.Title}</div>
            <div class="text-[10px] text-[#544E40] truncate">${p.Address}</div>
            <div class="text-[9px] font-mono text-[#A47F35]">[${Number(p.Latitude).toFixed(4)}, ${Number(p.Longitude).toFixed(4)}]</div>
          </div>
          <div class="flex items-center space-x-1 shrink-0">
            <button onclick="flyToSavedPin(${p.Latitude}, ${p.Longitude})" class="p-1 rounded bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white transition" title="Bay tới điểm này">
              <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
            </button>
            <button onclick="deleteSavedPin(${p.PinId})" class="p-1 rounded bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-600 transition" title="Xóa khỏi CSDL">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      `).join('');
      safeRenderIcons();
    }

    let savedPinsLayerGroup = null;
    function renderAllSavedPinsOnMap() {
      if (!leafletMap) return;
      if (!savedPinsLayerGroup) {
        savedPinsLayerGroup = L.layerGroup().addTo(leafletMap);
      }
      savedPinsLayerGroup.clearLayers();

      const tenantPins = DB.pins.filter(p => p.TenantId === DB.currentTenantId);
      tenantPins.forEach(p => {
        const pinIcon = L.divIcon({
          className: 'custom-saved-pin',
          html: `<div style="background-color:#A47F35; width:28px; height:28px; border-radius:50%; border:2.5px solid #FFF; box-shadow:0 3px 8px rgba(0,0,0,0.3); display:flex; align-items:center; justify-content:center; color:#FFF; font-size:12px;">📌</div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });

        const m = L.marker([p.Latitude, p.Longitude], { icon: pinIcon }).addTo(savedPinsLayerGroup);
        m.bindPopup(`
          <div class="font-sans text-xs p-1">
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-[#FAF5E8] text-[#8C7037] font-bold border border-[#E5D3AD]">Điểm Ghim CSDL</span>
            <h4 class="font-bold text-sm text-[#1A1A1A] mt-1">${p.Title}</h4>
            <p class="text-[#544E40] text-[11px] mb-1.5">${p.Address}</p>
            <div class="font-mono text-[10px] text-[#A47F35]">Tọa độ: [${Number(p.Latitude).toFixed(6)}, ${Number(p.Longitude).toFixed(6)}]</div>
          </div>
        `);
      });
    }

    function flyToSavedPin(lat, lng) {
      if (leafletMap) {
        leafletMap.flyTo([lat, lng], 15, { duration: 1.2 });
      }
    }

    async function deleteSavedPin(pinId) {
      if (!confirm('Bạn có chắc chắn muốn xóa điểm ghim này khỏi cơ sở dữ liệu?')) return;
      DB.pins = DB.pins.filter(p => p.PinId !== pinId);
      try {
        localStorage.setItem('oism_custom_pins', JSON.stringify(DB.pins));
      } catch (e) { }

      if (isLiveApi) {
        try {
          await fetch(`${API_BASE}/pins/${pinId}?tenantId=${DB.currentTenantId}`, { method: 'DELETE' });
        } catch (e) { }
      }

      renderSavedPinsList();
      renderAllSavedPinsOnMap();
      showRealtimeNotification('Đã Xóa', 'Đã xóa điểm ghim khỏi cơ sở dữ liệu.', 'info');
    }

    async function refreshSavedPinsFromDb() {
      if (isLiveApi) {
        try {
          const res = await fetch(`${API_BASE}/pins?tenantId=${DB.currentTenantId}`);
          const data = await res.json();
          if (Array.isArray(data)) {
            DB.pins = data;
            localStorage.setItem('oism_custom_pins', JSON.stringify(data));
          }
        } catch (e) { }
      }
      renderSavedPinsList();
      renderAllSavedPinsOnMap();
      showRealtimeNotification('Đồng Bộ CSDL', 'Đã tải lại toàn bộ danh sách điểm ghim từ CSDL!', 'success');
    }



    /* =============================================================
       MODULE 10: CASCADING ADMINISTRATIVE DROPDOWNS & SERVICE RADIUS
       ============================================================= */
    const VN_ADMIN_DATA = { "TP. Hồ Chí Minh": { "lat": 10.7769, "lng": 106.7009, "zoom": 12, "districts": { "Quận 1": { "lat": 10.7769, "lng": 106.7009, "zoom": 14, "wards": ["Bến Nghé", "Bến Thành", "Đa Kao", "Tân Định", "Phạm Ngũ Lão", "Nguyễn Cư Trinh", "Cầu Kho", "Cầu Ông Lãnh", "Cô Giang", "Nguyễn Thái Bình"] }, "TP. Thủ Đức": { "lat": 10.8504, "lng": 106.7719, "zoom": 13, "wards": ["Linh Chiểu", "Hiệp Bình Chánh", "Hiệp Bình Phước", "Linh Trung", "Tam Bình", "Tam Phú", "Thảo Điền", "An Phú", "An Khánh", "Tăng Nhơn Phú A"] }, "Quận 3": { "lat": 10.7844, "lng": 106.6844, "zoom": 14, "wards": ["Võ Thị Sáu", "Phường 1", "Phường 2", "Phường 3", "Phường 4", "Phường 5", "Phường 9", "Phường 11", "Phường 12", "Phường 14"] }, "Quận Tân Bình": { "lat": 10.8, "lng": 106.65, "zoom": 14, "wards": ["Phường 1", "Phường 2", "Phường 4", "Phường 6", "Phường 8", "Phường 10", "Phường 12", "Phường 13", "Phường 14", "Phường 15"] }, "Quận 7": { "lat": 10.734, "lng": 106.7218, "zoom": 14, "wards": ["Tân Phong (Phú Mỹ Hưng)", "Tân Phú", "Tân Quy", "Tân Kiểng", "Bình Thuận", "Phú Mỹ", "Phú Thuận"] }, "Quận Bình Thạnh": { "lat": 10.8106, "lng": 106.7091, "zoom": 14, "wards": ["Phường 1", "Phường 2", "Phường 12", "Phường 14", "Phường 19", "Phường 21", "Phường 25", "Phường 26"] } } }, "Hà Nội": { "lat": 21.0285, "lng": 105.8542, "zoom": 12, "districts": { "Quận Hoàn Kiếm": { "lat": 21.0285, "lng": 105.8542, "zoom": 14, "wards": ["Tràng Tiền", "Hàng Bạc", "Hàng Đào", "Hàng Gai", "Hàng Trống", "Cửa Đông", "Cửa Nam", "Lý Thái Tổ", "Phan Chu Trinh", "Đồng Xuân"] }, "Quận Cầu Giấy": { "lat": 21.0362, "lng": 105.7906, "zoom": 14, "wards": ["Dịch Vọng", "Dịch Vọng Hậu", "Mai Dịch", "Nghĩa Đô", "Nghĩa Tân", "Quan Hoa", "Trung Hòa", "Yên Hòa"] }, "Quận Đống Đa": { "lat": 21.0181, "lng": 105.8299, "zoom": 14, "wards": ["Cát Linh", "Hàng Bột", "Khâm Thiên", "Láng Hạ", "Láng Thượng", "Ô Chợ Dừa", "Quốc Tử Giám", "Văn Miếu", "Kim Liên"] }, "Quận Ba Đình": { "lat": 21.0341, "lng": 105.8244, "zoom": 14, "wards": ["Điện Biên", "Đội Cấn", "Giảng Võ", "Kim Mã", "Liễu Giai", "Ngọc Hà", "Quán Thánh", "Thành Công"] }, "Quận Long Biên": { "lat": 21.045, "lng": 105.895, "zoom": 13, "wards": ["Bồ Đề", "Gia Thụy", "Giang Biên", "Long Biên", "Ngọc Lâm", "Ngọc Thụy", "Phúc Đồng", "Sài Đồng"] } } }, "Đà Nẵng": { "lat": 16.0544, "lng": 108.2022, "zoom": 12, "districts": { "Quận Hải Châu": { "lat": 16.0544, "lng": 108.2022, "zoom": 14, "wards": ["Hải Châu 1", "Hải Châu 2", "Thạch Thang", "Thanh Bình", "Thuận Phước", "Hòa Cường Bắc", "Hòa Cường Nam", "Phước Ninh", "Bình Thuận"] }, "Quận Sơn Trà": { "lat": 16.0886, "lng": 108.2435, "zoom": 13, "wards": ["An Hải Bắc", "An Hải Tây", "Mân Thái", "Nại Hiên Đông", "Phước Mỹ", "Thọ Quang"] }, "Quận Thanh Khê": { "lat": 16.0617, "lng": 108.1874, "zoom": 14, "wards": ["Tam Thuận", "Thanh Khê Đông", "Thanh Khê Tây", "Xuân Hà", "Tân Chính", "Chính Gián", "Vĩnh Trung", "Thạc Gián"] } } }, "Hải Phòng": { "lat": 20.8449, "lng": 106.6881, "zoom": 12, "districts": { "Quận Hồng Bàng": { "lat": 20.865, "lng": 106.675, "zoom": 14, "wards": ["Hoàng Văn Thụ", "Minh Khai", "Phan Bội Châu", "Quán Toan", "Sở Dầu", "Thượng Lý"] }, "Quận Hải An": { "lat": 20.84, "lng": 106.72, "zoom": 13, "wards": ["Đông Hải 1", "Đông Hải 2 (Cảng Đình Vũ)", "Đằng Lâm", "Đằng Hải", "Nam Hải", "Tràng Cát"] } } }, "Cần Thơ": { "lat": 10.0452, "lng": 105.7469, "zoom": 12, "districts": { "Quận Ninh Kiều": { "lat": 10.0452, "lng": 105.7469, "zoom": 14, "wards": ["Tân An", "An Cư", "An Hòa", "An Khánh", "An Nghiệp", "An Phú", "Cái Khế", "Hưng Lợi", "Thới Bình", "Xuân Khánh"] }, "Quận Cái Răng": { "lat": 10.005, "lng": 105.75, "zoom": 13, "wards": ["Lê Bình", "Hưng Phú", "Hưng Thạnh", "Ba Láng", "Phú Thứ", "Tân Phú"] } } }, "Lâm Đồng": { "lat": 11.9404, "lng": 108.4583, "zoom": 12, "districts": { "TP. Đà Lạt": { "lat": 11.9404, "lng": 108.4583, "zoom": 14, "wards": ["Phường 1 (Hồ Xuân Hương)", "Phường 2", "Phường 3", "Phường 4", "Phường 5", "Phường 6", "Phường 7", "Phường 8", "Phường 9", "Phường 10"] }, "TP. Bảo Lộc": { "lat": 11.545, "lng": 107.808, "zoom": 13, "wards": ["Phường 1", "Phường 2", "B'Lao", "Lộc Phát", "Lộc Tiến", "Lộc Sơn"] } } }, "Khánh Hòa": { "lat": 12.2388, "lng": 109.1967, "zoom": 12, "districts": { "TP. Nha Trang": { "lat": 12.2388, "lng": 109.1967, "zoom": 14, "wards": ["Lộc Thọ (Trần Phú)", "Phước Hải", "Phước Tiến", "Tân Lập", "Vạn Thạnh", "Vạn Thắng", "Vĩnh Hải", "Vĩnh Phước", "Vĩnh Nguyên"] } } }, "Kiên Giang": { "lat": 10.2289, "lng": 103.9572, "zoom": 12, "districts": { "TP. Phú Quốc": { "lat": 10.2289, "lng": 103.9572, "zoom": 13, "wards": ["Dương Đông", "An Thới", "Hàm Ninh", "Cửa Cạn", "Gành Dầu", "Bãi Thơm", "Dương Tơ"] } } }, "Lào Cai": { "lat": 22.3364, "lng": 103.8438, "zoom": 12, "districts": { "Thị xã Sa Pa": { "lat": 22.3364, "lng": 103.8438, "zoom": 14, "wards": ["Sa Pa (Cầu Mây)", "Sa Pả", "Phan Si Păng", "Hàm Rồng", "Ô Quý Hồ"] } } }, "Thừa Thiên Huế": { "lat": 16.4637, "lng": 107.5909, "zoom": 12, "districts": { "TP. Huế": { "lat": 16.4637, "lng": 107.5909, "zoom": 14, "wards": ["Phú Nhuận", "Phú Hội", "Vĩnh Ninh", "Thuận Hòa", "Thuận Lộc", "Hương Sơ", "Thủy Xuân"] } } } };

    let branchServiceCircle = null;

    function populateProvinceDropdowns() {
      const provSelect = document.getElementById('branch-select-province');
      const tableFilter = document.getElementById('branch-table-province-filter');
      if (!provSelect) return;

      const provinces = Object.keys(VN_ADMIN_DATA);
      provSelect.innerHTML = provinces.map(p => `<option value="${p}">${p}</option>`).join('');

      if (tableFilter) {
        tableFilter.innerHTML = `<option value="all">Tất cả Tỉnh / Thành phố (Toàn quốc)</option>` +
          provinces.map(p => `<option value="${p}">${p}</option>`).join('');
      }

      onProvinceChanged();
    }

    function onProvinceChanged() {
      const provSelect = document.getElementById('branch-select-province');
      const distSelect = document.getElementById('branch-select-district');
      if (!provSelect || !distSelect) return;

      const provName = provSelect.value;
      const provData = VN_ADMIN_DATA[provName];
      if (!provData) return;

      const districts = Object.keys(provData.districts);
      distSelect.innerHTML = districts.map(d => `<option value="${d}">${d}</option>`).join('');

      // Fly map to Province
      if (branchInlineMap) {
        branchInlineMap.flyTo([provData.lat, provData.lng], provData.zoom || 12, { duration: 1 });
      }

      onDistrictChanged();
    }

    function onDistrictChanged() {
      const provSelect = document.getElementById('branch-select-province');
      const distSelect = document.getElementById('branch-select-district');
      const wardSelect = document.getElementById('branch-select-ward');
      if (!provSelect || !distSelect || !wardSelect) return;

      const provName = provSelect.value;
      const distName = distSelect.value;
      const provData = VN_ADMIN_DATA[provName];
      if (!provData || !provData.districts[distName]) return;

      const distData = provData.districts[distName];
      wardSelect.innerHTML = distData.wards.map(w => `<option value="${w}">${w}</option>`).join('');

      // Move marker and fly map to District
      setBranchCoordinates(distData.lat, distData.lng, distData.zoom || 14);
      onWardChanged();
    }

    function onWardChanged() {
      synthesizeFullBranchAddress();
      updateBranchServiceRadiusCircle();
    }

    function onStreetInputChanged() {
      synthesizeFullBranchAddress();
    }

    function synthesizeFullBranchAddress() {
      const provSelect = document.getElementById('branch-select-province');
      const distSelect = document.getElementById('branch-select-district');
      const wardSelect = document.getElementById('branch-select-ward');
      const streetInput = document.getElementById('branch-input-street');
      const addrInput = document.getElementById('new-branch-address');

      const street = (streetInput?.value || '').trim();
      const ward = wardSelect?.value || '';
      const dist = distSelect?.value || '';
      const prov = provSelect?.value || '';

      const parts = [];
      if (street) parts.push(street);
      if (ward) parts.push(ward.startsWith('Phường') || ward.startsWith('Xã') || ward.startsWith('Thị xã') ? ward : 'Phường ' + ward);
      if (dist) parts.push(dist);
      if (prov) parts.push(prov);

      const full = parts.join(', ');
      if (addrInput) addrInput.value = full;
    }

    function setBranchCoordinates(lat, lng, zoom = 14) {
      const latEl = document.getElementById('new-branch-lat');
      const lngEl = document.getElementById('new-branch-lng');
      if (latEl) latEl.value = Number(lat).toFixed(6);
      if (lngEl) lngEl.value = Number(lng).toFixed(6);

      if (branchInlineMarker) branchInlineMarker.setLatLng([lat, lng]);
      if (branchInlineMap) {
        branchInlineMap.setView([lat, lng], zoom);
      }

      updateBranchServiceRadiusCircle();
    }

    function updateBranchServiceRadiusCircle() {
      const lat = parseFloat(document.getElementById('new-branch-lat')?.value) || 10.7769;
      const lng = parseFloat(document.getElementById('new-branch-lng')?.value) || 106.7009;
      const radiusKm = parseFloat(document.getElementById('branch-service-radius')?.value) || 5;
      const radiusMeters = radiusKm * 1000;

      // Update text summary
      const areaKm2 = (Math.PI * radiusKm * radiusKm).toFixed(1);
      const summaryEl = document.getElementById('branch-radius-summary');
      if (summaryEl) {
        summaryEl.innerText = `${radiusKm} km (~${areaKm2} km²)`;
      }

      if (!branchInlineMap || typeof L === 'undefined') return;

      if (!branchServiceCircle) {
        branchServiceCircle = L.circle([lat, lng], {
          radius: radiusMeters,
          color: '#C5A059',
          fillColor: '#D5B26E',
          fillOpacity: 0.18,
          weight: 2,
          dashArray: '5, 6'
        }).addTo(branchInlineMap);
      } else {
        branchServiceCircle.setLatLng([lat, lng]);
        branchServiceCircle.setRadius(radiusMeters);
      }

      const badge = document.getElementById('new-branch-gps-badge');
      if (badge) {
        badge.className = 'flex items-center space-x-1.5 text-[11px] text-emerald-800 bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-1 rounded-lg font-bold';
        badge.innerHTML = `<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i><span>✓ Đã khoanh vùng bán kính ${radiusKm} km (~${areaKm2} km²) tại [${lat.toFixed(4)}, ${lng.toFixed(4)}]</span>`;
        safeRenderIcons();
      }
    }

    function filterBranchTableByProvince() {
      const filter = document.getElementById('branch-table-province-filter')?.value || 'all';
      const rows = document.querySelectorAll('#branches-table-body tr');
      let visibleCount = 0;

      rows.forEach(tr => {
        if (filter === 'all') {
          tr.style.display = '';
          visibleCount++;
        } else {
          const text = tr.innerText;
          if (text.includes(filter)) {
            tr.style.display = '';
            visibleCount++;
          } else {
            tr.style.display = 'none';
          }
        }
      });

      const countEl = document.getElementById('branch-filtered-count');
      if (countEl) countEl.innerText = visibleCount;
    }


    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      checkApiHealth();
      setInterval(checkApiHealth, 10000); // kiểm tra lại mỗi 10s

      const savedUser = sessionStorage.getItem('oism_user');
      if (savedUser) {
        try {
          const user = JSON.parse(savedUser);
          onLoginSuccess(user);
        } catch (e) {
          sessionStorage.removeItem('oism_user');
          showAuthPortal();
        }
      } else {
        showAuthPortal();
      }

      logSql(
        `-- KHỞI TẠO HỆ THỐNG OISM VỚI SQL SERVER 2022 ENGINE`,
        `USE OISM;\nSET NOCOUNT ON;\n-- Kích hoạt cổng xác thực và bảo mật RLS đa người thuê (sec.TenantIsolationPolicy)\n-- Bắt buộc đăng nhập tài khoản trước khi vào trang chủ.`
      );
    });
  </script>

  <!-- ================= MODAL XÁC NHẬN ĐỊNH VỊ GPS (CHỐNG SAI LỆCH) ================= -->
  <div id="geo-confirm-modal"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4">
    <div
      class="bg-[#F0EFEA] border border-[#D6D0C0] rounded-2xl w-full max-w-2xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="p-4 border-b border-[#D6D0C0] flex items-center justify-between bg-[#EAE7DD]/80">
        <div class="flex items-center space-x-2.5">
          <div class="w-9 h-9 rounded-xl bg-[#C5A059] flex items-center justify-center text-white shadow-md">
            <i data-lucide="map-pin" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-sm text-[#1A1A1A]">Xác Nhận Định Vị Tọa Độ GPS (Chống Sai Lệch)</h3>
            <p class="text-[11px] text-[#544E40]">Kiểm tra trên bản đồ, kéo thả con trỏ ghim hoặc nhấp chuột vào đúng vị
              trí thực tế trước khi xác nhận.</p>
          </div>
        </div>
        <button onclick="closeGeoConfirmModal()"
          class="w-7 h-7 rounded-lg hover:bg-[#D6D0C0]/50 flex items-center justify-center text-[#544E40] transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-4 overflow-y-auto space-y-3.5 flex-1 text-xs">
        <!-- Input & Search Tool -->
        <div class="space-y-1.5">
          <label class="block font-bold text-[#1A1A1A]">Địa chỉ cần định vị:</label>
          <div class="flex space-x-2">
            <input type="text" id="geo-confirm-input-address"
              placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện, tỉnh thành..."
              class="flex-1 px-3 py-2 bg-white rounded-lg border border-[#D6D0C0] text-[#1A1A1A] font-medium focus:border-[#C5A059]">
            <button onclick="geocodeFromModalInput()"
              class="px-4 py-2 bg-[#C5A059] hover:bg-[#B38E47] text-white rounded-lg font-bold flex items-center space-x-1.5 shadow transition shrink-0">
              <i data-lucide="search" class="w-3.5 h-3.5"></i>
              <span>Tìm Tọa Độ</span>
            </button>
          </div>
          <!-- Quick shortcut pills -->
          <div class="flex flex-wrap gap-1.5 pt-1 text-[11px]">
            <span class="text-[#7D7563] self-center">Chọn nhanh:</span>
            <button type="button" onclick="quickPinLocation(21.0285, 105.8542, 'Hoàn Kiếm, Hà Nội')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Hà
              Nội</button>
            <button type="button" onclick="quickPinLocation(16.0544, 108.2022, 'Hải Châu, Đà Nẵng')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Đà
              Nẵng</button>
            <button type="button" onclick="quickPinLocation(10.7769, 106.7009, 'Quận 1, TP. Hồ Chí Minh')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">TP.HCM</button>
            <button type="button" onclick="quickPinLocation(20.8449, 106.6881, 'Đình Vũ, Hải Phòng')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Hải
              Phòng</button>
            <button type="button" onclick="quickPinLocation(22.3364, 103.8438, 'Cầu Mây, Sa Pa, Lào Cai')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Sa
              Pa</button>
            <button type="button" onclick="quickPinLocation(11.9404, 108.4583, 'Phường 1, Đà Lạt, Lâm Đồng')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Đà
              Lạt</button>
            <button type="button" onclick="quickPinLocation(12.2388, 109.1967, 'Trần Phú, Nha Trang, Khánh Hòa')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Nha
              Trang</button>
            <button type="button" onclick="quickPinLocation(10.0452, 105.7469, 'Ninh Kiều, Cần Thơ')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Cần
              Thơ</button>
            <button type="button" onclick="quickPinLocation(10.2289, 103.9572, 'Dương Đông, Phú Quốc, Kiên Giang')"
              class="px-2 py-0.5 rounded-full bg-[#EAE7DD] hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] transition">Phú
              Quốc</button>
          </div>
        </div>

        <!-- Interactive Map Container -->
        <div class="relative rounded-xl overflow-hidden border border-[#D6D0C0] shadow-inner bg-[#EAE7DD]">
          <div id="geo-confirm-leaflet-map" class="w-full h-[280px] z-10"></div>
          <div
            class="absolute bottom-2 left-2 z-20 px-2.5 py-1 rounded-lg bg-[#F0EFEA]/95 border border-[#D6D0C0] shadow text-[10px] text-[#544E40] flex items-center space-x-1.5 pointer-events-none">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span>💡 <strong>Hướng dẫn:</strong> Kéo ghim màu vàng hoặc bấm vào bản đồ để chọn tọa độ chính xác
              nhất.</span>
          </div>
        </div>

        <!-- Coordinates Status Box -->
        <div class="p-3 bg-[#EAE7DD] rounded-xl border border-[#D6D0C0] space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="font-bold text-[#1A1A1A] flex items-center space-x-1">
              <i data-lucide="crosshair" class="w-3.5 h-3.5 text-[#C5A059]"></i>
              <span>Tọa độ GPS đã ghim:</span>
            </span>
            <span id="geo-confirm-accuracy-badge"
              class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-800 border border-emerald-500/30">
              ✓ Độ chính xác: 100% (Pinpoint)
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2 font-mono text-[11px]">
            <div class="p-2 bg-white rounded border border-[#D6D0C0]">
              <span class="text-[#7D7563]">Vĩ độ (Latitude):</span>
              <div id="geo-confirm-lat" class="font-bold text-[#1A1A1A]">10.776900</div>
            </div>
            <div class="p-2 bg-white rounded border border-[#D6D0C0]">
              <span class="text-[#7D7563]">Kinh độ (Longitude):</span>
              <div id="geo-confirm-lng" class="font-bold text-[#1A1A1A]">106.700900</div>
            </div>
          </div>
          <div class="text-[11px] text-[#544E40] truncate" id="geo-confirm-preview-text">
            <strong>Địa chỉ đã xác thực:</strong> <span id="geo-confirm-resolved-address">12 Lê Lợi, Bến Nghé, Quận 1,
              TP.HCM</span>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-3.5 border-t border-[#D6D0C0] flex justify-end space-x-2 bg-[#EAE7DD]/60">
        <button onclick="closeGeoConfirmModal()"
          class="px-4 py-2 rounded-xl bg-white hover:bg-[#EAE7DD] border border-[#D6D0C0] text-[#544E40] font-semibold text-xs transition">
          Hủy Bỏ
        </button>
        <button onclick="applyConfirmedCoordinates()"
          class="px-5 py-2 rounded-xl bg-[#C5A059] hover:bg-[#B38E47] text-white font-bold text-xs flex items-center space-x-1.5 shadow-lg shadow-[#C5A059]/30 transition">
          <i data-lucide="check" class="w-4 h-4"></i>
          <span>✓ Xác Nhận Vị Trí Này (Áp Dụng)</span>
        </button>
      </div>
    </div>
  </div>

</body>

</html>

window.addEventListener('DOMContentLoaded', () => {
try {
safeRenderIcons();
checkApiHealth();
setInterval(checkApiHealth, 10000); // kiểm tra lại mỗi 10s

// FR-SIM-03: Hangfire Auto-Scheduler recurring simulation every 25 seconds
setInterval(() => {
runExpireJobManually(true);
}, 25000);

const savedUser = sessionStorage.getItem('oism_user');
if (savedUser) {
try {
const user = JSON.parse(savedUser);
onLoginSuccess(user);
} catch (e) {
sessionStorage.removeItem('oism_user');
showAuthPortal();
}
} else {
showAuthPortal();
}

logSql(
`-- KHỞI TẠO HỆ THỐNG OISM VỚI SQL SERVER 2022 ENGINE`,
`USE OISM;\nSET NOCOUNT ON;\n-- Kích hoạt cổng xác thực và bảo mật RLS đa người thuê (sec.TenantIsolationPolicy)\n-- Bạn
có thể Đăng nhập hoặc bấm "VÀO THẲNG BẢN DEMO" để bắt đầu.`
);
} catch (e) {
console.error('Lỗi khởi tạo DOMContentLoaded:', e);
showAuthPortal();
}
});
</script>

