<!DOCTYPE html>
<html lang="vi" class="h-full bg-[#FAFAFA] text-[#1A1A1A]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OISM - Hệ Thống Quản Lý Bán Hàng & Tồn Kho Đa Kênh (SQL Server 2022)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Leaflet Maps & GPS CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            slate: {
              950: '#FAFAFA', // Nền chính
              900: '#F0EFEA', // Nền phụ / Thẻ Card
              850: '#EAE7DD',
              800: '#E4DFD3', // Nền bảng / Thẻ con / Nút xám
              750: '#DED8CA',
              700: '#D6D0C0', // Viền border chính
              600: '#B0A894',
              500: '#7D7563', // Text phụ mờ nhẹ
              400: '#544E40', // Text phụ / mô tả
              300: '#383328', // Text thứ cấp
              200: '#242017', // Text tiêu đề đậm
              100: '#1A1A1A', // Chữ chính (Đen than)
              50: '#0D0C09'
            },
            indigo: {
              600: '#C5A059', // Màu nhấn CTA / Nút bấm (Vàng đồng sang trọng)
              500: '#D5B26E', // Hover
              400: '#C5A059',
              300: '#B38E47',
              200: '#E5D3AD',
              100: '#F5ECDA',
              700: '#A47F35', // Active
              800: '#7D5F23',
              900: '#4F3B12',
              950: '#FAF5E8', // Tint vàng kem nhạt
              50: '#FDFBF7'
            },
            brand: {
              main: '#FAFAFA',
              card: '#F0EFEA',
              text: '#1A1A1A',
              gold: '#C5A059',
              goldHover: '#B38E47',
              border: '#D6D0C0'
            }
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --bg-main: #FAFAFA;
      --bg-card: #F0EFEA;
      --bg-card-sub: #EAE7DD;
      --bg-card-hover: #E2DDCF;
      --text-main: #1A1A1A;
      --text-muted: #544E40;
      --accent-gold: #C5A059;
      --accent-gold-hover: #B38E47;
      --border-color: #D6D0C0;
    }

    /* Specific scoped hidden overrides */
    .tab-content.hidden,
    .subtab-content.hidden,
    [id$="-modal"].hidden,
    #auth-panel-register.hidden,
    #flash-sale-results-box.hidden,
    #subtab-content-transfer.hidden,
    #subtab-content-ledger.hidden,
    #low-stock-dot.hidden,
    #low-stock-dot-solid.hidden {
      display: none !important;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      height: 100%;
      background-color: #FAFAFA !important;
      color: #1A1A1A !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Global background & text mapping to User Palette */
    .bg-slate-950,
    #auth-portal-screen,
    #main-layout,
    main,
    .tab-content {
      background-color: #FAFAFA !important;
      color: #1A1A1A !important;
    }

    .bg-slate-900,
    .bg-slate-900\/98,
    .bg-slate-900\/95,
    .bg-slate-900\/90,
    .bg-slate-900\/80,
    .bg-slate-900\/60,
    .bg-slate-900\/50,
    .bg-slate-900\/40 {
      background-color: #F0EFEA !important;
    }

    .bg-slate-800,
    .bg-slate-800\/90,
    .bg-slate-800\/80,
    .bg-slate-800\/70,
    .bg-slate-800\/60,
    .bg-slate-800\/50,
    .bg-slate-800\/40 {
      background-color: #EAE7DD !important;
    }

    .border-slate-800,
    .border-slate-800\/80,
    .border-slate-700,
    .border-slate-600,
    .border-slate-900 {
      border-color: #D6D0C0 !important;
    }

    /* Text contrast rules */
    .text-slate-100,
    .text-slate-200 {
      color: #1A1A1A !important;
    }

    .text-slate-300 {
      color: #383328 !important;
    }

    .text-slate-400 {
      color: #544E40 !important;
    }

    .text-slate-500 {
      color: #7D7563 !important;
    }

    /* Primary Accent / Gold CTA Button (#C5A059) */
    .bg-indigo-600 {
      background-color: #C5A059 !important;
      color: #FFFFFF !important;
    }

    .bg-indigo-600:hover,
    .hover\:bg-indigo-500:hover,
    .hover\:bg-indigo-600:hover {
      background-color: #B38E47 !important;
      color: #FFFFFF !important;
    }

    .text-indigo-400,
    .text-indigo-300 {
      color: #A47F35 !important;
    }

    .bg-indigo-500\/20,
    .bg-indigo-500\/10,
    .bg-indigo-950\/40,
    .bg-indigo-950\/60,
    .bg-indigo-950\/70 {
      background-color: #FAF5E8 !important;
      border-color: #E5D3AD !important;
      color: #8C7037 !important;
    }

    /* Navigation Bar (Tier 2) & Nav Tabs */
    #main-navigation-bar {
      background-color: #EAE7DD !important;
      border-top: 1px solid #D6D0C0 !important;
      border-bottom: 1px solid #D6D0C0 !important;
    }

    .nav-tab {
      color: #544E40 !important;
      transition: all 0.2s ease;
    }

    .nav-tab:hover {
      background-color: #F0EFEA !important;
      color: #1A1A1A !important;
    }

    .nav-tab.bg-indigo-600 {
      background-color: #C5A059 !important;
      color: #FFFFFF !important;
      font-weight: 700 !important;
      box-shadow: 0 2px 6px rgba(197, 160, 89, 0.35) !important;
    }

    /* Form Inputs styling */
    input,
    select,
    textarea {
      background-color: #FFFFFF !important;
      color: #1A1A1A !important;
      border: 1px solid #D6D0C0 !important;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #C5A059 !important;
      outline: none !important;
      box-shadow: 0 0 0 2px rgba(197, 160, 89, 0.25) !important;
    }

    input::placeholder,
    textarea::placeholder {
      color: #8C8472 !important;
    }

    /* Tables */
    table thead tr {
      background-color: #EAE7DD !important;
      color: #544E40 !important;
      border-bottom: 2px solid #D6D0C0 !important;
    }

    table tbody tr {
      border-bottom: 1px solid #EAE7DD !important;
    }

    table tbody tr:hover {
      background-color: #FAF5E8 !important;
    }

    /* Modal dialog styling */
    [id$="-modal"]>div {
      background-color: #F0EFEA !important;
      border-color: #D6D0C0 !important;
      color: #1A1A1A !important;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15) !important;
    }


    /* Leaflet Luxury Warm Ivory & Gold Theme */
    .leaflet-popup-content-wrapper,
    .leaflet-popup-tip {
      background-color: #F0EFEA !important;
      color: #1A1A1A !important;
      border: 1px solid #D6D0C0 !important;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
    }

    .leaflet-container {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      background-color: #E6ECF0 !important;
    }

    .leaflet-tile {
      visibility: inherit !important;
    }

    /* Custom luxury scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #FAFAFA;
    }

    ::-webkit-scrollbar-thumb {
      background: #D6D0C0;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #C5A059;
    }

    /* Subtle badges */
    .badge-in {
      background-color: rgba(21, 128, 61, 0.12);
      color: #15803d;
      border: 1px solid rgba(21, 128, 61, 0.25);
    }

    .badge-out {
      background-color: rgba(185, 28, 28, 0.12);
      color: #b91c1c;
      border: 1px solid rgba(185, 28, 28, 0.25);
    }

    @media print {
      body * {
        visibility: hidden !important;
      }

      #printable-receipt,
      #printable-receipt *,
      #printable-shipping-slip,
      #printable-shipping-slip *,
      #printable-barcode-sticker,
      #printable-barcode-sticker * {
        visibility: visible !important;
      }

      #printable-receipt {
        position: absolute;
        left: 0;
        top: 0;
        width: 80mm;
        font-size: 12px;
        background: white;
        color: black;
      }

      #printable-shipping-slip {
        position: absolute;
        left: 0;
        top: 0;
        width: 148mm;
        font-size: 12px;
        background: white;
        color: black;
        padding: 10px;
      }

      #printable-barcode-sticker {
        position: absolute;
        left: 0;
        top: 0;
        width: 65mm;
        font-size: 11px;
        background: white;
        color: black;
        text-align: center;
      }
    }
  </style>
</head>

<body class="h-full font-sans bg-slate-950 text-slate-100 overflow-hidden">

  <!-- ================= FULLSCREEN AUTHENTICATION GATE ================= -->
  <!-- BẮT BUỘC PHẢI ĐĂNG NHẬP HOẶC ĐĂNG KÝ CỬA HÀNG MỚI ĐƯỢC VÀO TRANG CHỦ -->
  <div id="auth-portal-screen" class="fixed inset-0 z-50 bg-slate-950 flex flex-col lg:flex-row overflow-y-auto">
    <!-- Nút Bỏ qua đăng nhập nhanh góc trên -->
    <button onclick="skipLoginAndEnterDemo('Owner')"
      class="absolute top-4 right-4 z-20 px-3 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-xs font-bold text-amber-300 border border-amber-500/40 shadow-xl flex items-center space-x-1.5 transition"
      title="Bỏ qua đăng nhập và vào thẳng giao diện với quyền Owner">
      <span>⚡ Bỏ qua • Vào Demo ngay</span>
    </button>

    <!-- Left Hero Banner -->
    <div
      class="lg:w-5/12 bg-[#F0EFEA] border-b lg:border-b-0 lg:border-r border-[#D6D0C0] p-8 sm:p-12 flex flex-col justify-between relative overflow-hidden shrink-0">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none">
      </div>
      <div class="absolute -left-20 -top-20 w-80 h-80 bg-[#D5B26E]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <div class="flex items-center space-x-3">
          <div
            class="w-11 h-11 rounded-xl bg-[#C5A059] flex items-center justify-center font-bold text-white shadow-xl shadow-[#C5A059]/30">
            <i data-lucide="layers" class="w-6 h-6"></i>
          </div>
          <div>
            <h1 class="font-black text-lg tracking-wider text-[#A47F35]">OISM ENTERPRISE</h1>
            <p class="text-xs text-slate-500 font-mono">SQL Server 2022 • SaaS Multi-tenant</p>
          </div>
        </div>

        <div class="space-y-3 pt-4">
          <div
            class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#FAF5E8] border border-[#E5D3AD] text-[#8C7037] text-xs font-semibold">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
            <span>Bảo mật CSDL cấp doanh nghiệp</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1A1A1A] leading-tight">
            Hệ Thống Quản Lý Bán Hàng & Tồn Kho Đa Kênh
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm leading-relaxed">
            Giải pháp tích hợp quầy thu ngân POS, sổ cái kho bất biến, tự động tính giá vốn bình quân (WAC) và cơ chế
            khóa dòng chống bán âm kho (Anti-oversell).
          </p>
        </div>

        <div class="space-y-2.5 pt-2 text-xs">
          <div class="flex items-start space-x-2.5 text-slate-300">
            <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
            <span><strong>Multi-tenancy RLS:</strong> Dữ liệu mỗi cửa hàng được cô lập triệt để ở tầng Database
              Engine.</span>
          </div>
          <div class="flex items-start space-x-2.5 text-slate-300">
            <i data-lucide="check-circle" class="w-4 h-4 text-indigo-400 shrink-0 mt-0.5"></i>
            <span><strong>Append-Only Ledger:</strong> Sổ cái bất biến, nghiêm cấm sửa/xóa, chuẩn kiểm toán.</span>
          </div>
          <div class="flex items-start space-x-2.5 text-slate-300">
            <i data-lucide="check-circle" class="w-4 h-4 text-amber-400 shrink-0 mt-0.5"></i>
            <span><strong>Lock-based Anti-Oversell:</strong> Khóa dòng độc quyền bảo vệ đơn hàng Flash Sale.</span>
          </div>
          <div class="flex items-start space-x-2.5 text-slate-300">
            <i data-lucide="check-circle" class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5"></i>
            <span><strong>PWA POS Fast Checkout:</strong> Thanh toán tức thì qua 1 Atomic Transaction.</span>
          </div>
        </div>
      </div>

      <div
        class="relative z-10 pt-8 border-t border-slate-800/80 text-[11px] text-slate-500 flex justify-between items-center">
        <span>Đồ án Hệ Quản Trị CSDL • 10/10 Score</span>
        <span class="font-mono text-slate-400">v2.0 Protected</span>
      </div>
    </div>

    <!-- Right Login / Register Card -->
    <div class="flex-1 p-6 sm:p-12 flex items-center justify-center bg-slate-950">
      <div class="max-w-md w-full bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-5">
        <div>
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center space-x-2">
              <i data-lucide="lock" class="w-5 h-5 text-indigo-400"></i>
              <h3 class="text-base font-extrabold uppercase text-slate-100 tracking-wide">Cổng Đăng Nhập Hệ Thống</h3>
            </div>
            <span id="auth-backend-status"
              class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">
              ● Đang dò tìm Backend...
            </span>
          </div>
          <p class="text-xs text-slate-400">Đăng nhập tài khoản hoặc chọn 1-chạm bên dưới để trải nghiệm ngay</p>
        </div>

        <!-- Tab Switcher -->
        <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-950 rounded-xl border border-slate-800 text-xs font-bold">
          <button onclick="switchAuthTab('login')" id="btn-auth-tab-login"
            class="py-2.5 rounded-lg bg-indigo-600 text-white shadow-sm flex items-center justify-center space-x-1.5 transition">
            <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
            <span>Đăng Nhập</span>
          </button>
          <button onclick="switchAuthTab('register')" id="btn-auth-tab-register"
            class="py-2.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1.5 transition">
            <i data-lucide="store" class="w-3.5 h-3.5"></i>
            <span>Đăng Ký Cửa Hàng</span>
          </button>
        </div>

        <!-- TAB 1: FORM ĐĂNG NHẬP -->
        <div id="auth-panel-login" class="space-y-4">
          <div class="space-y-3 text-xs">
            <div>
              <label class="block text-slate-300 font-semibold mb-1">Email hoặc Số điện thoại:</label>
              <div class="relative">
                <i data-lucide="mail" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
                <input type="text" id="login-email" value="owner@minhanh.vn" placeholder="owner@minhanh.vn"
                  onkeydown="if(event.key==='Enter') submitLogin()"
                  class="w-full pl-9 pr-3 py-2.5 bg-slate-800 rounded-lg border border-slate-700 text-slate-200 focus:outline-none focus:border-indigo-500">
              </div>
            </div>
            <div>
              <label class="block text-slate-300 font-semibold mb-1">Mật khẩu:</label>
              <div class="relative">
                <i data-lucide="lock" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
                <input type="password" id="login-password" value="123456" placeholder="Nhập mật khẩu..."
                  onkeydown="if(event.key==='Enter') submitLogin()"
                  class="w-full pl-9 pr-3 py-2.5 bg-slate-800 rounded-lg border border-slate-700 text-slate-200 focus:outline-none focus:border-indigo-500">
              </div>
              <p class="text-[10px] text-slate-500 mt-1">Mật khẩu mẫu mặc định cho các tài khoản seed: <code
                  class="text-indigo-400 font-mono">123456</code></p>
            </div>
          </div>

          <button onclick="submitLogin()"
            class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 active:scale-98 text-white rounded-xl font-bold text-xs flex items-center justify-center space-x-2 shadow-lg shadow-indigo-900/40 transition">
            <i data-lucide="arrow-right-circle" class="w-4 h-4"></i>
            <span>ĐĂNG NHẬP VÀO TRANG CHỦ</span>
          </button>

          <!-- Nút Vào thẳng Demo không cần mật khẩu -->
          <button onclick="skipLoginAndEnterDemo('Owner')"
            class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 active:scale-98 text-amber-300 hover:text-amber-200 border border-amber-500/40 rounded-xl font-bold text-xs flex items-center justify-center space-x-2 transition shadow-md">
            <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
            <span>⚡ VÀO THẲNG BẢN DEMO (BỎ QUA ĐĂNG NHẬP)</span>
          </button>

          <!-- Quick Demo Accounts (RBAC Testing) -->
          <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2 text-xs">
            <span
              class="block text-[10px] font-bold text-slate-400 uppercase tracking-wide flex items-center space-x-1">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
              <span>Hoặc bấm 1-chạm để vào ngay (Test Phân quyền RBAC):</span>
            </span>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <button onclick="quickLogin('owner@minhanh.vn', '123456')"
                class="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-left transition flex flex-col">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-purple-300">Minh Anh (Owner)</span>
                  <span class="text-[9px] px-1 rounded bg-purple-500/20 text-purple-300 font-mono">Toàn quyền</span>
                </div>
                <span class="text-[10px] text-slate-400 truncate">owner@minhanh.vn</span>
              </button>
              <button onclick="quickLogin('kho@minhanh.vn', '123456')"
                class="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-left transition flex flex-col">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-blue-300">Quốc Bảo (Staff)</span>
                  <span class="text-[9px] px-1 rounded bg-blue-500/20 text-blue-300 font-mono">Kho & Đơn</span>
                </div>
                <span class="text-[10px] text-slate-400 truncate">kho@minhanh.vn</span>
              </button>
              <button onclick="quickLogin('thungan@minhanh.vn', '123456')"
                class="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-left transition flex flex-col">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-emerald-300">Thu Hà (Cashier)</span>
                  <span class="text-[9px] px-1 rounded bg-emerald-500/20 text-emerald-300 font-mono">Chỉ POS</span>
                </div>
                <span class="text-[10px] text-slate-400 truncate">thungan@minhanh.vn</span>
              </button>
              <button onclick="quickLogin('owner@hoasen.vn', '123456')"
                class="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-left transition flex flex-col">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-pink-300">Hoa Sen (Owner)</span>
                  <span class="text-[9px] px-1 rounded bg-pink-500/20 text-pink-300 font-mono">Tenant 2</span>
                </div>
                <span class="text-[10px] text-slate-400 truncate">owner@hoasen.vn</span>
              </button>
            </div>
          </div>
        </div>

        <!-- TAB 2: FORM ĐĂNG KÝ CỬA HÀNG MỚI (FR-AUTH-01) -->
        <div id="auth-panel-register" class="space-y-3 text-xs hidden max-h-[460px] overflow-y-auto pr-1">
          <div class="p-2.5 bg-indigo-950/40 rounded-lg border border-indigo-800/40 text-[11px] text-indigo-300">
            Hệ thống sẽ cấp một <strong>TenantId</strong> riêng biệt với không gian dữ liệu độc lập hoàn toàn ở tầng
            Database (Row-Level Security).
          </div>

          <div class="space-y-2">
            <h4 class="font-bold text-slate-200 text-xs border-b border-slate-800 pb-1">1. Thông tin Cửa hàng & Chi
              nhánh:</h4>
            <div>
              <label class="block text-slate-400 font-medium mb-1">Tên Cửa hàng / Doanh nghiệp <span
                  class="text-rose-400">*</span>:</label>
              <input type="text" id="reg-store-name" placeholder="Ví dụ: Chuỗi Thời Trang Phong Cách Việt"
                class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-slate-400 font-medium mb-1">Tên Chi nhánh đầu tiên:</label>
                <input type="text" id="reg-branch-name" value="Chi nhánh chính"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
              <div>
                <label class="block text-slate-400 font-medium mb-1">Địa chỉ chi nhánh:</label>
                <input type="text" id="reg-branch-address" placeholder="Số 10 Hai Bà Trưng, HN"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
            </div>
          </div>

          <div class="space-y-2 pt-1">
            <h4 class="font-bold text-slate-200 text-xs border-b border-slate-800 pb-1">2. Tài khoản Quản trị viên
              (Owner):</h4>
            <div>
              <label class="block text-slate-400 font-medium mb-1">Họ và tên chủ cửa hàng <span
                  class="text-rose-400">*</span>:</label>
              <input type="text" id="reg-owner-name" placeholder="Nguyễn Văn A"
                class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-slate-400 font-medium mb-1">Email đăng nhập <span
                    class="text-rose-400">*</span>:</label>
                <input type="email" id="reg-email" placeholder="owner@domain.com"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
              <div>
                <label class="block text-slate-400 font-medium mb-1">Số điện thoại:</label>
                <input type="tel" id="reg-phone" placeholder="0912345678"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-slate-400 font-medium mb-1">Mật khẩu <span
                    class="text-rose-400">*</span>:</label>
                <input type="password" id="reg-password" placeholder="Tối thiểu 6 ký tự..."
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
              <div>
                <label class="block text-slate-400 font-medium mb-1">Nhập lại mật khẩu <span
                    class="text-rose-400">*</span>:</label>
                <input type="password" id="reg-password-confirm" placeholder="Xác nhận mật khẩu..."
                  onkeydown="if(event.key==='Enter') submitRegisterTenant()"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
            </div>
          </div>

          <button onclick="submitRegisterTenant()"
            class="w-full py-3 mt-2 bg-emerald-600 hover:bg-emerald-500 active:scale-98 text-white rounded-xl font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-emerald-900/40 transition">
            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            <span>TẠO CỬA HÀNG & VÀO TRANG CHỦ</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= MAIN LAYOUT (CHỈ HIỂN THỊ KHI ĐÃ ĐĂNG NHẬP) ================= -->
  <div id="main-layout" class="h-full flex flex-col font-sans overflow-hidden bg-slate-950 text-slate-100 hidden">

    <!-- ================= TOP HEADER (2 TẦNG CHUYÊN NGHIỆP: UTILITY BAR + MAIN NAV) ================= -->
    <header class="bg-slate-900 border-b border-slate-800 shrink-0 z-30 shadow-lg flex flex-col">
      <!-- TẦNG 1: THƯƠNG HIỆU, TRẠNG THÁI KẾT NỐI & TÀI KHOẢN NGƯỜI DÙNG -->
      <div class="px-4 py-2 flex items-center justify-between border-b border-slate-800/80 bg-slate-900/95">
        <!-- Logo & Trạng thái Backend -->
        <div class="flex items-center space-x-3 shrink-0">
          <div
            class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-500/30">
            <i data-lucide="layers" class="w-4 h-4"></i>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="font-extrabold text-sm tracking-wide text-[#A47F35]">OISM ENTERPRISE</span>
              <span
                class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-mono">SQL
                Server 2022</span>
            </div>
            <div class="text-[10px] text-slate-400 flex items-center space-x-2">
              <span>RCSI Enabled</span>
              <span>•</span>
              <span id="backend-status-badge"
                class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                ● Kiểm tra kết nối SQL Server...
              </span>
            </div>
          </div>
        </div>

        <!-- Các Tiện ích & Quản lý Tài khoản (Bên phải) -->
        <div class="flex items-center space-x-2.5 shrink-0">
          <!-- Tenant Switcher -->
          <div class="flex items-center space-x-1.5 bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800">
            <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i>
            <div class="text-left">
              <div class="text-[8px] uppercase tracking-wider text-slate-500 font-bold">SESSION_CONTEXT</div>
              <select id="tenant-select" onchange="changeTenant(this.value)"
                class="bg-transparent text-[11px] font-semibold text-slate-200 focus:outline-none cursor-pointer">
                <option value="1" class="bg-slate-900 text-slate-200">Tenant 1: Cửa hàng Minh Anh</option>
                <option value="2" class="bg-slate-900 text-slate-200">Tenant 2: Shop Hoa Sen</option>
              </select>
            </div>
          </div>

          <!-- Chuông Cảnh báo Tồn thấp -->
          <button onclick="showLowStockModal()"
            class="relative p-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition"
            title="Cảnh báo tồn kho">
            <i data-lucide="bell" class="w-4 h-4"></i>
            <span id="low-stock-dot"
              class="hidden absolute top-1 right-1 w-2 h-2 bg-rose-500 rounded-full animate-ping"></span>
            <span id="low-stock-dot-solid"
              class="hidden absolute top-1 right-1 w-2 h-2 bg-rose-500 rounded-full"></span>
          </button>

          <!-- Thông tin User & Role -->
          <div id="user-profile-widget"
            class="flex items-center space-x-2 bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800">
            <div
              class="w-6 h-6 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center font-bold text-[10px] text-white shrink-0"
              id="user-avatar-initials">
              MA
            </div>
            <div class="text-left flex flex-col justify-center">
              <div class="flex items-center space-x-1.5">
                <span class="text-[11px] font-bold text-slate-200" id="user-full-name">Nguyễn Minh Anh</span>
                <span
                  class="text-[8px] px-1 py-0.2 rounded font-bold uppercase bg-purple-500/20 text-purple-300 border border-purple-500/30"
                  id="user-role-badge">Owner</span>
              </div>
              <div class="text-[9px] text-slate-400 truncate max-w-[120px]" id="user-store-name">Cửa hàng Minh Anh</div>
            </div>
          </div>

          <!-- Nút Đăng xuất -->
          <button onclick="logoutUser()"
            class="flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-rose-600/90 hover:bg-rose-500 text-white font-bold text-xs shadow-md shadow-rose-950/40 active:scale-95 transition"
            title="Đăng xuất khỏi hệ thống">
            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
            <span>Đăng Xuất</span>
          </button>

          <!-- Drawer T-SQL Console -->
          <button onclick="toggleSqlInspector()"
            class="flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-indigo-950/70 hover:bg-indigo-900/80 text-indigo-300 border border-indigo-800/60 text-xs font-medium transition"
            title="Mở T-SQL Inspector Drawer">
            <i data-lucide="terminal" class="w-3.5 h-3.5 text-indigo-400"></i>
            <span>T-SQL Inspector</span>
          </button>
        </div>
      </div>

      <!-- TẦNG 2: THANH MENU ĐIỀU HƯỚNG 8 TAB (TOÀN CHIỀU RỘNG, THOÁNG ĐÃNG, KHÔNG BAO GIỜ BỊ ĐÈ) -->
      <nav id="main-navigation-bar"
        class="px-4 py-1.5 bg-slate-950/90 flex items-center space-x-1.5 overflow-x-auto border-t border-slate-900">
        <button onclick="switchTab('pos')" id="tab-btn-pos"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-white bg-indigo-600 shadow-sm shrink-0">
          <i data-lucide="scan-barcode" class="w-4 h-4"></i>
          <span>POS Thu Ngân (F2)</span>
        </button>
        <button onclick="switchTab('orders')" id="tab-btn-orders"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0">
          <i data-lucide="shopping-cart" class="w-4 h-4"></i>
          <span>Đơn Hàng Đa Kênh</span>
          <span id="order-count-badge"
            class="px-1.5 py-0.2 rounded-full text-[10px] bg-indigo-500/20 text-indigo-300 font-bold">0</span>
        </button>
        <button onclick="switchTab('inventory')" id="tab-btn-inventory"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0">
          <i data-lucide="boxes" class="w-4 h-4"></i>
          <span>Kho & Sổ Cái (Ledger)</span>
        </button>
        <button onclick="switchTab('purchase')" id="tab-btn-purchase"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0">
          <i data-lucide="truck" class="w-4 h-4"></i>
          <span>Nhập Hàng (WAC)</span>
        </button>
        <button onclick="switchTab('products')" id="tab-btn-products"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0"
          title="Quản lý Sản phẩm, SKU, Barcode, Giá & Danh mục">
          <i data-lucide="tags" class="w-4 h-4"></i>
          <span>Hàng Hóa & Giá</span>
        </button>
        <button onclick="switchTab('branches')" id="tab-btn-branches"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0"
          title="Quản lý Chi nhánh & Kho hàng">
          <i data-lucide="building-2" class="w-4 h-4"></i>
          <span>Chi Nhánh</span>
        </button>
        <button onclick="switchTab('map')" id="tab-btn-map"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0"
          title="Bản đồ GPS số hóa, kho hàng & định vị giao hàng">
          <i data-lucide="map-pin" class="w-4 h-4 text-[#C5A059]"></i>
          <span>Bản Đồ GPS</span>
        </button>
        <button onclick="switchTab('webhook')" id="tab-btn-webhook"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0">
          <i data-lucide="zap" class="w-4 h-4"></i>
          <span>Giả Lập Sàn & Flash Sale</span>
        </button>
        <button onclick="switchTab('reports')" id="tab-btn-reports"
          class="nav-tab px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 shrink-0">
          <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
          <span>Báo Cáo (Columnstore)</span>
        </button>
      </nav>
    </header>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <main class="flex-1 overflow-hidden relative">

      <!-- ------------------ 1. TAB: POS FAST CHECKOUT ------------------ -->
      <div id="tab-pos" class="tab-content h-full flex flex-col md:flex-row">
        <!-- Left: Product Catalog Grid -->
        <div class="flex-1 flex flex-col border-r border-slate-800 overflow-hidden bg-slate-950">
          <!-- Search bar & Branch selector -->
          <div class="p-3 border-b border-slate-800/80 bg-slate-900/60 flex items-center space-x-3">
            <div class="relative flex-1">
              <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="text" id="pos-search-input" onkeyup="filterPosProducts()"
                placeholder="Quét mã vạch hoặc gõ tên SKU, mã hàng (nhấn F2)..."
                class="w-full pl-9 pr-4 py-2 bg-slate-800/90 rounded-lg text-sm text-slate-100 placeholder-slate-400 border border-slate-700 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition">
              <span
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-700 text-slate-300 border border-slate-600">Enter
                để thêm</span>
            </div>

            <!-- Branch select -->
            <div class="flex items-center space-x-1.5 bg-slate-800/80 px-2.5 py-1.5 rounded-lg border border-slate-700">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-indigo-400"></i>
              <select id="pos-branch-select" onchange="renderPosProducts()"
                class="bg-transparent text-xs text-slate-200 focus:outline-none cursor-pointer">
                <!-- Rendered via JS -->
              </select>
            </div>
          </div>

          <!-- Product Cards Grid -->
          <div class="flex-1 p-4 overflow-y-auto">
            <div id="pos-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Right: Cart & Fast Checkout Panel -->
        <div class="w-full md:w-96 flex flex-col bg-slate-900 shrink-0">
          <div class="p-3 border-b border-slate-800 flex items-center justify-between bg-slate-900/80">
            <div class="flex items-center space-x-2">
              <i data-lucide="shopping-bag" class="w-4 h-4 text-indigo-400"></i>
              <span class="font-bold text-sm">Giỏ Hàng POS</span>
            </div>
            <button onclick="clearCart()" class="text-xs text-rose-400 hover:text-rose-300 flex items-center space-x-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              <span>Xóa giỏ</span>
            </button>
          </div>

          <!-- Cart Items List -->
          <div id="pos-cart-items" class="flex-1 overflow-y-auto p-3 space-y-2">
            <!-- Rendered via JS -->
          </div>

          <!-- Cart Summary & Actions -->
          <div class="p-4 border-t border-slate-800 bg-slate-950/80 space-y-3">
            <div class="space-y-1.5 text-xs">
              <div class="flex justify-between text-slate-400">
                <span>Tổng số lượng món:</span>
                <span id="pos-cart-total-qty" class="font-bold text-slate-200">0</span>
              </div>
              <div class="flex justify-between text-base font-extrabold text-slate-100 pt-1 border-t border-slate-800">
                <span>Tổng thanh toán:</span>
                <span id="pos-cart-total-amount" class="text-indigo-400 font-mono">0 đ</span>
              </div>
            </div>

            <!-- Checkout Buttons -->
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button onclick="executePosCheckout('Cash')" id="btn-pay-cash"
                class="py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-emerald-900/30 transition">
                <i data-lucide="banknote" class="w-4 h-4"></i>
                <span>Tiền mặt (F4)</span>
              </button>
              <button onclick="executePosCheckout('QR')" id="btn-pay-qr"
                class="py-2.5 px-3 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-900/30 transition">
                <i data-lucide="qr-code" class="w-4 h-4"></i>
                <span>Chuyển QR (F8)</span>
              </button>
            </div>
            <p class="text-[10px] text-center text-slate-500">
              Gọi Stored Procedure <code class="text-indigo-400 font-mono">usp_FastCheckout</code> • 1 Transaction duy
              nhất
            </p>
          </div>
        </div>
      </div>

      <!-- ------------------ 2. TAB: OMNICHANNEL ORDERS ------------------ -->
      <div id="tab-orders" class="tab-content h-full hidden flex flex-col bg-slate-950">
        <!-- Filter Bar -->
        <div class="p-3 border-b border-slate-800 bg-slate-900 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center space-x-2">
            <span class="text-xs font-semibold text-slate-400">Kênh:</span>
            <div class="flex space-x-1" id="order-channel-filters">
              <button onclick="filterOrdersByChannel('ALL')"
                class="order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-indigo-600 text-white">Tất
                cả</button>
              <button onclick="filterOrdersByChannel('POS')"
                class="order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800 text-slate-400 hover:text-slate-200">POS</button>
              <button onclick="filterOrdersByChannel('Shopee')"
                class="order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800 text-slate-400 hover:text-slate-200">Shopee</button>
              <button onclick="filterOrdersByChannel('TikTok')"
                class="order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800 text-slate-400 hover:text-slate-200">TikTok</button>
              <button onclick="filterOrdersByChannel('Lazada')"
                class="order-filter-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800 text-slate-400 hover:text-slate-200">Lazada</button>
            </div>
          </div>

          <div class="flex items-center space-x-2">
            <span class="text-xs text-slate-400">Trạng thái:</span>
            <select id="order-status-filter" onchange="renderOrdersTable()"
              class="bg-slate-800 border border-slate-700 text-xs rounded px-2.5 py-1 text-slate-200 focus:outline-none">
              <option value="ALL">Tất cả trạng thái</option>
              <option value="Reserved">Reserved (Đang giữ hàng)</option>
              <option value="Confirmed">Confirmed (Đã duyệt kho)</option>
              <option value="Completed">Completed (Hoàn tất)</option>
              <option value="Cancelled">Cancelled (Đã hủy)</option>
            </select>
            <button onclick="runExpireJobManually()"
              class="px-2.5 py-1 bg-amber-600/20 text-amber-300 border border-amber-600/40 hover:bg-amber-600/30 rounded text-xs font-medium flex items-center space-x-1"
              title="Mô phỏng job Hangfire quét đơn hết hạn">
              <i data-lucide="clock-alert" class="w-3.5 h-3.5"></i>
              <span>Quét hủy quá hạn (READPAST)</span>
            </button>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="flex-1 overflow-auto p-4">
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr
                  class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px] tracking-wider">
                  <th class="p-3">Mã Đơn</th>
                  <th class="p-3">Kênh</th>
                  <th class="p-3">Mã Sàn (Ext)</th>
                  <th class="p-3">Sản phẩm</th>
                  <th class="p-3 text-right">Doanh Thu</th>
                  <th class="p-3 text-right">Giá Vốn (COGS)</th>
                  <th class="p-3 text-right">Lợi Nhuận Gộp</th>
                  <th class="p-3 text-center">Trạng Thái</th>
                  <th class="p-3 text-center">Hành Động (State Machine)</th>
                </tr>
              </thead>
              <tbody id="orders-table-body" class="divide-y divide-slate-800/80 text-slate-300 font-mono">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ------------------ 3. TAB: INVENTORY & SỔ CÁI (APPEND-ONLY) ------------------ -->
      <div id="tab-inventory" class="tab-content h-full hidden flex flex-col bg-slate-950">
        <div class="p-3 border-b border-slate-800 bg-slate-900 flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <button onclick="switchInventorySubtab('stock')" id="btn-subtab-stock"
              class="px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white">
              1. Tồn Kho Chi Nhánh (StockLevels)
            </button>
            <button onclick="switchInventorySubtab('ledger')" id="btn-subtab-ledger"
              class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-slate-200">
              2. Sổ Cái Bất Biến (InventoryLedger - Append Only)
            </button>
            <button onclick="switchInventorySubtab('transfer')" id="btn-subtab-transfer"
              class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-slate-200">
              3. Chuyển Kho 2 Bước (FR-INV-03)
            </button>
          </div>
          <div class="text-[11px] text-slate-400">
            <span class="text-rose-400 font-bold">Ràng buộc:</span> Chặn tuyệt đối <code
              class="bg-slate-800 px-1 py-0.5 rounded text-rose-300">UPDATE / DELETE</code>
          </div>
        </div>

        <!-- Subtab A: StockLevels -->
        <div id="subtab-content-stock" class="flex-1 overflow-auto p-4 space-y-4">
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
            <div class="p-3 bg-slate-800/60 border-b border-slate-700/80 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="database" class="w-4 h-4 text-indigo-400"></i>
                <span>Bảng dbo.StockLevels (Công thức: Available = OnHand - Reserved)</span>
              </span>
              <button onclick="openStocktakeModal()"
                class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs font-medium flex items-center space-x-1">
                <i data-lucide="clipboard-check" class="w-3.5 h-3.5"></i>
                <span>Kiểm kê cân kho (usp_StocktakeAdjust)</span>
              </button>
            </div>
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr
                  class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px] tracking-wider">
                  <th class="p-3">Chi Nhánh</th>
                  <th class="p-3">Mã SKU</th>
                  <th class="p-3">Tên Biến Thể</th>
                  <th class="p-3">Mã Vạch</th>
                  <th class="p-3 text-right">Tồn Thực (OnHand)</th>
                  <th class="p-3 text-right">Đang Giữ (Reserved)</th>
                  <th class="p-3 text-right text-emerald-400">Khả Dụng (Available)</th>
                  <th class="p-3 text-right">Giá Vốn Hiện Tại</th>
                  <th class="p-3 text-center">Trạng Thái Kho</th>
                </tr>
              </thead>
              <tbody id="stock-levels-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Subtab B: InventoryLedger (Append-Only) -->
        <div id="subtab-content-ledger" class="flex-1 overflow-auto p-4 hidden space-y-4">
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl flex flex-col">
            <div class="p-3 bg-slate-800/60 border-b border-slate-700/80 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="scroll" class="w-4 h-4 text-emerald-400"></i>
                <span>Bảng dbo.InventoryLedger (Partitioning theo Tháng + Clustered Key)</span>
              </span>
              <span class="text-[11px] text-emerald-400 font-mono">Tổng: <span id="ledger-count">0</span> giao
                dịch</span>
            </div>
            <div class="overflow-auto max-h-[500px]">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr
                    class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px] tracking-wider sticky top-0 z-10">
                    <th class="p-3">Ledger ID</th>
                    <th class="p-3">Thời Điểm (UTC)</th>
                    <th class="p-3">Mã SKU</th>
                    <th class="p-3">Chi Nhánh</th>
                    <th class="p-3 text-center">Loại</th>
                    <th class="p-3">Nghiệp Vụ</th>
                    <th class="p-3 text-right">Số Lượng</th>
                    <th class="p-3 text-right">Tồn Sau Giao Dịch</th>
                    <th class="p-3">Chứng Từ Tham Chiếu</th>
                  </tr>
                </thead>
                <tbody id="ledger-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                  <!-- Rendered via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Subtab C: Stock Transfers (FR-INV-03) -->
        <div id="subtab-content-transfer" class="flex-1 overflow-auto p-4 space-y-4 hidden">
          <!-- Bộ lọc chi nhánh theo Tỉnh / Thành phố -->
          <div
            class="p-2.5 bg-[#EAE7DD] rounded-xl border border-[#D6D0C0] flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center space-x-2">
              <i data-lucide="filter" class="w-4 h-4 text-[#C5A059]"></i>
              <span class="font-bold text-[#1A1A1A]">Khoanh vùng lọc chi nhánh:</span>
              <select id="branch-table-province-filter" onchange="filterBranchTableByProvince()"
                class="px-2.5 py-1 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-semibold text-xs">
                <option value="all">Tất cả Tỉnh / Thành phố (Toàn quốc)</option>
              </select>
            </div>
            <div class="text-[11px] text-[#544E40]">
              Hiển thị: <strong id="branch-filtered-count" class="text-[#A47F35]">11</strong> chi nhánh
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Left: Tạo Phiếu Chuyển Kho -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl space-y-3">
              <div class="flex items-center space-x-2 pb-2 border-b border-slate-800">
                <i data-lucide="arrow-left-right" class="w-4 h-4 text-cyan-400"></i>
                <h3 class="font-bold text-xs uppercase text-slate-200">Xuất Chuyển Kho (Out-bound)</h3>
              </div>
              <div class="space-y-2.5 text-xs">
                <div>
                  <label class="block text-slate-400 mb-1">Kho Xuất Hàng (Kho Nguồn):</label>
                  <select id="transfer-from-branch" onchange="updateTransferAvailableStock()"
                    class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
                </div>
                <div>
                  <label class="block text-slate-400 mb-1">Kho Đích Nhận Hàng:</label>
                  <select id="transfer-to-branch"
                    class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
                </div>
                <div>
                  <label class="block text-slate-400 mb-1">Mặt Hàng Cần Chuyển (SKU):</label>
                  <select id="transfer-sku-select" onchange="updateTransferAvailableStock()"
                    class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
                </div>
                <div
                  class="p-2.5 bg-slate-950 rounded border border-slate-800 text-[11px] text-slate-300 flex justify-between items-center">
                  <span>Tồn khả dụng kho nguồn:</span>
                  <span id="transfer-available-stock" class="font-mono font-bold text-emerald-400 text-xs">0</span>
                </div>
                <div>
                  <label class="block text-slate-400 mb-1">Số Lượng Chuyển:</label>
                  <input type="number" id="transfer-qty" min="1" value="5"
                    class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono">
                </div>
                <div>
                  <label class="block text-slate-400 mb-1">Ghi Chú Điều Chuyển:</label>
                  <input type="text" id="transfer-note" placeholder="Ví dụ: Điều chuyển bổ sung hàng bán cuối tuần..."
                    class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
                </div>
                <button onclick="submitDispatchTransfer()"
                  class="w-full py-2.5 mt-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-cyan-900/30 transition">
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>1. XUẤT CHUYỂN KHO (OUT-BOUND)</span>
                </button>
              </div>
            </div>

            <!-- Right: Danh Sách Phiếu Chuyển Kho -->
            <div
              class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl flex flex-col">
              <div class="p-3 bg-slate-800/60 border-b border-slate-700/80 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                  <i data-lucide="git-pull-request" class="w-4 h-4 text-indigo-400"></i>
                  <span>Danh Sách Lệnh Điều Chuyển Kho (dbo.StockTransfers)</span>
                </span>
                <span class="text-[10px] text-cyan-400 font-mono">Quy trình 2 bước Out-bound ➜ In-bound</span>
              </div>
              <div class="flex-1 overflow-auto">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr
                      class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px]">
                      <th class="p-2.5">Mã Phiếu</th>
                      <th class="p-2.5">Từ Kho</th>
                      <th class="p-2.5">Đến Kho</th>
                      <th class="p-2.5">SKU / Sản phẩm</th>
                      <th class="p-2.5 text-right">SL</th>
                      <th class="p-2.5 text-center">Trạng Thái</th>
                      <th class="p-2.5 text-center">Xác Nhận (In-bound)</th>
                    </tr>
                  </thead>
                  <tbody id="transfers-table-body"
                    class="divide-y divide-slate-800 text-slate-300 font-mono text-[11px]">
                    <!-- Rendered via JS -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ------------------ 4. TAB: PURCHASE RECEIPTS & WAC CALCULATOR ------------------ -->
      <div id="tab-purchase" class="tab-content h-full hidden flex flex-col md:flex-row bg-slate-950">
        <!-- Left: Create Receipt Form -->
        <div class="w-full md:w-[480px] border-r border-slate-800 p-4 overflow-y-auto space-y-4 bg-slate-900">
          <div class="flex items-center space-x-2 pb-2 border-b border-slate-800">
            <i data-lucide="package-plus" class="w-5 h-5 text-indigo-400"></i>
            <div>
              <h2 class="font-bold text-sm">Lập Phiếu Nhập Kho (Purchase Receipt)</h2>
              <p class="text-[11px] text-slate-400">Kích hoạt Trigger tính Giá vốn bình quân gia quyền</p>
            </div>
          </div>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block text-slate-400 font-medium mb-1">Nhà cung cấp:</label>
              <input type="text" id="pr-supplier" value="Công ty May Sài Gòn"
                class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
            </div>
            <div>
              <label class="block text-slate-400 font-medium mb-1">Chi nhánh nhập:</label>
              <select id="pr-branch"
                class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
                <!-- Rendered via JS -->
              </select>
            </div>

            <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 space-y-2">
              <label class="block text-slate-300 font-bold">Thêm mặt hàng nhập kho:</label>
              <div>
                <label class="block text-slate-400 text-[11px] mb-0.5">Chọn SKU:</label>
                <select id="pr-sku" onchange="updatePrPreview()"
                  class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
                  <!-- Rendered via JS -->
                </select>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-slate-400 text-[11px] mb-0.5">Số lượng nhập:</label>
                  <input type="number" id="pr-qty" value="20" min="1" oninput="updatePrPreview()"
                    class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
                </div>
                <div>
                  <label class="block text-slate-400 text-[11px] mb-0.5">Đơn giá nhập (đ):</label>
                  <input type="number" id="pr-price" value="90000" min="0" step="1000" oninput="updatePrPreview()"
                    class="w-full px-3 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200">
                </div>
              </div>
            </div>

            <!-- Formula Preview Box -->
            <div class="p-3 bg-indigo-950/40 border border-indigo-800/50 rounded-lg space-y-1.5 text-[11px]">
              <div class="font-bold text-indigo-300 flex items-center space-x-1">
                <i data-lucide="calculator" class="w-3.5 h-3.5"></i>
                <span>Mô phỏng Trigger trg_PurchaseReceiptItems_WeightedAvgCost:</span>
              </div>
              <div class="text-slate-300 font-mono space-y-0.5">
                <div>Tồn cũ toàn tenant: <span id="wac-old-stock" class="text-amber-400 font-bold">0</span> cái @ <span
                    id="wac-old-cost" class="text-amber-400 font-bold">0 đ</span></div>
                <div>Nhập thêm: <span id="wac-imp-stock" class="text-cyan-400 font-bold">0</span> cái @ <span
                    id="wac-imp-cost" class="text-cyan-400 font-bold">0 đ</span></div>
                <div class="pt-1 border-t border-indigo-800/40 font-bold text-emerald-400">
                  Giá vốn mới dự kiến: <span id="wac-new-cost">0 đ</span>
                </div>
              </div>
            </div>

            <button onclick="submitPurchaseReceipt()"
              class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-900/30">
              <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              <span>Xác Nhận Nhập Kho (usp_ConfirmPurchaseReceipt)</span>
            </button>
          </div>
        </div>

        <!-- Right: Receipts History -->
        <div class="flex-1 p-4 overflow-y-auto space-y-4">
          <h3 class="font-bold text-sm text-slate-200">Lịch sử Phiếu Nhập Kho đã xác nhận</h3>
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr
                  class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px] tracking-wider">
                  <th class="p-3">Mã Phiếu</th>
                  <th class="p-3">Thời Gian</th>
                  <th class="p-3">Nhà Cung Cấp</th>
                  <th class="p-3">Chi Nhánh</th>
                  <th class="p-3">Chi Tiết Nhập</th>
                  <th class="p-3 text-right">Tổng Tiền Nhập</th>
                </tr>
              </thead>
              <tbody id="receipts-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ------------------ 5. TAB: WEBHOOK & FLASH SALE SIMULATOR ------------------ -->
      <div id="tab-webhook" class="tab-content h-full hidden flex flex-col md:flex-row bg-slate-950">
        <!-- Left: Webhook JSON Dispatcher -->
        <div class="w-full md:w-[460px] border-r border-slate-800 p-4 overflow-y-auto space-y-4 bg-slate-900">
          <div class="flex items-center space-x-2 pb-2 border-b border-slate-800">
            <i data-lucide="satellite-dish" class="w-5 h-5 text-indigo-400"></i>
            <div>
              <h2 class="font-bold text-sm">Bộ Giả Lập Webhook Sàn TMĐT</h2>
              <p class="text-[11px] text-slate-400">Mô phỏng Shopee, TikTok Shop, Lazada (OPENJSON)</p>
            </div>
          </div>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block text-slate-400 font-medium mb-1">Kênh gửi:</label>
              <div class="grid grid-cols-3 gap-2">
                <button onclick="setWebhookChannel('Shopee')" id="btn-wh-shopee"
                  class="py-1.5 rounded border border-indigo-500 bg-indigo-600/30 text-indigo-300 font-bold">Shopee</button>
                <button onclick="setWebhookChannel('TikTok')" id="btn-wh-tiktok"
                  class="py-1.5 rounded border border-slate-700 bg-slate-800 text-slate-400 font-bold">TikTok</button>
                <button onclick="setWebhookChannel('Lazada')" id="btn-wh-lazada"
                  class="py-1.5 rounded border border-slate-700 bg-slate-800 text-slate-400 font-bold">Lazada</button>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="text-slate-400 font-medium">JSON Payload gửi tới CSDL:</label>
                <button onclick="generateRandomWebhookPayload()"
                  class="text-[10px] text-indigo-400 hover:underline">Sinh mã đơn mới</button>
              </div>
              <textarea id="webhook-payload-text" rows="7"
                class="w-full p-2.5 bg-slate-950 font-mono text-[11px] text-emerald-400 rounded border border-slate-800 focus:outline-none focus:border-indigo-500"></textarea>
            </div>

            <button onclick="sendSingleWebhook()"
              class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-900/30">
              <i data-lucide="send" class="w-4 h-4"></i>
              <span>Gửi Webhook (usp_IngestWebhook)</span>
            </button>
          </div>

          <!-- STRESS TEST / FLASH SALE SECTION -->
          <div class="p-3 bg-rose-950/30 border border-rose-800/60 rounded-xl space-y-2 text-xs">
            <div class="flex items-center space-x-1.5 text-rose-400 font-bold">
              <i data-lucide="flame" class="w-4 h-4"></i>
              <span>KỊCH BẢN FLASH SALE (CONCURRENCY TEST)</span>
            </div>
            <p class="text-slate-300 text-[11px]">
              SKU <code class="text-rose-300 font-bold">FLASH-001</code> chỉ còn <strong>1 sản phẩm</strong> khả dụng.
              Bấm nút dưới đây để giả lập <strong>50 yêu cầu đồng thời</strong> tranh mua cùng 1 thời điểm!
            </p>
            <button onclick="runFlashSaleConcurrencyTest()" id="btn-flash-test"
              class="w-full py-2 bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-extrabold rounded-lg shadow-lg shadow-rose-900/40 flex items-center justify-center space-x-1.5">
              <i data-lucide="zap" class="w-4 h-4"></i>
              <span>BẮT ĐẦU 50 CONCURRENT REQUESTS</span>
            </button>
          </div>
        </div>

        <!-- Right: Webhook Logs & Concurrency Board -->
        <div class="flex-1 p-4 overflow-y-auto space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-200">Nhật Ký Sự Kiện Webhook (Bảng dbo.WebhookEvents)</h3>
            <span class="text-xs text-slate-400">Kiểm tra trùng lặp qua <code
                class="text-indigo-300 font-mono">UX_Webhook_External</code></span>
          </div>

          <!-- Concurrency Results Display (Flash Sale) -->
          <div id="flash-sale-results-box" class="hidden p-4 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-emerald-400">Kết quả Stress Test:</span>
              <span id="flash-sale-summary-text" class="text-slate-300 font-mono"></span>
            </div>
            <div id="flash-sale-badges-container"
              class="grid grid-cols-10 gap-1 max-h-40 overflow-y-auto p-1 bg-slate-950 rounded">
              <!-- Badges 1..50 rendered here -->
            </div>
          </div>

          <!-- Webhook Table -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr
                  class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px] tracking-wider">
                  <th class="p-3">Event ID</th>
                  <th class="p-3">Thời Điểm</th>
                  <th class="p-3">Kênh</th>
                  <th class="p-3">Mã Đơn Sàn</th>
                  <th class="p-3">Trạng Thái</th>
                  <th class="p-3">Order ID Tạo Ra</th>
                  <th class="p-3">Ghi Chú / Lỗi CSDL</th>
                </tr>
              </thead>
              <tbody id="webhook-events-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ------------------ 6. TAB: REPORTS & COLUMNSTORE ANALYTICS ------------------ -->
      <div id="tab-reports" class="tab-content h-full hidden flex flex-col p-4 overflow-y-auto space-y-4 bg-slate-950">
        <!-- KPI Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-lg flex items-center space-x-3">
            <div class="w-12 h-12 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              <i data-lucide="circle-dollar-sign" class="w-6 h-6"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Doanh Thu Thuần</div>
              <div id="kpi-net-revenue" class="text-xl font-extrabold text-slate-100 font-mono">0 đ</div>
            </div>
          </div>

          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-lg flex items-center space-x-3">
            <div class="w-12 h-12 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center">
              <i data-lucide="receipt" class="w-6 h-6"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Tổng Giá Vốn (COGS)</div>
              <div id="kpi-total-cogs" class="text-xl font-extrabold text-slate-200 font-mono">0 đ</div>
            </div>
          </div>

          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-lg flex items-center space-x-3">
            <div class="w-12 h-12 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center">
              <i data-lucide="trending-up" class="w-6 h-6"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Lợi Nhuận Gộp (Gross Profit)
              </div>
              <div id="kpi-gross-profit" class="text-xl font-extrabold text-indigo-400 font-mono">0 đ</div>
            </div>
          </div>

          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-lg flex items-center space-x-3">
            <div class="w-12 h-12 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center">
              <i data-lucide="alert-triangle" class="w-6 h-6"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Cảnh Báo Tồn Thấp</div>
              <div id="kpi-low-stock-count" class="text-xl font-extrabold text-rose-400 font-mono">0 SKU</div>
            </div>
          </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-xl flex flex-col">
            <div class="flex justify-between items-center mb-3">
              <h4 class="font-bold text-xs uppercase text-slate-300">Doanh Thu & Lợi Nhuận Theo Kênh Bán</h4>
              <span class="text-[10px] text-slate-500 font-mono">NCCI_OrderItems_Analytics</span>
            </div>
            <div class="flex-1 relative min-h-[260px]">
              <canvas id="channelRevenueChart"></canvas>
            </div>
          </div>

          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-xl flex flex-col">
            <div class="flex justify-between items-center mb-3">
              <h4 class="font-bold text-xs uppercase text-slate-300">Top SKU Đạt Doanh Số Cao Nhất</h4>
              <span class="text-[10px] text-slate-500 font-mono">Covering Index Scan</span>
            </div>
            <div class="flex-1 relative min-h-[260px]">
              <canvas id="topSkuChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Temporal Table Price History Demo -->
        <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-xl space-y-3">
          <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
              <i data-lucide="history" class="w-4 h-4 text-cyan-400"></i>
              <h4 class="font-bold text-xs uppercase text-slate-200">Lịch Sử Biến Động Giá Niêm Yết (System-Versioned
                Temporal Table: dbo.ListedPrices)</h4>
            </div>
            <span class="text-[10px] text-cyan-400 font-mono">FOR SYSTEM_TIME ALL</span>
          </div>
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px]">
                <th class="p-2.5">Mã SKU</th>
                <th class="p-2.5">Giá Bán Lẻ (Retail)</th>
                <th class="p-2.5">Giá Bán Buôn (Wholesale)</th>
                <th class="p-2.5">Hiệu Lực Từ (SysStart)</th>
                <th class="p-2.5">Hiệu Lực Đến (SysEnd)</th>
              </tr>
            </thead>
            <tbody id="price-history-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>

        <!-- FR-REP-02: BÁO CÁO HÀNG CHẬM LUÂN CHUYỂN (SLOW-MOVING INVENTORY) -->
        <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl shadow-xl space-y-3">
          <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
              <i data-lucide="clock-alert" class="w-4 h-4 text-amber-400"></i>
              <h4 class="font-bold text-xs uppercase text-slate-200">Báo Cáo Hàng Bán Chậm & Tồn Đọng Vốn (Slow-Moving
                Items - FR-REP-02)</h4>
            </div>
            <span class="text-[10px] text-amber-400 font-mono">Cảnh báo tồn kho > 30 ngày không phát sinh đơn</span>
          </div>
          <p class="text-[11px] text-slate-400">Danh sách các SKU có tồn thực tế (OnHand > 0) nhưng không có giao dịch
            xuất bán trong thời gian dài, giúp chủ shop có kế hoạch xả hàng kịp thời.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr
                  class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px]">
                  <th class="p-2.5">Mã SKU</th>
                  <th class="p-2.5">Tên Sản Phẩm</th>
                  <th class="p-2.5">Biến Thể</th>
                  <th class="p-2.5 text-right">Tồn Thực</th>
                  <th class="p-2.5 text-right">Giá Vốn</th>
                  <th class="p-2.5 text-right text-rose-400">Vốn Tồn Đọng</th>
                  <th class="p-2.5 text-center">Đánh Giá Rủi Ro</th>
                </tr>
              </thead>
              <tbody id="slow-moving-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ------------------ 7. TAB: HÀNG HÓA, BARCODE & GIÁ (FR-PROD-01..04) ------------------ -->
      <div id="tab-products" class="tab-content h-full hidden flex flex-col p-4 overflow-y-auto space-y-4 bg-slate-950">
        <div class="p-3 bg-slate-900 border border-slate-800 rounded-xl flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/20 text-indigo-400 flex items-center justify-center font-bold">
              <i data-lucide="tags" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="font-bold text-sm text-slate-100">Quản Lý Sản Phẩm, Biến Thể SKU, Barcode & Giá Niêm Yết</h2>
              <p class="text-[11px] text-slate-400">Master Data • Sinh mã vạch chuẩn EAN-13 • Cập nhật giá Temporal</p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="openNewProductModal()"
              class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold flex items-center space-x-1.5 shadow-md shadow-indigo-900/30 transition">
              <i data-lucide="plus" class="w-4 h-4"></i>
              <span>Thêm Sản Phẩm Mới (FR-PROD-02)</span>
            </button>
          </div>
        </div>

        <!-- Grid 2 Cột: Bảng Sản Phẩm/SKU và Quản lý Danh mục & Thương hiệu -->
        <!-- Bộ lọc chi nhánh theo Tỉnh / Thành phố -->
        <div
          class="p-2.5 bg-[#EAE7DD] rounded-xl border border-[#D6D0C0] flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="flex items-center space-x-2">
            <i data-lucide="filter" class="w-4 h-4 text-[#C5A059]"></i>
            <span class="font-bold text-[#1A1A1A]">Khoanh vùng lọc chi nhánh:</span>
            <select id="branch-table-province-filter" onchange="filterBranchTableByProvince()"
              class="px-2.5 py-1 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-semibold text-xs">
              <option value="all">Tất cả Tỉnh / Thành phố (Toàn quốc)</option>
            </select>
          </div>
          <div class="text-[11px] text-[#544E40]">
            Hiển thị: <strong id="branch-filtered-count" class="text-[#A47F35]">11</strong> chi nhánh
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <!-- Cột Trái 2/3: Danh sách Sản phẩm & Biến thể SKU -->
          <div
            class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl flex flex-col">
            <div class="p-3 bg-slate-800/60 border-b border-slate-700/80 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="layers" class="w-4 h-4 text-indigo-400"></i>
                <span>Danh Sách Sản Phẩm & SKU Biến Thể (dbo.Products & dbo.SKUs)</span>
              </span>
              <input type="text" id="filter-master-products" onkeyup="renderMasterProductsTable()"
                placeholder="Tìm tên, SKU, barcode..."
                class="px-2.5 py-1 bg-slate-900 rounded border border-slate-700 text-xs text-slate-200">
            </div>
            <div class="overflow-x-auto flex-1">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr
                    class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px]">
                    <th class="p-2.5">Mã SKU</th>
                    <th class="p-2.5">Sản Phẩm & Biến Thể</th>
                    <th class="p-2.5">Mã Vạch</th>
                    <th class="p-2.5 text-right">Giá Vốn</th>
                    <th class="p-2.5 text-right">Giá Lẻ / Sỉ</th>
                    <th class="p-2.5 text-center">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="master-products-table-body"
                  class="divide-y divide-slate-800 text-slate-300 font-mono text-[11px]">
                  <!-- Rendered via JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Cột Phải 1/3: Quản lý Danh mục (FR-PROD-01) & Thương hiệu (FR-PROD-01) -->
          <div class="space-y-4">
            <!-- Card Danh Mục -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                  <i data-lucide="folder-tree" class="w-4 h-4 text-emerald-400"></i>
                  <span>Danh Mục Hàng Hóa (FR-PROD-01)</span>
                </span>
              </div>
              <div class="flex space-x-1.5">
                <input type="text" id="new-category-name" placeholder="Tên danh mục mới..."
                  class="flex-1 px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-xs text-slate-200">
                <button onclick="submitNewCategory()"
                  class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-xs font-bold">Thêm</button>
              </div>
              <div id="categories-chip-list" class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto">
                <!-- Rendered via JS -->
              </div>
            </div>

            <!-- Card Thương Hiệu -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                  <i data-lucide="bookmark" class="w-4 h-4 text-indigo-400"></i>
                  <span>Thương Hiệu (FR-PROD-01)</span>
                </span>
              </div>
              <div class="flex space-x-1.5">
                <input type="text" id="new-brand-name" placeholder="Tên thương hiệu..."
                  class="flex-1 px-2.5 py-1.5 bg-slate-800 rounded border border-slate-700 text-xs text-slate-200">
                <button onclick="submitNewBrand()"
                  class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs font-bold">Thêm</button>
              </div>
              <div id="brands-chip-list" class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto">
                <!-- Rendered via JS -->
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ------------------ 8. TAB: CHI NHÁNH & KHO HÀNG (FR-AUTH-04) ------------------ -->
      <div id="tab-branches" class="tab-content h-full hidden flex flex-col p-4 overflow-y-auto space-y-4 bg-slate-950">
        <div class="p-3 bg-slate-900 border border-slate-800 rounded-xl flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/20 text-indigo-400 flex items-center justify-center font-bold">
              <i data-lucide="building-2" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="font-bold text-sm text-slate-100">Quản Lý Chi Nhánh & Kho Lưu Trữ (FR-AUTH-04)</h2>
              <p class="text-[11px] text-slate-400">Bảng dbo.Branches • Đồng bộ lọc dữ liệu đa chi nhánh</p>
            </div>
          </div>
        </div>

        <!-- Bộ lọc chi nhánh theo Tỉnh / Thành phố -->
        <div
          class="p-2.5 bg-[#EAE7DD] rounded-xl border border-[#D6D0C0] flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="flex items-center space-x-2">
            <i data-lucide="filter" class="w-4 h-4 text-[#C5A059]"></i>
            <span class="font-bold text-[#1A1A1A]">Khoanh vùng lọc chi nhánh:</span>
            <select id="branch-table-province-filter" onchange="filterBranchTableByProvince()"
              class="px-2.5 py-1 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-semibold text-xs">
              <option value="all">Tất cả Tỉnh / Thành phố (Toàn quốc)</option>
            </select>
          </div>
          <div class="text-[11px] text-[#544E40]">
            Hiển thị: <strong id="branch-filtered-count" class="text-[#A47F35]">11</strong> chi nhánh
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <!-- Form thêm chi nhánh mới -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl space-y-3">
            <div class="flex items-center space-x-2 pb-2 border-b border-slate-800">
              <i data-lucide="plus-circle" class="w-4 h-4 text-emerald-400"></i>
              <h3 class="font-bold text-xs uppercase text-slate-200">Thêm Chi Nhánh / Kho Mới</h3>
            </div>
            <div class="space-y-3 text-xs">
              <div>
                <label class="block text-slate-400 mb-1">Tên Chi Nhánh / Kho <span
                    class="text-rose-400">*</span>:</label>
                <input type="text" id="new-branch-name" placeholder="Ví dụ: Kho Tổng Tân Bình..."
                  class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
              </div>
              <!-- Phân Cấp Hành Chính Việt Nam: Tỉnh ➔ Quận/Huyện ➔ Phường/Xã -->
              <div class="space-y-2 pt-1 border-t border-[#D6D0C0]/60">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-[11px] text-[#1A1A1A] flex items-center space-x-1">
                    <i data-lucide="navigation" class="w-3.5 h-3.5 text-[#C5A059]"></i>
                    <span>Lọc Địa Giới Hành Chính & Khoanh Vùng:</span>
                  </span>
                  <span class="text-[10px] text-[#7D7563]">Chuẩn hóa 3 cấp</span>
                </div>

                <!-- Hàng 1: Tỉnh / Thành Phố & Quận / Huyện -->
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <div>
                    <label class="block text-[11px] text-[#544E40] mb-0.5 font-semibold">Tỉnh / Thành phố <span
                        class="text-rose-500">*</span>:</label>
                    <select id="branch-select-province" onchange="onProvinceChanged()"
                      class="w-full px-2.5 py-1.5 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-medium text-xs focus:border-[#C5A059]">
                      <!-- Dynamically populated -->
                    </select>
                  </div>
                  <div>
                    <label class="block text-[11px] text-[#544E40] mb-0.5 font-semibold">Quận / Huyện / Thị xã <span
                        class="text-rose-500">*</span>:</label>
                    <select id="branch-select-district" onchange="onDistrictChanged()"
                      class="w-full px-2.5 py-1.5 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-medium text-xs focus:border-[#C5A059]">
                      <!-- Dynamically populated -->
                    </select>
                  </div>
                </div>

                <!-- Hàng 2: Phường / Xã & Số nhà, tên đường -->
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <div>
                    <label class="block text-[11px] text-[#544E40] mb-0.5 font-semibold">Phường / Xã / Thị trấn <span
                        class="text-rose-500">*</span>:</label>
                    <select id="branch-select-ward" onchange="onWardChanged()"
                      class="w-full px-2.5 py-1.5 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-medium text-xs focus:border-[#C5A059]">
                      <!-- Dynamically populated -->
                    </select>
                  </div>
                  <div>
                    <label class="block text-[11px] text-[#544E40] mb-0.5 font-semibold">Số nhà, tên đường chi
                      tiết:</label>
                    <input type="text" id="branch-input-street" oninput="onStreetInputChanged()"
                      placeholder="Ví dụ: 12 Lê Lợi..."
                      class="w-full px-2.5 py-1.5 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-medium text-xs">
                  </div>
                </div>

                <!-- Hàng 3: Bán kính khoanh vùng phục vụ & giao hàng (Service Boundary Radius) -->
                <div class="p-2.5 bg-[#FAF5E8] rounded-xl border border-[#E5D3AD] space-y-1.5">
                  <div class="flex items-center justify-between">
                    <label class="block text-[11px] text-[#8C7037] font-bold flex items-center space-x-1">
                      <i data-lucide="radio" class="w-3.5 h-3.5 text-[#C5A059]"></i>
                      <span>Khoanh Vùng Bán Kính Phục Vụ (Service Area):</span>
                    </label>
                    <span id="branch-radius-summary" class="text-[10px] text-[#8C7037] font-bold">5 km (~78.5
                      km²)</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <select id="branch-service-radius" onchange="updateBranchServiceRadiusCircle()"
                      class="flex-1 px-2.5 py-1.5 bg-white rounded border border-[#D6D0C0] text-[#1A1A1A] font-semibold text-xs">
                      <option value="2">2 km (Nội phường / Siêu tốc 20 phút)</option>
                      <option value="5" selected>5 km (Nội quận - Tiêu chuẩn khoanh vùng)</option>
                      <option value="10">10 km (Liên quận / Bán kính mở rộng)</option>
                      <option value="15">15 km (Toàn thành phố / Đô thị lớn)</option>
                      <option value="30">30 km (Vùng phụ cận & Đô thị vệ tinh)</option>
                      <option value="50">50 km (Toàn tỉnh / Vận tải liên huyện)</option>
                    </select>
                    <button type="button" onclick="verifyBranchAddressGps()"
                      class="px-3 py-1.5 bg-[#C5A059] hover:bg-[#B38E47] text-white rounded font-bold text-xs flex items-center space-x-1 shadow transition shrink-0"
                      title="Phóng to bản đồ toàn màn hình">
                      <i data-lucide="maximize-2" class="w-3 h-3"></i>
                      <span>Xem Lớn</span>
                    </button>
                  </div>
                </div>

                <!-- Địa chỉ tự động tổng hợp đầy đủ -->
                <div>
                  <label class="block text-[11px] text-[#544E40] mb-0.5 font-semibold">Địa chỉ đầy đủ (Tự động tổng
                    hợp):</label>
                  <div class="flex space-x-1.5">
                    <input type="text" id="new-branch-address" placeholder="Địa chỉ sẽ tự động tổng hợp..."
                      class="flex-1 px-3 py-1.5 bg-[#EAE7DD] rounded border border-[#D6D0C0] text-[#1A1A1A] font-medium text-xs">
                  </div>
                </div>

                <!-- GPS Verification Status Badge -->
                <div id="new-branch-gps-badge"
                  class="flex items-center space-x-1.5 text-[11px] text-emerald-800 bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-1 rounded-lg font-bold">
                  <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                  <span>✓ Đã khoanh vùng GPS tự động theo địa giới hành chính</span>
                </div>
                <input type="hidden" id="new-branch-lat" value="10.7769">
                <input type="hidden" id="new-branch-lng" value="106.7009">

                <!-- BẢN ĐỒ GHIM TRỰC TIẾP TRONG FORM (INLINE INTERACTIVE PINNING MAP) -->
                <div class="mt-2 space-y-1">
                  <div class="relative rounded-xl overflow-hidden border border-[#D6D0C0] shadow-inner bg-[#E6ECF0]">
                    <div id="branch-inline-map" class="w-full h-[190px] z-10"></div>
                    <div
                      class="absolute bottom-1.5 left-1.5 z-20 px-2 py-0.5 rounded bg-white/95 border border-[#D6D0C0] text-[10px] text-[#544E40] shadow pointer-events-none flex items-center space-x-1">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                      <span>⭕ Vòng tròn vàng: Khoanh vùng phục vụ • Kéo ghim để di chuyển vùng</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <input type="checkbox" id="new-branch-visible" checked
                  class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
                <label for="new-branch-visible" class="text-slate-300 font-semibold cursor-pointer">Hiển thị chi nhánh
                  (IsVisible)</label>
              </div>
              <button onclick="submitNewBranch()"
                class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-emerald-900/30 transition">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>LƯU CHI NHÁNH MỚI</span>
              </button>
            </div>
          </div>

          <!-- Bảng danh sách chi nhánh -->
          <div
            class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl flex flex-col">
            <div class="p-3 bg-slate-800/60 border-b border-slate-700/80 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="map-pin" class="w-4 h-4 text-indigo-400"></i>
                <span>Danh Sách Chi Nhánh Của Cửa Hàng (dbo.Branches)</span>
              </span>
            </div>
            <div class="overflow-x-auto flex-1">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr
                    class="bg-slate-800/80 text-slate-400 border-b border-slate-700 uppercase font-semibold text-[10px]">
                    <th class="p-3">ID</th>
                    <th class="p-3">Tên Chi Nhánh</th>
                    <th class="p-3">Địa Chỉ</th>
                    <th class="p-3 text-center">Trạng Thái (IsVisible)</th>
                    <th class="p-3 text-center">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="branches-table-body" class="divide-y divide-slate-800 text-slate-300 font-mono">
                  <!-- Rendered via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
  </div>
  <div id="tab-map" class="tab-content h-full hidden flex flex-col lg:flex-row overflow-hidden bg-slate-950">

    <!-- Left Panel: Controls, Warehouse Locations & Live Delivery Tracking -->
    <div
      class="w-full lg:w-96 border-r border-slate-800 bg-slate-900/90 flex flex-col shrink-0 overflow-y-auto p-4 space-y-4">
      <div>
        <div class="flex items-center space-x-2 text-[#A47F35] font-extrabold text-sm uppercase tracking-wide">
          <i data-lucide="map" class="w-4 h-4"></i>
          <span>Mạng Lưới GPS & Kho Bãi Toàn Quốc</span>
        </div>
        <p class="text-[11px] text-[#544E40] mt-1">Định vị 11 Hub/Kho trên cả nước (Bắc - Trung - Nam). Tính khoảng cách
          Spatial STDistance & Lộ trình Xuyên Việt.</p>
      </div>

      <!-- Thanh Tìm Kiếm & Định Vị Địa Chỉ Toàn Quốc -->
      <div class="p-3 bg-[#EAE7DD] rounded-xl border border-[#D6D0C0] space-y-2">
        <label class="block font-bold text-[11px] text-[#1A1A1A]">Tìm & Định Vị Bất Kỳ Địa Chỉ Nào Tại Việt Nam:</label>
        <div class="flex space-x-1.5">
          <input type="text" id="map-search-address-input"
            placeholder="Ví dụ: Hồ Gươm Hà Nội, Cầu Rồng Đà Nẵng, Bến Thành..."
            class="flex-1 px-2.5 py-1.5 text-xs bg-white rounded border border-[#D6D0C0] text-[#1A1A1A]">
          <button onclick="searchAndConfirmMapAddress()"
            class="px-3 py-1.5 bg-[#C5A059] hover:bg-[#B38E47] text-white rounded font-bold text-xs flex items-center space-x-1 shadow transition shrink-0">
            <i data-lucide="search" class="w-3.5 h-3.5"></i>
            <span>Định Vị</span>
          </button>
        </div>
        <!-- Quick Region Shortcut Pills -->
        <div class="flex flex-wrap gap-1 text-[10px]">
          <button onclick="flyToRegion('all')"
            class="px-2 py-0.5 rounded bg-white hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] font-semibold transition">🌐
            Toàn Quốc</button>
          <button onclick="flyToRegion('north')"
            class="px-2 py-0.5 rounded bg-white hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] font-semibold transition">🏛️
            Miền Bắc</button>
          <button onclick="flyToRegion('central')"
            class="px-2 py-0.5 rounded bg-white hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] font-semibold transition">🌉
            Miền Trung</button>
          <button onclick="flyToRegion('highlands')"
            class="px-2 py-0.5 rounded bg-white hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] font-semibold transition">🌲
            Tây Nguyên</button>
          <button onclick="flyToRegion('south')"
            class="px-2 py-0.5 rounded bg-white hover:bg-[#C5A059] hover:text-white border border-[#D6D0C0] font-semibold transition">🏙️
            Miền Nam</button>
        </div>
      </div>

      <!-- Mode Switcher: Warehouse Locator vs Live Delivery Tracking -->
      <div class="grid grid-cols-2 gap-1 p-1 bg-slate-950 rounded-xl border border-slate-800 text-xs font-bold">
        <button onclick="switchMapMode('warehouses')" id="btn-map-mode-warehouses"
          class="py-2 rounded-lg bg-emerald-600 text-white flex items-center justify-center space-x-1 transition">
          <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
          <span>Mạng Lưới Kho</span>
        </button>
        <button onclick="switchMapMode('delivery')" id="btn-map-mode-delivery"
          class="py-2 rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition">
          <i data-lucide="navigation" class="w-3.5 h-3.5"></i>
          <span>Theo Dõi Đơn Giao</span>
        </button>
      </div>

      <!-- MODE 1: MẠNG LƯỚI KHO & KHOẢNG CÁCH -->
      <div id="panel-map-warehouses" class="space-y-3 text-xs">
        <div class="flex justify-between items-center">
          <span class="text-slate-400 font-semibold uppercase text-[10px] tracking-wider">Danh Sách Chi Nhánh:</span>
          <button onclick="getUserCurrentGps()"
            class="text-[10px] text-cyan-400 hover:underline flex items-center space-x-1">
            <i data-lucide="locate-fixed" class="w-3 h-3"></i>
            <span>Vị Trí Của Tôi (GPS)</span>
          </button>
        </div>
        <div class="space-y-2" id="map-branches-list">
          <!-- Dynamic Branches -->
        </div>

        <!-- Khoảng cách giữa các kho (SQL Server Spatial STDistance) -->
        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2">
          <div class="flex items-center space-x-1.5 text-slate-300 font-bold text-[11px]">
            <i data-lucide="ruler" class="w-3.5 h-3.5 text-indigo-400"></i>
            <span>Khoảng Cách Giữa 2 Kho (STDistance):</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <select id="calc-from-branch" onchange="calculateWarehouseDistance()"
              class="w-full px-2 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
            <select id="calc-to-branch" onchange="calculateWarehouseDistance()"
              class="w-full px-2 py-1.5 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
          </div>
          <div class="p-2 bg-white rounded font-mono text-xs space-y-1 border border-[#D6D0C0]">
            <div class="flex justify-between items-center">
              <span class="text-[#7D7563]">Đường chim bay (STDistance):</span>
              <span id="calculated-distance" class="text-[#A47F35] font-bold">12.5 km</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-[#7D7563]">Đường bộ ước tính (QL1A/Cao tốc):</span>
              <span id="calculated-road-distance" class="text-indigo-600 font-bold">15.0 km</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-[#7D7563]">Thời gian vận chuyển dự kiến:</span>
              <span id="calculated-transit-time" class="text-emerald-700 font-bold">45 phút</span>
            </div>
          </div>

          <!-- Nút Hành Trình Xuyên Việt -->
          <button onclick="startNationwideTour()"
            class="w-full py-2 bg-gradient-to-r from-[#C5A059] to-[#D5B26E] hover:from-[#B38E47] hover:to-[#C5A059] text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow transition">
            <i data-lucide="compass" class="w-4 h-4"></i>
            <span>🚀 Hành Trình Xuyên Việt (Bắc ➔ Nam Toàn Quốc)</span>
          </button>
        </div>
      </div>

      <!-- MODE 2: THEO DÕI ĐƠN HÀNG ĐANG GIAO (REAL-TIME DELIVERY TRACKING) -->
      <div id="panel-map-delivery" class="space-y-3 text-xs hidden">
        <div>
          <label class="block text-slate-400 mb-1">Chọn đơn hàng giao vận:</label>
          <select id="map-active-order-select" onchange="selectOrderForTracking()"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200 font-mono"></select>
        </div>

        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2.5" id="delivery-tracking-card">
          <div class="flex justify-between items-start">
            <div>
              <span class="px-1.5 py-0.5 rounded text-[10px] bg-indigo-500/20 text-indigo-300 font-bold"
                id="track-channel">Shopee</span>
              <div class="font-bold text-sm text-slate-100 font-mono mt-1" id="track-order-no">ORD-2611-000001</div>
            </div>
            <span
              class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 font-bold animate-pulse"
              id="track-status">Đang Vận Chuyển</span>
          </div>

          <div class="space-y-1.5 text-[11px] border-t border-slate-800/80 pt-2">
            <div class="flex items-center space-x-2 text-slate-300">
              <i data-lucide="store" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
              <span class="truncate"><strong class="text-slate-400">Kho xuất:</strong> <span id="track-origin">Kho Thủ
                  Đức</span></span>
            </div>
            <div class="flex items-center space-x-2 text-slate-300">
              <i data-lucide="user-check" class="w-3.5 h-3.5 text-cyan-400 shrink-0"></i>
              <span class="truncate"><strong class="text-slate-400">Khách nhận:</strong> <span id="track-dest">45 Lê
                  Duẩn, Q.1</span></span>
            </div>
            <div class="flex items-center space-x-2 text-slate-300">
              <i data-lucide="bike" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i>
              <span class="truncate"><strong class="text-slate-400">Tài xế:</strong> <span id="track-driver">Nguyễn Tuấn
                  (SPX-9988)</span></span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2 text-center pt-1 font-mono text-xs">
            <div class="bg-slate-900 p-2 rounded border border-slate-800">
              <div class="text-[10px] text-slate-400">Khoảng cách còn:</div>
              <div class="font-bold text-cyan-400" id="track-remaining-dist">3.8 km</div>
            </div>
            <div class="bg-slate-900 p-2 rounded border border-slate-800">
              <div class="text-[10px] text-slate-400">Ước tính giao (ETA):</div>
              <div class="font-bold text-emerald-400" id="track-eta">12 phút</div>
            </div>
          </div>

          <button onclick="simulateDriverMovement()"
            class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 active:scale-98 text-white rounded-lg font-bold text-xs flex items-center justify-center space-x-1.5 shadow transition">
            <i data-lucide="play" class="w-3.5 h-3.5"></i>
            <span>Mô Phỏng Chạy Thử Shipper Di Chuyển</span>
          </button>
        </div>
      </div>

      <!-- SQL Server Spatial Knowledge Box -->
      <div
        class="p-3 bg-emerald-950/20 border border-emerald-800/40 rounded-xl text-[10px] text-emerald-300/90 space-y-1">
        <div class="font-bold flex items-center space-x-1 text-emerald-300">
          <i data-lucide="database" class="w-3.5 h-3.5"></i>
          <span>SQL Server 2022 Spatial Geography:</span>
        </div>
        <p>Tọa độ GPS được lưu trữ dưới dạng <code>geography::Point(Lat, Long, 4326)</code>. Cho phép thực hiện câu lệnh
          <code>STDistance()</code> tính khoảng cách chính xác theo bề mặt cong trái đất.</p>
      </div>
    </div>

    <!-- Right: Interactive Leaflet Map Container -->
    <div class="flex-1 relative bg-slate-950 min-h-[450px]">
      <div id="oism-leaflet-map" class="w-full h-full z-10"></div>

      <!-- Map Overlay Badges -->
      <div class="absolute top-4 right-4 z-20 flex items-center space-x-2">
        <button onclick="recenterMap()"
          class="px-3 py-1.5 bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs font-bold shadow-lg flex items-center space-x-1.5 backdrop-blur transition">
          <i data-lucide="crosshair" class="w-3.5 h-3.5 text-cyan-400"></i>
          <span>Căn Giữa Bản Đồ</span>
        </button>
        <div
          class="px-3 py-1.5 bg-slate-900/90 text-slate-300 border border-slate-700 rounded-lg text-xs font-mono shadow-lg backdrop-blur">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping mr-1.5"></span>
          <span>GPS Tracking Active</span>
        </div>
      </div>
    </div>
  </div>

  </main>

  <!-- ================= T-SQL INSPECTOR DRAWER ================= -->
  <aside id="sql-inspector-drawer"
    class="fixed right-0 top-[88px] bottom-0 w-full sm:w-[520px] bg-slate-900/98 backdrop-blur border-l border-slate-800 shadow-2xl z-40 transform translate-x-full transition-transform duration-300 flex flex-col">
    <div class="p-3 border-b border-slate-800 bg-slate-950 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <i data-lucide="terminal" class="w-4 h-4 text-indigo-400"></i>
        <span class="font-bold text-xs uppercase text-slate-200">T-SQL Execution Inspector (SSMS Engine)</span>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="clearSqlConsole()" class="text-[10px] text-slate-400 hover:text-slate-200">Xóa log</button>
        <button onclick="toggleSqlInspector()" class="p-1 text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
    <div id="sql-console-log" class="flex-1 p-3 overflow-y-auto space-y-3 font-mono text-[11px] text-slate-300">
      <div class="p-2.5 bg-slate-950 rounded border border-slate-800 text-slate-400">
        -- Sẵn sàng bắt các câu lệnh T-SQL khi tương tác trên giao diện web.
      </div>
    </div>
  </aside>
  </div><!-- END #main-layout -->

  <!-- ================= PRINTABLE THERMAL RECEIPT MODAL ================= -->
  <div id="receipt-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white text-black w-80 rounded-lg p-5 font-mono text-xs shadow-2xl space-y-3" id="printable-receipt">
      <div class="text-center border-b pb-2">
        <h3 class="font-extrabold text-base uppercase" id="receipt-tenant-name">CỬA HÀNG MINH ANH</h3>
        <p class="text-[10px] text-gray-600" id="receipt-branch-name">Chi nhánh Quận 1</p>
        <p class="text-[10px] text-gray-500" id="receipt-date">2026-11-16 12:00:00</p>
      </div>

      <div class="space-y-1">
        <div class="flex justify-between font-bold">
          <span>HÓA ĐƠN BÁN HÀNG</span>
          <span id="receipt-order-no">POS-2611-000001</span>
        </div>
        <div class="text-[10px] text-gray-600 flex justify-between">
          <span>Hình thức thanh toán:</span>
          <span id="receipt-payment-method" class="font-bold">Tiền mặt</span>
        </div>
      </div>

      <div class="border-t border-b py-2 space-y-1" id="receipt-items-list">
        <!-- Rendered via JS -->
      </div>

      <div class="space-y-1 pt-1 font-bold">
        <div class="flex justify-between text-sm">
          <span>TỔNG CỘNG:</span>
          <span id="receipt-total-amount">0 đ</span>
        </div>
      </div>

      <div class="text-center pt-2 border-t text-[10px] text-gray-500">
        <p>Cảm ơn quý khách và hẹn gặp lại!</p>
        <p class="font-mono text-[9px] mt-1">OISM POS • SQL Server 2022 Atomic Txn</p>
      </div>

      <div class="flex space-x-2 pt-3 border-t print:hidden">
        <button onclick="window.print()"
          class="flex-1 py-1.5 bg-black text-white rounded font-bold hover:bg-gray-800">In Hóa Đơn</button>
        <button onclick="closeReceiptModal()"
          class="px-3 py-1.5 bg-gray-200 text-gray-800 rounded font-bold hover:bg-gray-300">Đóng</button>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: CẢNH BÁO TỒN THẤP ================= -->
  <div id="low-stock-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-xl p-5 shadow-2xl space-y-4">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <div class="flex items-center space-x-2 text-rose-400 font-bold">
          <i data-lucide="alert-triangle" class="w-5 h-5"></i>
          <span>Cảnh Báo Tồn Kho Thấp (dbo.vw_StockAlerts)</span>
        </div>
        <button onclick="closeLowStockModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="max-h-72 overflow-y-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="bg-slate-800 text-slate-400 border-b border-slate-700">
              <th class="p-2">Mã SKU</th>
              <th class="p-2 text-right">Tồn Khả Dụng</th>
              <th class="p-2 text-right">Ngưỡng Tối Thiểu</th>
              <th class="p-2 text-center">Cảnh Báo</th>
            </tr>
          </thead>
          <tbody id="low-stock-modal-body" class="divide-y divide-slate-800 font-mono">
            <!-- Rendered via JS -->
          </tbody>
        </table>
      </div>
      <div class="flex justify-end pt-2">
        <button onclick="closeLowStockModal()"
          class="px-4 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded text-xs font-semibold">Đóng</button>
      </div>
    </div>
  </div>



  <!-- ================= MODAL: KIỂM KÊ KHO ================= -->
  <div id="stocktake-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-xl p-5 shadow-2xl space-y-4">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <div class="flex items-center space-x-2 text-indigo-400 font-bold">
          <i data-lucide="clipboard-check" class="w-5 h-5"></i>
          <span>Kiểm Kê Cân Kho (usp_StocktakeAdjust)</span>
        </div>
        <button onclick="closeStocktakeModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Chi nhánh kiểm:</label>
          <select id="stocktake-branch-select"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Mặt hàng kiểm kê (SKU):</label>
          <select id="stocktake-sku-select" onchange="updateStocktakeCurrentDisplay()"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200"></select>
        </div>
        <div class="p-2.5 bg-slate-950 rounded border border-slate-800 font-mono text-slate-300">
          <div>Tồn thực tế hiện tại (OnHand): <span id="stocktake-current-onhand"
              class="text-amber-400 font-bold">0</span></div>
          <div>Đang giữ chỗ (Reserved): <span id="stocktake-current-reserved" class="text-cyan-400 font-bold">0</span>
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Số lượng đếm thực tế:</label>
          <input type="number" id="stocktake-counted-qty" min="0" value="0"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-200">
        </div>
      </div>
      <div class="flex justify-end space-x-2 pt-2 border-t border-slate-800">
        <button onclick="closeStocktakeModal()"
          class="px-3 py-1.5 bg-slate-800 text-slate-300 rounded text-xs font-semibold">Hủy</button>
        <button onclick="submitStocktake()"
          class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs font-bold">Cập Nhật Điều
          Chỉnh</button>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: IN PHIẾU GIAO HÀNG / VẬN ĐƠN (FR-ORD-03) ================= -->
  <div id="shipping-slip-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div
      class="bg-slate-900 border border-slate-800 w-full max-w-2xl rounded-xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b border-slate-800 bg-slate-950">
        <div class="flex items-center space-x-2 text-cyan-400 font-bold text-sm">
          <i data-lucide="printer" class="w-5 h-5"></i>
          <span>Phiếu Giao Hàng & Vận Đơn (FR-ORD-03)</span>
