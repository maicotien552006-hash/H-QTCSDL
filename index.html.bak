      <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 text-xs space-y-1">
        <div class="text-slate-200 font-bold" id="price-modal-sku-title">-</div>
        <div class="text-slate-400 font-mono text-[11px]" id="price-modal-current-display">Giá hiện tại: -</div>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Giá Bán Lẻ Mới (Retail Price) <span
              class="text-rose-400">*</span>:</label>
          <input type="number" id="price-modal-retail" min="0" step="1000"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-100 font-mono font-bold">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Giá Bán Sỉ Mới (Wholesale Price):</label>
          <input type="number" id="price-modal-wholesale" min="0" step="1000"
            class="w-full px-3 py-2 bg-slate-800 rounded border border-slate-700 text-slate-100 font-mono font-bold">
        </div>
        <p class="text-[10px] text-slate-400 italic">Hệ thống áp dụng Temporal Table (SYSTEM_VERSIONING), lưu vết toàn
          bộ lịch sử biến động giá theo thời gian.</p>
      </div>
      <div class="flex justify-end space-x-2 pt-2 border-t border-slate-800">
        <button onclick="closePriceModal()"
          class="px-3 py-1.5 bg-slate-800 text-slate-300 rounded text-xs font-semibold">Hủy</button>
        <button onclick="submitUpdatePrice()"
          class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs font-bold">Cập Nhật
          Giá</button>
      </div>
    </div>
  </div>

