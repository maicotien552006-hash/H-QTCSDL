          <i data-lucide="check" class="w-4 h-4"></i>
          <span>Lưu Sản Phẩm & SKU</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: CẬP NHẬT GIÁ NIÊM YẾT (FR-PROD-04) ================= -->
  <div id="update-price-modal"
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-xl shadow-2xl p-5 space-y-4">
